disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=labels)
disp.plot(cmap=plt.cm.Blues, values_format='d') # d formatira številke kot cela števila
plt.title('Matrika zmede (Testni podatki)')
plt.show()

# Dodatne metrike iz matrike zmede (neobvezno)
tn, fp, fn, tp = cm.ravel()

print(f"\nResnični negativni (True Negatives - TN): {tn}") # Pravilno napovedani ne-diabetiki
print(f"Lažni pozitivni (False Positives - FP): {fp}") # Napačno napovedani diabetiki (v resnici ne-diabetiki)
print(f"Lažni negativni (False Negatives - FN): {fn}") # Napačno napovedani ne-diabetiki (v resnici diabetiki)
print(f"Resnični pozitivni (True Positives - TP): {tp}") # Pravilno napovedani diabetiki

# Izračun in izpis nekaterih klasičnih metrik
# Precision (Precision = TP / (TP + FP)): Koliko od pozitivnih napovedi je bilo pravilnih.
precision = tp / (tp + fp) if (tp + fp) > 0 else 0
print(f"Preciznost (Precision): {precision:.4f}")

# Recall (Recall = TP / (TP + FN)): Koliko od dejanskih pozitivnih je bilo pravilno identificiranih.
recall = tp / (tp + fn) if (tp + fn) > 0 else 0
print(f"Priziv (Recall / Sensitivity): {recall:.4f}")

# F1-Score (Harmonic mean of Precision and Recall)
f1_score = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0
print(f"F1-Score: {f1_score:.4f}")











