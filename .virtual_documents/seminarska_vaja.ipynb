# === Diagnostika BMI (Y) vs. binarne X (0/1) - kompaktna vrstica grafov ===
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
BINS = 50
MAX_QQ_POINTS = 20000   # vzorčenje za QQ (na skupino) zaradi hitrosti
RANDOM_STATE = 42

# --- 1) Preberi podatke ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"

# --- 2) Najdi binarne neodvisne (⊆{0,1}) ---
def is_binary_series(s: pd.Series):
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    return set(vals).issubset({0, 1})

binary_cols = [c for c in df.columns if c != Y_COL and is_binary_series(df[c])]
print(f"Najdene binarne X ({len(binary_cols)}): {binary_cols}")

# --- 3) Pomožne funkcije ---
def iqr_outlier_share(x: np.ndarray):
    """Delež točk izven 1.5*IQR (klasični boxplot whiskers)."""
    x = x[~np.isnan(x)]
    if x.size == 0:
        return np.nan
    q1, q3 = np.percentile(x, [25, 75])
    iqr = q3 - q1
    lo = q1 - 1.5 * iqr
    hi = q3 + 1.5 * iqr
    return np.mean((x < lo) | (x > hi))

def sample_for_qq(x: np.ndarray, max_n=MAX_QQ_POINTS, random_state=RANDOM_STATE):
    x = x[~np.isnan(x)]
    if x.size <= max_n:
        return x
    rng = np.random.default_rng(random_state)
    idx = rng.choice(x.size, size=max_n, replace=False)
    return x[idx]

def brief_stats(arr):
    arr = arr[~np.isnan(arr)]
    if arr.size == 0:
        return dict(outlier_share=np.nan)
    return dict(outlier_share=iqr_outlier_share(arr))

def normality_comment_single(out_share):
    """
    Približen sklep o (ne)normalnosti iz deleža outlierjev po IQR pravilu.
    Pri normalni ~0.7%. Pragovi (praktično):
      <=1.2% ≈ približno normalno
      <=3%   ≈ rahla odstopanja
      >3%    ≈ verjetno ne-normalno (težji repi/asimetrija)
    """
    if pd.isna(out_share):
        return "normalnost: ni podatkov"
    if out_share <= 0.012:
        return "normalnost: približno normalno (po IQR pravilu)"
    elif out_share <= 0.03:
        return "normalnost: rahla odstopanja"
    else:
        return "normalnost: verjetno ne-normalno (težji repi/asimetrija)"

def levene_comment(p):
    return f"Levene p={p:.3e} → variance: " + ("enake" if p >= 0.05 else "neenake")

#dodan KS test
def ks_normal_test(x: np.ndarray):
    """
    K–S proti N(mu_hat, sigma_hat). (aproksimacija, ker parametre
    ocenimo iz podatkov)
    """
    x = x[~np.isnan(x)]
    if x.size < 2:
        return np.nan, np.nan
    mu, sigma = np.mean(x), np.std(x, ddof=1)
    if sigma <= 0 or not np.isfinite(sigma):
        return np.nan, np.nan
    d, p = stats.kstest(x, "norm", args=(mu, sigma))
    return d, p


def ks_comment(p):
    if not np.isfinite(p):
        return "ni podatkov"
    return "zavrnemo normalnost" if p < 0.05 else "≈ normalno"

# --- 4) Diagnostika: za vsako binarno X nariši eno vrstico 4 grafov + zgoščeni izpis ---
for x_col in binary_cols:
    mask0 = df[x_col] == 0
    mask1 = df[x_col] == 1
    y0 = df.loc[mask0, Y_COL].to_numpy(dtype=float)
    y1 = df.loc[mask1, Y_COL].to_numpy(dtype=float)

    s0 = brief_stats(y0)
    s1 = brief_stats(y1)

    # Klasični Levene (center='mean'), kot v zapiskih
    lev_stat, lev_p = stats.levene(y0, y1, center='mean')

    # KS za normalnost (aproksimacija, ker μ̂, σ̂ iz podatkov)
    ks0_D, ks0_p = ks_normal_test(y0)
    ks1_D, ks1_p = ks_normal_test(y1)
    ks_method = "KS (approx, μ̂, σ̂)"

    # ZGOŠČENI IZPIS
    # print(f"\n=== {x_col} (0/1) → BMI ===")
    # out0_pct = s0['outlier_share'] * 100 if pd.notna(s0['outlier_share']) else np.nan
    # out1_pct = s1['outlier_share'] * 100 if pd.notna(s1['outlier_share']) else np.nan
    # print(f"Skupina=0: outlier_share={out0_pct:.2f}% → {normality_comment_single(s0['outlier_share'])}")
    # print(f"Skupina=1: outlier_share={out1_pct:.2f}% → {normality_comment_single(s1['outlier_share'])}")
    # print(levene_comment(lev_p))
    
    print(f"\n=== {x_col} (0/1) → {Y_COL} ===")
    out0_pct = (
        s0["outlier_share"] * 100 if pd.notna(s0["outlier_share"]) else np.nan
    )
    out1_pct = (
        s1["outlier_share"] * 100 if pd.notna(s1["outlier_share"]) else np.nan
    )
    print(
        f"Skupina=0: outlier_share={out0_pct:.2f}% → "
        f"{normality_comment_single(s0['outlier_share'])}"
    )
    print(
        f"Skupina=1: outlier_share={out1_pct:.2f}% → "
        f"{normality_comment_single(s1['outlier_share'])}"
    )
    print(levene_comment(lev_p))
    # KS izpis (za obe skupini)
    print(
        f"{ks_method} skupina=0: D={ks0_D:.3f}, p={ks0_p:.3e} → "
        f"{ks_comment(ks0_p)}"
    )
    print(
        f"{ks_method} skupina=1: D={ks1_D:.3f}, p={ks1_p:.3e} → "
        f"{ks_comment(ks1_p)}"
    )

    # FIG: ena vrstica z 4 grafi (kompaktno, vizualizacija ostane enaka)
    fig, axes = plt.subplots(1, 4, figsize=(14, 3.2))  # manjši, široka vrstica

    # 1) Histogram (prekrivno)
    axes[0].hist(y0, bins=BINS, alpha=0.6, density=True, label='0')
    axes[0].hist(y1, bins=BINS, alpha=0.6, density=True, label='1')
    axes[0].set_title("Hist (0 vs 1)", fontsize=10)
    axes[0].set_xlabel("BMI", fontsize=9)
    axes[0].set_ylabel("Gostota", fontsize=9)
    axes[0].legend(fontsize=8)

    # 2) Boxplot (outlierji)
    axes[1].boxplot([y0, y1], labels=['0', '1'], showfliers=True, widths=0.6)
    axes[1].set_title("Boxplot", fontsize=10)
    axes[1].set_xlabel(x_col, fontsize=9) 
    axes[1].set_ylabel("BMI", fontsize=9)

    # 3) QQ (skupina 0)
    y0_qq = sample_for_qq(y0)
    stats.probplot(y0_qq, dist="norm", plot=axes[2])
    axes[2].set_title("QQ (0)", fontsize=10)

    # 4) QQ (skupina 1)
    y1_qq = sample_for_qq(y1)
    stats.probplot(y1_qq, dist="norm", plot=axes[3])
    axes[3].set_title("QQ (1)", fontsize=10)

    fig.suptitle(f"{x_col} vs BMI", fontsize=11)
    fig.tight_layout(rect=[0, 0, 1, 0.92])
    plt.show()


print("\n✅ Končano: diagnostika (kompaktni ploti) + zgoščeni izpis + KS (approx).")














import numpy as np
import pandas as pd
from scipy import stats

# ==== Nastavitve ====
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
ALPHA = 0.05
expended_report = False  # <-- stikalo: False = skrajšana tabela, True = razširjena

df = pd.read_csv(CSV_PATH)

# zaznaj binarne X (vrednosti ⊆ {0,1})
def is_binary_series(s: pd.Series):
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    return set(vals).issubset({0, 1})

binary_cols = [c for c in df.columns if c != Y_COL and is_binary_series(df[c])]
print(f"Najdene binarne X ({len(binary_cols)}): {binary_cols}")

# efektna mera za Mann–Whitney (rank-biserial correlation)
def rank_biserial(u_stat, n0, n1):
    return 1 - (2*u_stat) / (n0*n1)

def rbc_magnitude(rbc):
    if not np.isfinite(rbc):
        return "neznano"
    a = abs(rbc)
    if a < 0.1: return "zelo majhen"
    if a < 0.3: return "majhen"
    if a < 0.5: return "srednji"
    return "velik"

rows = []

for x_col in binary_cols:
    y0 = df.loc[df[x_col]==0, Y_COL].astype(float).dropna().to_numpy()
    y1 = df.loc[df[x_col]==1, Y_COL].astype(float).dropna().to_numpy()
    n0, n1 = y0.size, y1.size
    # mean0, mean1 = np.mean(y0), np.mean(y1)
    # diff = mean1 - mean0  # (1 - 0)
    median0, median1 = np.median(y0), np.median(y1)
    diff = median1 - median0  # (1 - 0)

    # 1) Mann–Whitney U test
    # u_stat, p_val = stats.mannwhitneyu(y0, y1, alternative="two-sided")
    u_stat, p_val = stats.mannwhitneyu(
        y0, y1, alternative="two-sided", method="auto"
    )
    test_name = "Mann–Whitney U"

    # 2) efektna mera: rank-biserial correlation
    rbc = rank_biserial(u_stat, n0, n1)
    rbc_mag = rbc_magnitude(rbc)

    # sklep in smer
    signif = p_val < ALPHA
    result_str = "statistično značilna razlika" if signif else "ni statistično značilne razlike"
    smer_str = "BMI je višji pri X=1" if diff > 0 else "BMI je nižji pri X=1"

    rows.append({
        "spremenljivka": x_col,
        "izbran_test": test_name,
        "U_stat": u_stat,
        "p_value": p_val,
        # "mean_0": mean0,
        # "mean_1": mean1,
        "median_0": median0,
        "median_1": median1,
        "diff_(1-0)": diff,
        "rank_biserial": rbc,
        "rbc_magnitude": rbc_mag,
        "Sklep": result_str,
        "Smer": smer_str
    })

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

# če je expended_report=False, skrij "razširjene" stolpce
if not expended_report:
    keep_cols = [
        "spremenljivka", "izbran_test",
        "U_stat", "p_value", "Sklep", "Smer"
    ]
    results = results[keep_cols]

# nastavitve Pandasa za poln izpis (brez '...')
pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

results















# === Diagnostika BMI (Y) vs. ordinalne / večskupinske X (≥3 kategorij) + QQ ploti ===
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
BINS = 50
RANDOM_STATE = 42
MAX_OVERLAY_GROUPS = 6   # max št. kategorij v prekrivnem histogramu (za berljivost)
MAX_QQ_POINTS = 2000     # vzorčenje za QQ (da ni preveč točk)

# --- 1) Preberi podatke ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"

# --- 2) Izbor ordinalnih/kategoričnih X (≥3 kategorij) ---
preferred = [c for c in ["GenHlth", "Age", "Education", "Income"] if c in df.columns]

def is_multicat(s: pd.Series, min_k=3, max_k=12):
    if s.name == Y_COL: 
        return False
    vals = pd.unique(s.dropna())
    k = vals.size
    return (k >= min_k) and (k <= max_k)

if preferred:
    multicat_cols = preferred
else:
    multicat_cols = [c for c in df.columns if is_multicat(df[c])]

print(f"Najdene večskupinske/ordinalne X ({len(multicat_cols)}): {multicat_cols}")

# --- 3) Pomožne ---
def iqr_outlier_share(x: np.ndarray):
    x = x[~np.isnan(x)]
    if x.size == 0:
        return np.nan
    q1, q3 = np.percentile(x, [25, 75])
    iqr = q3 - q1
    lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
    return np.mean((x < lo) | (x > hi))

def normality_comment_from_share(out_share):
    if pd.isna(out_share):
        return "ni podatkov"
    if out_share <= 0.012: return "≈ normalno"
    elif out_share <= 0.03: return "rahla odstopanja"
    else: return "verjetno nenormalno"

def summarize_group(arr):
    arr = np.asarray(arr, dtype=float)
    arr = arr[~np.isnan(arr)]
    if arr.size == 0:
        return dict(n=0, median=np.nan, out_share=np.nan)
    return dict(n=arr.size, median=float(np.median(arr)), out_share=float(iqr_outlier_share(arr)))

def sample_for_qq(x: np.ndarray, max_n=MAX_QQ_POINTS, random_state=RANDOM_STATE):
    x = x[~np.isnan(x)]
    if x.size <= max_n: return x
    rng = np.random.default_rng(random_state)
    return rng.choice(x, size=max_n, replace=False)

def top_k_categories_by_n(series, k=MAX_OVERLAY_GROUPS):
    order = series.value_counts(dropna=False).sort_values(ascending=False).index.tolist()
    return order[:k]

# --- 4) Diagnostika ---
for x_col in multicat_cols:
