import torch
import torch.nn as nn

class ResidualBlock(nn.Module):
    def __init__(self, d):
        super().__init__()
        self.block = nn.Sequential(
            nn.Linear(d, d),
            nn.BatchNorm1d(d),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
            nn.Linear(d, d),
            nn.BatchNorm1d(d),
        )
        self.activation = nn.LeakyReLU()

    def forward(self, x):
        # add skip connection
        return self.activation(self.block(x) + x)


class RegressorNet(nn.Module):
    def __init__(self, input_size):
        super().__init__()
        self.model = nn.Sequential(
            # initial expansion
            nn.Linear(input_size, 512),
            nn.BatchNorm1d(512),
            nn.LeakyReLU(),
            nn.Dropout(0.5),

            # squeeze down, then residualize
            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.LeakyReLU(),
            nn.Dropout(0.4),

            ResidualBlock(256),
            nn.Dropout(0.4),

            # another residual stage
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.3),

            ResidualBlock(128),
            nn.Dropout(0.3),

            # final “head”
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.2),

            nn.Linear(64, 1)
        )

    def forward(self, x):
        return self.model(x)



# Initialize model
input_dim = X_train.shape[1]
model = RegressorNet(input_size=input_dim)


# Move model to device
model = model.to(device)

# Define loss function and optimizer outside the training function
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=1e-3)


train_losses, train_r2s, test_r2s = train_model(
    model, train_loader, test_loader,
    scaler_y, criterion, optimizer,
    epochs=5
)



plot_metrics(train_losses, train_r2s, test_r2s)


# Evaluate
evaluate_model(model, test_loader, scaler_y)


