def show_ordinal_data(
    feature,
    figsize=(16, 10),
    font_scale=1.0,
    title_size=12,
    label_size=10,
    xtick_size=10,
    ytick_size=12,
    xtick_rotation=0,
    bar_text_size=11,
    table_title_size=15,
    table_font_size=9,
    row_heights=(1, 1),
    hbar_text_offset=0.055,  # koliko max(cnt) premakniti napis
    order=None,  # opcijsko: ročni vrstni red kategorij (ordinalni red)
):
    # pisave
    t_sz = title_size * font_scale
    l_sz = label_size * font_scale
    xt_sz = xtick_size * font_scale
    yt_sz = ytick_size * font_scale
    bt_sz = bar_text_size * font_scale
    tt_sz = table_title_size * font_scale
    tf_sz = table_font_size * font_scale

    # opisi skupin
    group_order = [0, 1, 2]
    legend_desc = {0: "ne diabetik", 1: "prediabetik", 2: "diabetik"}
    hor_labels = ["0\nne diabetik", "1\nprediabetik", "2\ndiabetik"]

    # priprava podatkov
    if order is not None:
        cats = list(order)
    else:
        cats = sorted(data[feature].dropna().unique())

    grp = data.groupby("Diabetes_012")[feature]
    counts = (
        grp.value_counts()
        .unstack(fill_value=0)
        .reindex(index=group_order, columns=cats, fill_value=0)
    )
    rel_counts = counts.div(counts.sum(axis=1), axis=0) * 100

    # palete (enotno za kategorije feature-a)
    pal_cats = sns.color_palette("Set2", n_colors=len(cats))
    cat_color = {c: pal_cats[i] for i, c in enumerate(cats)}
    legend_patches = [
        Patch(facecolor=cat_color[c], edgecolor="k", label=str(c)) for c in cats
    ]

    with sns.plotting_context("notebook", font_scale=font_scale):
        fig = plt.figure(figsize=figsize)
        outer_gs = GridSpec(
            2, 2, figure=fig, height_ratios=row_heights, hspace=0.4, wspace=0.3
        )

        # PRVA VRSTICA: 3x horizontalni bar chart (po skupinah 0/1/2)
        top_gs = GridSpecFromSubplotSpec(
            1, 3, subplot_spec=outer_gs[0, :], wspace=0.4
        )
        for idx, status in enumerate(group_order):
            ax = fig.add_subplot(top_gs[0, idx])
            sub = data[data["Diabetes_012"] == status]
            cnt = sub[feature].value_counts().reindex(cats, fill_value=0)
            colors = [cat_color[c] for c in cats]
            ax.barh(cats, cnt.values, color=colors, edgecolor="k")
            ax.set_title(
                f"{status} – {legend_desc[status]}", fontsize=t_sz * 0.9
            )
            if idx == 0:
                ax.set_ylabel(feature, fontsize=l_sz)
            else:
                ax.set_ylabel("")
            ax.set_xlabel("Število primerov", fontsize=l_sz)
            ax.tick_params(axis="x", labelsize=xt_sz, rotation=xtick_rotation)
            ax.tick_params(axis="y", labelsize=yt_sz)

            # napisi na koncu barov
            offset = (cnt.max() or 0) * hbar_text_offset
            for i, v in enumerate(cnt.values):
                ax.text(
                    v + offset,
                    cats[i],
                    str(int(v)),
                    va="center",
                    fontsize=xt_sz * 0.9,
                )

            # legenda kategorij (na vsakem subplotu)
            ax.legend(
                handles=legend_patches,
                title=feature,
                fontsize=xt_sz * 0.9,
                title_fontsize=xt_sz * 0.95,
                loc="best",
                frameon=True,
            )

        # DRUGA VRSTICA: zloženi horizont. stolpci (po skupinah), barvani po kategorijah
        ax_stack = fig.add_subplot(outer_gs[1, :])
        counts.plot(
            kind="barh",
            stacked=True,
            color=[cat_color[c] for c in cats],
            ax=ax_stack,
            legend=False,
            edgecolor="k",
        )
        ax_stack.set_title(
            f"Horiz. zloženi stolpci {feature} po Diabetes_012", fontsize=t_sz
        )
        ax_stack.set_xlabel("Št. primerov", fontsize=l_sz)
        ax_stack.set_ylabel("Status diabetesa", fontsize=l_sz)
        ax_stack.tick_params(axis="x", labelsize=xt_sz)
        ax_stack.tick_params(axis="y", labelsize=yt_sz)
        ax_stack.set_yticklabels(hor_labels, rotation=0)

        # legenda kategorij (spodaj)
        ax_stack.legend(
            handles=legend_patches,
            title=feature,
            loc="upper center",
            bbox_to_anchor=(0.5, -0.12),
            ncol=min(4, len(cats)),
            frameon=True,
            fontsize=xt_sz * 0.9,
            title_fontsize=xt_sz * 0.95,
        )

        plt.tight_layout()
        plt.show()

    # HTML tabele
    c_html = counts.to_html()
    r_html = rel_counts.round(2).to_html()
    html = f"""
    <div style="display:flex; gap:40px;">
      <div style="font-size:{tf_sz}pt;">
