def group_size_summary_multicat(df, x_col, y_col="BMI", order=None):
    x = df[x_col]
    y = df[y_col]
    mask = (~x.isna()) & (~y.isna())
    x_valid, y_valid = x[mask], y[mask]

    counts = x_valid.value_counts().sort_index()
    n_min, n_max = counts.min(), counts.max()
    ratio = n_max / n_min if n_min > 0 else np.inf

