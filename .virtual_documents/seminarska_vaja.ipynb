import numpy as np
import pandas as pd
from scipy import stats

# ==== Nastavitve ====
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
ALPHA = 0.05
expended_report = False  # <-- stikalo: False = skrajšana tabela, True = razširjena

df = pd.read_csv(CSV_PATH)

# zaznaj binarne X (vrednosti ⊆ {0,1})
def is_binary_series(s: pd.Series):
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    return set(vals).issubset({0, 1})

binary_cols = [c for c in df.columns if c != Y_COL and is_binary_series(df[c])]
print(f"Najdene binarne X ({len(binary_cols)}): {binary_cols}")

# efektna mera za Mann–Whitney (rank-biserial correlation)
def rank_biserial(u_stat, n0, n1):
    return 1 - (2*u_stat) / (n0*n1)

def rbc_magnitude(rbc):
    if not np.isfinite(rbc):
        return "neznano"
    a = abs(rbc)
    if a < 0.1: return "zelo majhen"
    if a < 0.3: return "majhen"
    if a < 0.5: return "srednji"
    return "velik"

rows = []

for x_col in binary_cols:
    y0 = df.loc[df[x_col]==0, Y_COL].astype(float).dropna().to_numpy()
    y1 = df.loc[df[x_col]==1, Y_COL].astype(float).dropna().to_numpy()
    n0, n1 = y0.size, y1.size
    mean0, mean1 = np.mean(y0), np.mean(y1)
    diff = mean1 - mean0  # (1 - 0)

    # 1) Mann–Whitney U test
    u_stat, p_val = stats.mannwhitneyu(y0, y1, alternative="two-sided")
    test_name = "Mann–Whitney U"

    # 2) efektna mera: rank-biserial correlation
    rbc = rank_biserial(u_stat, n0, n1)
    rbc_mag = rbc_magnitude(rbc)

    # sklep in smer
    signif = p_val < ALPHA
    result_str = "statistično značilna razlika" if signif else "ni statistično značilne razlike"
    smer_str = "BMI je višji pri X=1" if diff > 0 else "BMI je nižji pri X=1"

    rows.append({
        "spremenljivka": x_col,
        "izbran_test": test_name,
        "U_stat": u_stat,
        "p_value": p_val,
        "mean_0": mean0,
        "mean_1": mean1,
        "diff_(1-0)": diff,
        "rank_biserial": rbc,
        "rbc_magnitude": rbc_mag,
        "Sklep": result_str,
        "Smer": smer_str
    })

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

# če je expended_report=False, skrij "razširjene" stolpce
if not expended_report:
    keep_cols = [
        "spremenljivka", "izbran_test",
        "U_stat", "p_value", "Sklep", "Smer"
    ]
    results = results[keep_cols]

# nastavitve Pandasa za poln izpis (brez '...')
pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

results






import numpy as np
import pandas as pd
from scipy import stats

# ==== Nastavitve ====
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
ALPHA = 0.05
expanded_report = False  # False = skrajšano poročilo; True = razširjeno

df = pd.read_csv(CSV_PATH)

# --- Izbor ordinalnih / večskupinskih X (≥3 kategorij) ---
preferred = [c for c in ["GenHlth", "Age", "Education", "Income"] if c in df.columns]

def is_multicat(s: pd.Series, min_k=3, max_k=20):
    if s.name == Y_COL:
        return False
    vals = pd.unique(s.dropna())
    k = vals.size
    return (k >= min_k) and (k <= max_k)

if preferred:
    multicat_cols = preferred
else:
    multicat_cols = [c for c in df.columns if is_multicat(df[c])]

print(f"Najdene večskupinske/ordinalne X ({len(multicat_cols)}): {multicat_cols}")

# --- Pomožne funkcije ---
def kruskal_epsilon_squared(H, N, k):
    """Epsilon-squared efektna mera za Kruskal–Wallis: ε² = (H - k + 1) / (N - 1)."""
    if N <= 1:
        return np.nan
    return (H - k + 1) / (N - 1)

def eps_magnitude(eps):
    if not np.isfinite(eps):
        return "neznano"
    a = abs(eps)
    if a < 0.01: return "zelo majhen"
    if a < 0.06: return "majhen"
    if a < 0.14: return "srednji"
    return "velik"

rows = []
g_= []
for x_col in multicat_cols:
    x = df[x_col]
    y = df[Y_COL].astype(float)

    mask = (~x.isna()) & (~y.isna())
    x_valid, y_valid = x[mask], y[mask]

    # ➡️ Preprosto: unikatne vrednosti kategorij, sortirane
    levels = sorted(pd.unique(x_valid))

    # Zgradi skupine glede na kategorije
    groups = [y_valid[x_valid == lvl].to_numpy() for lvl in levels]
    tmp = [(lvl, g) for lvl, g in zip(levels, groups) if g.size > 0]
    if len(tmp) < 3:
        print(f"⚠️ {x_col}: manj kot 3 neprazne kategorije — preskočim.")
        continue
    levels, groups = zip(*tmp)
    levels, groups = list(levels), list(groups)

    # Kruskal–Wallis H test
    H_stat, p_val = stats.kruskal(*groups)
    N = sum(g.size for g in groups)
    k = len(groups)
    eps2 = kruskal_epsilon_squared(H_stat, N, k)
    dfree = k - 1  # stopinje prostosti
    g_ = groups
    # Mediane po skupinah
    medians = [float(np.median(g)) for g in groups]
    ns = [g.size for g in groups]
    order_idx = np.argsort(medians)
    lowest_cat = str(levels[int(order_idx[0])])
    highest_cat = str(levels[int(order_idx[-1])])

    signif = p_val < ALPHA
    sklep = "statistično značilne razlike med kategorijami" if signif else "ni statistično značilnih razlik"
    eps_mag = eps_magnitude(eps2)

    row = {
        "spremenljivka": x_col,
        "izbran_test": "Kruskal–Wallis H",
        "k": k,
        "df": dfree,
        "H_stat": H_stat,
        "p_value": p_val,
        "epsilon_sq": eps2,
        "eps_magnitude": eps_mag,
        "Sklep": sklep,
        "Najnižja_mediana_kat": lowest_cat,
        "Najvišja_mediana_kat": highest_cat
    }

    if expanded_report:
        for lvl, n, med in zip(levels, ns, medians):
            row[f"n[{lvl}]"] = n
            row[f"median_BMI[{lvl}]"] = med

    rows.append(row)

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

# Skrajšana ali razširjena tabela
if not expanded_report:
    keep = [
        "spremenljivka","izbran_test","k","df",
        "H_stat","p_value",
        "Sklep"
    ]
    results = results[keep]

pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

results






import numpy as np
import pandas as pd
from scipy import stats

# ==== Nastavitve ====
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
ALPHA = 0.05

df = pd.read_csv(CSV_PATH)

# --- Izberi numerične spremenljivke (razen Y_COL) ---
num_cols = ["PhysHlth", "MentHlth"]

rows = []

for x_col in num_cols:
    x = df[x_col].astype(float)
    y = df[Y_COL].astype(float)

    mask = (~x.isna()) & (~y.isna())
    x_valid, y_valid = x[mask], y[mask]

    if x_valid.nunique() < 2:
        continue  # preskoči konstante

    # Spearman korelacija
    rho, p_val = stats.spearmanr(x_valid, y_valid)

    signif = p_val < ALPHA
    sklep = "statistično značilna povezava" if signif else "ni statistično značilne povezave"

    # Smer povezave
    if signif:
        smer = "pozitivna" if rho > 0 else "negativna"
    else:
        smer = "-"

    row = {
        "spremenljivka": x_col,
        "izbran_test": "Spearman",
        "rho": rho,
        "p_value": p_val,
        "Sklep": sklep,
        "Smer": smer
    }
    rows.append(row)

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

results










