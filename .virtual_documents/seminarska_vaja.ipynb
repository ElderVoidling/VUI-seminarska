from sklearn.metrics import (
    confusion_matrix,
    ConfusionMatrixDisplay,
    roc_auc_score,
)
import numpy as np
import matplotlib.pyplot as plt

def show_confusion_and_metrics(y_true, y_pred, y_score=None, title="Matrika zmede (Testni podatki)"):
    y_true = np.asarray(y_true).astype(int)
    y_pred = np.asarray(y_pred).astype(int)

    print("\n--- Matrika zmede ---")
    cm = confusion_matrix(y_true, y_pred)
    labels = ["Non-diabetic", "Diabetic"]
    disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=labels)
    disp.plot(cmap=plt.cm.Blues, values_format="d")
    plt.title(title)
    plt.show()

    tn, fp, fn, tp = cm.ravel()
    print(f"\nResnični negativni (True Negatives - TN): {tn}")
    print(f"Lažni pozitivni (False Positives - FP): {fp}")
    print(f"Lažni negativni (False Negatives - FN): {fn}")
    print(f"Resnični pozitivni (True Positives - TP): {tp}")

    precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0
    recall    = tp / (tp + fn) if (tp + fn) > 0 else 0.0  # = Sensitivity/TPR
    f1_score  = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0.0

    print(f"\nPreciznost (Precision): {precision:.4f}")
    print(f"Priziv (Recall / Sensitivity): {recall:.4f}")
    print(f"F1-Score: {f1_score:.4f}")

    # Dodatne metrike
    if y_score is None:
        # fallback: AUC iz oznak (manj informativno kot iz verjetnosti)
        auc_roc = roc_auc_score(y_true, y_pred)
    else:
        y_score = np.asarray(y_score, dtype=float)
        auc_roc = roc_auc_score(y_true, y_score)

    specificity = tn / (tn + fp) if (tn + fp) > 0 else 0.0  # TNR

    print("\n--- Dodatne metrike (Test) ---")
    print(f"ROC AUC: {auc_roc:.4f}")
    print(f"Sensitivity (Recall/TPR): {recall:.4f}")
    print(f"Specificity (TNR): {specificity:.4f}")

y_true = [int(v) for batch in all_true_labels for v in batch]
y_pred = [int(v) for batch in all_predictions for v in batch]

# Če imaš verjetnosti:
