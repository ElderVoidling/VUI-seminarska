import torch
import torch.nn as nn

class ResidualBlock(nn.Module):
    def __init__(self, d):
        super().__init__()
        self.block = nn.Sequential(
            nn.Linear(d, d),
            nn.BatchNorm1d(d),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
            nn.Linear(d, d),
            nn.BatchNorm1d(d),
        )
        self.activation = nn.LeakyReLU()

    def forward(self, x):
        # add skip connection
        return self.activation(self.block(x) + x)


class RegressorNet(nn.Module):
    def __init__(self, input_size):
        super().__init__()
        self.model = nn.Sequential(
            # initial expansion
            nn.Linear(input_size, 512),
            nn.BatchNorm1d(512),
            nn.LeakyReLU(),
            nn.Dropout(0.5),

            # squeeze down, then residualize
            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.LeakyReLU(),
            nn.Dropout(0.4),

            ResidualBlock(256),
            nn.Dropout(0.4),

            # another residual stage
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.3),

            ResidualBlock(128),
            nn.Dropout(0.3),

            # final “head”
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.2),

            nn.Linear(64, 1)
        )

    def forward(self, x):
        return self.model(x)



model = RegressorNet(input_size=X_train.shape[1]).to(device)
criterion = nn.MSELoss()
