def predict_bmi_for_features(Xb, Xc):
    # standardize continuous with the SAME scaler used for training
    Xc_std = scaler_xc.transform(Xc)

    xb_t = torch.from_numpy(Xb.astype(np.float32)).to(device)
    xc_t = torch.from_numpy(Xc_std.astype(np.float32)).to(device)

    model.eval()
    with torch.no_grad():
        y_pred_std = model(xc_t, xb_t).cpu().numpy()  # shape (N,1)
    y_pred = scaler_y.inverse_transform(y_pred_std).ravel()
    return y_pred

def load_augmented_df(run_name):
    path = os.path.join(".", "Augmented Datasets",
                        f"BMI_adjusted_features_w_o_target_{run_name}.csv")
    df_loaded = pd.read_csv(path)
    arr = df_loaded.values

    Xb = arr[:, :n_bin]
    Xc = arr[:, n_bin:]

    y_pred = predict_bmi_for_features(Xb, Xc)

    out = pd.DataFrame(np.hstack([Xb, Xc]), columns=columns)
    out["BMI"] = y_pred
    return out


