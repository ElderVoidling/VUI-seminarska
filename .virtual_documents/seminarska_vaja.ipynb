from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay # Dodani uvozi

print("\n--- Matrika zmede ---")
# Pretvori sezname v numpy arraye za sklearn
y_true = [int(label) for label_list in all_true_labels for label in label_list] # Flatten and convert to int
y_pred = [int(pred) for pred_list in all_predictions for pred in pred_list] # Flatten and convert to int

