def simulate_optimization_steps(
    num_steps, 
    model: torch.nn.Module,
    sample_binary_values,
    sample_continuous_values,
    nudge_alpha: float,
    scaler_xc,
    scaler_y,
    binary_feature_names,
    continuous_feature_names,
    ordinal_feature_names,
    ordinal_bounds,
    device: torch.device = None,
    verbose: bool = True,
    print_raw_gradients: bool = False):
    for step in range(num_steps):
        print(f"\n--- Step {step + 1}/{num_steps} ---")
        new_sample_binary_values, new_sample_continuous_values = get_recommended_adjustment(
            model=model,
            sample_binary_values=sample_binary_values,
            sample_continuous_values=sample_continuous_values,
            nudge_alpha=nudge_alpha,
            scaler_xc=scaler_xc,
            scaler_y=scaler_y,
            binary_feature_names=binary_feature_names,
            continuous_feature_names=continuous_feature_names,
            ordinal_feature_names=ordinal_feature_names,
            ordinal_bounds=ordinal_bounds,
            device=device,
            verbose=verbose,
            print_raw_gradients=print_raw_gradients
        )
        sample_binary_values = new_sample_binary_values
        sample_continuous_values = new_sample_continuous_values
    


