import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from IPython.display import display, HTML

def show_nominal_data(
    feature,
    figsize=(13, 5),
    font_scale=1,
    title_size=15,
    label_size=15,
    xtick_size=12,
    ytick_size=12,
    xtick_rotation=0,
    bar_text_size=11,
    table_title_size=15,
    table_font_size=9,
    # labele counts
    counts_label_type="center",  # "center" ali "edge"
    counts_label_pad=2,  # osnovni odmik v točkah
    counts_label_offsets=None,  # per-label odmik (točke)
    # labele relativnih deležev
    rel_label_type="center",  # "center" ali "edge"
    rel_label_pad=2,  # odmik v točkah
    rel_decimals=2,  # št. decimalk za % labele
    rel_label_offsets=None,  # NOVO: per-label odmik (točke) za % graf
):
    """
    Prikaže 2 grafa in tabele za nominalno spremenljivko (npr. binarno 0/1).
    - Stacked bar (absolutne frekvence) + labele s številom
    - Stacked bar (relativni deleži v %) + labele v %

    counts_label_offsets / rel_label_offsets:
      - skalar -> enak odmik za vse segmente,
      - dict po kategoriji -> {cat: offset},
      - dict po (skupina, kategorija) -> {(grp, cat): offset},
      - 2D array ali DataFrame oblike (n_grps, n_cats) z index=[0,1,2]
        in columns=seznam kategorij feature-a.

    Odmiki so v točkah (points) in se seštevajo k *_label_pad.
    """

    # skaliranje
    title_sz = title_size * font_scale
    label_sz = label_size * font_scale
    xtick_sz = xtick_size * font_scale
    ytick_sz = ytick_size * font_scale
    bar_txt_sz = bar_text_size * font_scale
    tbl_title_sz = table_title_size * font_scale
    tbl_font_sz = table_font_size * font_scale

    group_order = [0, 1, 2]
    xticklabels = ["0\nne diabetik", "1\nprediabetik", "2\ndiabetik"]

    with sns.plotting_context("notebook", font_scale=font_scale):
        # tabele frekvenc
        counts = (
            data.groupby("Diabetes_012")[feature]
            .value_counts()
            .unstack(fill_value=0)
            .reindex(index=group_order)
        )
        # determinističen red kategorij (stolpcev)
        counts = counts.reindex(sorted(counts.columns), axis=1)
        rel_counts = counts.div(counts.sum(axis=1), axis=0) * 100

        cat_cols = list(counts.columns)
        palette = sns.color_palette("Set2", n_colors=len(cat_cols))

        fig, axes = plt.subplots(1, 2, figsize=figsize)

        # 1) Absolutne frekvence (stacked)
        counts.plot(
            kind="bar", stacked=True, color=palette, ax=axes[0], edgecolor="k"
        )
        axes[0].set_title(
            f"Absolutne frekvence {feature}", fontsize=title_sz
        )
        axes[0].set_xlabel("Status diabetesa", fontsize=label_sz)
        axes[0].set_ylabel("Število primerov", fontsize=label_sz)
        axes[0].set_xticks(range(len(group_order)))
        axes[0].set_xticklabels(xticklabels, rotation=xtick_rotation)
        axes[0].tick_params(axis="x", labelsize=xtick_sz)
        axes[0].tick_params(axis="y", labelsize=ytick_sz)
        axes[0].legend(title=feature)

        # helper: per-label offset (counts)
        def _get_counts_offset(i_grp, j_cat):
            grp_label = counts.index[i_grp]
            cat_label = cat_cols[j_cat]
            o = counts_label_offsets
            if o is None:
                return 0.0
            if isinstance(o, (int, float, np.floating)):
                return float(o)
            if isinstance(o, dict):
                if (grp_label, cat_label) in o:
                    return float(o[(grp_label, cat_label)])
                if cat_label in o:
                    return float(o[cat_label])
                if grp_label in o:
                    return float(o[grp_label])
                return 0.0
            if isinstance(o, pd.DataFrame):
                try:
                    return float(o.loc[grp_label, cat_label])
                except Exception:
                    return 0.0
            try:
                arr = np.asarray(o, dtype=float)
                if arr.shape == (len(group_order), len(cat_cols)):
                    return float(arr[i_grp, j_cat])
            except Exception:
                pass
            return 0.0

        # Labele counts: ročno z annotate (zaradi per-label offsetov)
        for j, cont in enumerate(axes[0].containers):
            for i, patch in enumerate(cont.patches):
                h = patch.get_height()
                if h <= 0:
                    continue
                x = patch.get_x() + patch.get_width() / 2.0
                y0 = patch.get_y()
                y_top = y0 + h
                if counts_label_type == "center":
                    y_anchor = y0 + h / 2.0
                    va = "center"
                else:
                    y_anchor = y_top
                    va = "bottom"
                dy_pts = counts_label_pad + _get_counts_offset(i, j)
                if counts_label_type == "edge" and dy_pts < 0:
                    va = "top"
                axes[0].annotate(
                    f"{int(h)}",
                    xy=(x, y_anchor),
                    xytext=(0, dy_pts),
                    textcoords="offset points",
                    ha="center",
                    va=va,
                    fontsize=bar_txt_sz,
                )

        # 2) Relativni deleži (stacked, %)
        rel_counts.plot(
            kind="bar", stacked=True, color=palette, ax=axes[1], edgecolor="k"
        )
        axes[1].set_title(
            f"Relativni deleži {feature} (%)", fontsize=title_sz
        )
        axes[1].set_xlabel("Status diabetesa", fontsize=label_sz)
        axes[1].set_ylabel("Delež (%)", fontsize=label_sz)
        axes[1].set_xticks(range(len(group_order)))
        axes[1].set_xticklabels(xticklabels, rotation=xtick_rotation)
        axes[1].tick_params(axis="x", labelsize=xtick_sz)
        axes[1].tick_params(axis="y", labelsize=ytick_sz)
        axes[1].set_ylim(0, 100)
        axes[1].legend(title=feature)

        fmt = "{:." + str(rel_decimals) + "f}%"

        # helper: per-label offset (relative)
        def _get_rel_offset(i_grp, j_cat):
            grp_label = rel_counts.index[i_grp]
            cat_label = cat_cols[j_cat]
            o = rel_label_offsets
            if o is None:
                return 0.0
            if isinstance(o, (int, float, np.floating)):
                return float(o)
            if isinstance(o, dict):
                if (grp_label, cat_label) in o:
                    return float(o[(grp_label, cat_label)])
                if cat_label in o:
                    return float(o[cat_label])
                if grp_label in o:
                    return float(o[grp_label])
                return 0.0
            if isinstance(o, pd.DataFrame):
                try:
                    return float(o.loc[grp_label, cat_label])
                except Exception:
                    return 0.0
            try:
                arr = np.asarray(o, dtype=float)
                if arr.shape == (len(group_order), len(cat_cols)):
                    return float(arr[i_grp, j_cat])
            except Exception:
                pass
            return 0.0

        # Labele %: če je rel_label_offsets podan -> annotate; sicer bar_label
        if rel_label_offsets is not None:
            for j, cont in enumerate(axes[1].containers):
                for i, patch in enumerate(cont.patches):
                    h = patch.get_height()
                    if h <= 0:
                        continue
                    x = patch.get_x() + patch.get_width() / 2.0
                    y0 = patch.get_y()
                    y_top = y0 + h
                    if rel_label_type == "center":
                        y_anchor = y0 + h / 2.0
                        va = "center"
                    else:
                        y_anchor = y_top
                        va = "bottom"
                    dy_pts = rel_label_pad + _get_rel_offset(i, j)
                    if rel_label_type == "edge" and dy_pts < 0:
                        va = "top"
                    axes[1].annotate(
                        fmt.format(h),
                        xy=(x, y_anchor),
                        xytext=(0, dy_pts),
                        textcoords="offset points",
                        ha="center",
                        va=va,
                        fontsize=bar_txt_sz,
                    )
        else:
            for cont in axes[1].containers:
                labels = [
                    fmt.format(p.get_height()) if p.get_height() > 0 else ""
                    for p in cont
                ]
                axes[1].bar_label(
                    cont,
                    labels=labels,
                    label_type=rel_label_type,
                    padding=rel_label_pad,
                    fontsize=bar_txt_sz,
                )

        plt.tight_layout()
        plt.show()

    # HTML tabele
    counts_html = counts.to_html()
    rel_html = rel_counts.round(2).to_html()
    html = f"""
    <div style="display: flex; gap:40px;">
      <div style="font-size:{tbl_font_sz}pt;">
        <h4 style="font-size:{tbl_title_sz}pt; margin-bottom:8px;">
          Absolutne frekvence za {feature}
        </h4>
        {counts_html}
      </div>
      <div style="font-size:{tbl_font_sz}pt;">
        <h4 style="font-size:{tbl_title_sz}pt; margin-bottom:8px;">
          Relativni deleži za {feature} (%)
        </h4>
        {rel_html}
      </div>
    </div>
    """
    display(HTML(html))





import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.gridspec import GridSpec, GridSpecFromSubplotSpec
from matplotlib.patches import Patch, Rectangle
from IPython.display import display, HTML

def show_ordinal_data(
    feature,
    figsize=(16, 12),
    font_scale=1.0,
    title_size=12,
    label_size=10,
    xtick_size=10,
    ytick_size=12,
    xtick_rotation=0,
    bar_text_size=11,
    table_title_size=15,
    table_font_size=9,
    row_heights=(1, 1, 1),  # (top, middle, bottom)
    hbar_text_offset=0.055,
    order=None,  # ročni ordinalni red (npr. [1,2,3,4,5])
    cat_labels=None,  # labels za legendo (po vrstnem redu cats/order)
    legend_col_frac=0.26,  # delež širine 1. vrstice za levo legendo
    top_wspace=0.35,  # razmik med 3 grafi v 1. vrstici
    # Sredinski “waffle” graf (celice)
    mid_cell_height=0.9,  # višina celice (v enotah y)
    mid_cell_pad=0.08,  # notranji odmik celice (ustvari reže med celicami)
    pct_text_threshold=0.0,  # ne izpisuj % pod tem pragom
    mid_show_grid=True,  # prikaži vertikalno mrežo na 0,10,20,...,100
):
    """
    - 1. vrstica: leva legenda + 3x horizontalni stolpci (absolutne frekvence).
    - 2. vrstica: EN waffle graf (celice) relativnih deležev (%) po vrsticah
                  Diabetes_012 (0,1,2), x-os 0..100 %.
    - 3. vrstica: zloženi horizontalni stolpci (absolutne frekvence) po skupinah.
    """

    # pisave
    t_sz = title_size * font_scale
    l_sz = label_size * font_scale
    xt_sz = xtick_size * font_scale
    yt_sz = ytick_size * font_scale
    bt_sz = bar_text_size * font_scale
    tt_sz = table_title_size * font_scale
    tf_sz = table_font_size * font_scale

    # opisi skupin
    group_order = [0, 1, 2]
    legend_desc = {0: "ne diabetik", 1: "prediabetik", 2: "diabetik"}
    hor_labels = ["0\nne diabetik", "1\nprediabetik", "2\ndiabetik"]

    # kategorije (cats) in labels za legendo
    if order is not None:
        cats = list(order)
    else:
        cats = sorted(data[feature].dropna().unique())

    if cat_labels is not None and len(cat_labels) != len(cats):
        raise ValueError(
            f"cat_labels mora imeti {len(cats)} elementov, prejel: "
            f"{len(cat_labels)}"
        )
    legend_labels = (
        list(cat_labels) if cat_labels is not None else [str(c) for c in cats]
    )

    # agregacije
    grp = data.groupby("Diabetes_012")[feature]
    counts = (
        grp.value_counts()
        .unstack(fill_value=0)
        .reindex(index=group_order, columns=cats, fill_value=0)
    )
    rel_counts = (
        counts.div(counts.sum(axis=1).replace(0, np.nan), axis=0) * 100
    ).fillna(0)

    # barvna paleta
    pal_cats = sns.color_palette("Set2", n_colors=len(cats))
    cat_color = {c: pal_cats[i] for i, c in enumerate(cats)}
    legend_patches = [
        Patch(facecolor=cat_color[c], edgecolor="k", label=legend_labels[i])
        for i, c in enumerate(cats)
    ]

    if not (isinstance(row_heights, (list, tuple)) and len(row_heights) == 3):
        raise ValueError("row_heights mora biti trojček (top, middle, bottom).")

    def _percentages_to_cells(perc_values, total_cells=100):
        """Najdi celoštevilsko delitev na celice, ki skupaj daje total_cells."""
        vals = np.asarray(perc_values, dtype=float)
        if np.allclose(vals.sum(), 0.0):
            return np.zeros_like(vals, dtype=int)
        raw = vals * total_cells / 100.0
        floors = np.floor(raw).astype(int)
        diff = total_cells - floors.sum()
        decimals = raw - floors
        order_idx = np.argsort(-decimals)  # najprej največji decimalni deli
        cells = floors.copy()
        if diff > 0:
            for k in range(diff):
                cells[order_idx[k % len(cells)]] += 1
        elif diff < 0:
            for k in range(-diff):
                # odvzemi tistim z najmanjšimi decimalnimi deli
                idx = order_idx[::-1][k % len(cells)]
                if cells[idx] > 0:
                    cells[idx] -= 1
        return cells

    with sns.plotting_context("notebook", font_scale=font_scale):
        fig = plt.figure(figsize=figsize)

        # 3 vrstice, 1 stolpec; legenda samo v 1. vrstici
        outer_gs = GridSpec(
            3, 1, figure=fig, height_ratios=row_heights, hspace=0.45
        )

        # 1) PRVA VRSTICA: legenda (levo) + 3x ABSOLUTNE frekvence (desno)
        leg_frac = float(np.clip(legend_col_frac, 0.05, 0.6))
        top_row_gs = GridSpecFromSubplotSpec(
            1,
            2,
            subplot_spec=outer_gs[0, 0],
            width_ratios=[leg_frac, 1 - leg_frac],
            wspace=0.25,
        )

        # legenda
        legend_ax = fig.add_subplot(top_row_gs[0, 0])
        legend_ax.axis("off")
        legend_ax.legend(
            handles=legend_patches,
            title=feature,
            loc="upper left",
            bbox_to_anchor=(0.0, 1.0),
            frameon=True,
            ncol=1,
            fontsize=xt_sz * 0.9,
            title_fontsize=xt_sz * 0.95,
        )

        # 3x ABSOLUTNE frekvence
        top_gs = GridSpecFromSubplotSpec(
            1, 3, subplot_spec=top_row_gs[0, 1], wspace=top_wspace
        )
        for idx, status in enumerate(group_order):
            ax = fig.add_subplot(top_gs[0, idx])
            sub = data[data["Diabetes_012"] == status]
            cnt = sub[feature].value_counts().reindex(cats, fill_value=0)
            colors = [cat_color[c] for c in cats]
            ax.barh(cats, cnt.values, color=colors, edgecolor="k")
            ax.set_title(
                f"{status} – {legend_desc[status]}", fontsize=t_sz * 0.9
            )
            if idx == 0:
                ax.set_ylabel(feature, fontsize=l_sz)
            else:
                ax.set_ylabel("")
                ax.set_yticklabels([])
            ax.set_xlabel("Število primerov", fontsize=l_sz)
            ax.tick_params(axis="x", labelsize=xt_sz, rotation=xtick_rotation)
            ax.tick_params(axis="y", labelsize=yt_sz)

            # napisi na koncu barov (absolutne)
            offset = (cnt.max() or 0) * hbar_text_offset
            for i, v in enumerate(cnt.values):
                ax.text(
                    v + offset,
                    cats[i],
                    str(int(v)),
                    va="center",
                    fontsize=xt_sz * 0.9,
                )

        # 2) SREDNJA VRSTICA: EN “WAFFLE” GRAF (celice) za relativne deleže
        ax_mid = fig.add_subplot(outer_gs[1, 0])
        ax_mid.set_title(
            f"Waffle deleži (%) {feature} po Diabetes_012", fontsize=t_sz
        )
        ax_mid.set_xlabel("Delež (%)", fontsize=l_sz)
        ax_mid.set_ylabel("Status diabetesa", fontsize=l_sz)
        ax_mid.set_xlim(0, 100)
        ax_mid.set_ylim(-0.5, len(group_order) - 0.5)
        ax_mid.set_yticks(range(len(group_order)))
        ax_mid.set_yticklabels(hor_labels, rotation=0)
        ax_mid.tick_params(axis="x", labelsize=xt_sz)
        ax_mid.tick_params(axis="y", labelsize=yt_sz)

        if mid_show_grid:
            ax_mid.set_xticks(np.arange(0, 101, 10))
            ax_mid.grid(
                axis="x", linestyle="--", alpha=0.3, zorder=0, linewidth=0.8
            )

        # riši celice
        for yi, status in enumerate(group_order):
            perc_series = rel_counts.loc[status, cats]
            if np.allclose(perc_series.values.sum(), 0.0):
                continue  # brez podatkov v tej skupini

            cells_per_cat = _percentages_to_cells(perc_series.values, 100)
            # start x
            x0 = 0
            # višina in padding
            h = float(np.clip(mid_cell_height, 0.1, 1.0))
            pad = float(np.clip(mid_cell_pad, 0.0, 0.4))
            w_eff = 1.0 - pad
            # besedilne oznake: središča segmentov
            for ci, c in enumerate(cats):
                n_cells = int(cells_per_cat[ci])
                if n_cells <= 0:
                    continue
                # celice za to kategorijo
                for k in range(n_cells):
                    # levo spodaj
                    left = x0 + k + pad / 2.0
                    bottom = yi - h / 2.0
                    rect = Rectangle(
                        (left, bottom),
                        w_eff,
                        h,
                        facecolor=cat_color[c],
                        edgecolor="white",
                        linewidth=0.3,
                        zorder=2,
                    )
                    ax_mid.add_patch(rect)

                # napis % na sredino segmenta (če preseže prag)
                seg_perc = float(perc_series.iloc[ci])
                if seg_perc >= pct_text_threshold and n_cells > 0:
                    x_text = x0 + n_cells / 2.0
                    r, g, b = cat_color[c]
                    luminance = 0.299 * r + 0.587 * g + 0.114 * b
                    txt_color = "black" if luminance > 0.6 else "white"
                    ax_mid.text(
                        x_text,
                        yi,
                        f"{seg_perc:.2f}%",
                        ha="center",
                        va="center",
                        fontsize=bt_sz,
                        color=txt_color,
                        zorder=3,
                    )

                x0 += n_cells  # premik na naslednji segment

        # 3) SPODNJA VRSTICA: zloženi horizont. stolpci (absolutne)
        ax_bot = fig.add_subplot(outer_gs[2, 0])
        counts.plot(
            kind="barh",
            stacked=True,
            color=[cat_color[c] for c in cats],
            ax=ax_bot,
            legend=False,
            edgecolor="k",
        )
        ax_bot.set_title(
            f"Horiz. zloženi stolpci {feature} po Diabetes_012", fontsize=t_sz
        )
        ax_bot.set_xlabel("Št. primerov", fontsize=l_sz)
        ax_bot.set_ylabel("Status diabetesa", fontsize=l_sz)
        ax_bot.tick_params(axis="x", labelsize=xt_sz)
        ax_bot.tick_params(axis="y", labelsize=yt_sz)
        ax_bot.set_yticklabels(hor_labels, rotation=0)

        plt.tight_layout()
        plt.show()

    # HTML tabele
    c_html = counts.to_html()
    r_html = rel_counts.round(2).to_html()
    html = f"""
    <div style="display:flex; gap:40px;">
      <div style="font-size:{tf_sz}pt;">
        <h4 style="font-size:{tt_sz}pt;">Absolutne frekvence</h4>{c_html}
      </div>
      <div style="font-size:{tf_sz}pt;">
        <h4 style="font-size:{tt_sz}pt;">Relativni deleži (%)</h4>{r_html}
      </div>
    </div>
    """
    display(HTML(html))





import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.gridspec import GridSpec
from matplotlib.patches import Patch
from IPython.display import display, Markdown


def show_numerical_data(
    feature: str,
    figsize=(15, 6),
    font_scale=0.9,
    title_size=15,
    label_size=15,
    xtick_size=14,  # velikost fonta samo za x-ticke
    ytick_size=14,  # velikost fonta samo za y-ticke
    xtick_rotation=0,  # rotacija x-tick oznak
    hist_bins=25,
    # neuporabljeno (pusti zaradi združljivosti s starim klicem)
    row_heights=(1, 0.5),
    x_label_coords=None,
    y_label_coords=(-0.14, 0.5),
    annot_x_offset=0,
    annot_y_offset=0,
    # dodatno: stikalo za KDE in element histograma
    kde=True,
    hist_element="step",  # "step" | "bars" | "poly"
):
    """
    Dva grafa + deskriptivna statistika za kvantitativno spremenljivko:
    - Boxplot po skupinah (Diabetes_012) z anotiranimi povprečji.
    - Histogram (+ opcijski KDE) z ločenimi skupinami.

    Opombe:
    - stat='density' in common_norm=False: vsak 'hue' (skupina) je
