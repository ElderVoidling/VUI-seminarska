Xb_te_t = torch.tensor(Xb_test, dtype=torch.float32)
y_te_t  = torch.tensor(y_test,  dtype=torch.float32).view(-1,1)

# 8) Dataset that returns (cont, bin, target)
class TabularDualDataset(Dataset):
    def __init__(self, Xc, Xb, y):
        self.Xc = Xc
        self.Xb = Xb
        self.y  = y
    def __len__(self):
        return len(self.y)
    def __getitem__(self, idx):
        return self.Xc[idx], self.Xb[idx], self.y[idx]

