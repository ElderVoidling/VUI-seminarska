import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler

# 1) Naloži podatke
df = pd.read_csv("diabetes_01_filtered.csv")
X = df.drop(columns=['Diabetes_012']).values
y = df['Diabetes_012'].values

# 2) Standardiziraj
scaler   = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3) Izračun centroidov v standardiziranem prostoru
a = X_scaled[y == 0].mean(axis=0)   # a = cent_nedi
b = X_scaled[y == 1].mean(axis=0)   # b = cent_di

# 4) Definicija nove funkcije f(p) = k * s
#    k = ||p - a|| / ||b - a||
#    s = ((b - a)/||b - a||) · ((p - a)/||p - a||)
import numpy as np

def f1(c, a, b):
    """
    Compute o = (k + p) / m
      where k = ||c - a|| / ||a - b||
            p = (b - a) · (c - a)
            m = (||b - a|| / ||a - b||) * ((b - a) · (b - a))
    """
    # vectors
    diff_ca = c - a
    diff_ab = b - a

    # norms
    norm_ca = np.linalg.norm(diff_ca)
    norm_ab = np.linalg.norm(diff_ab)

    # components
    k = norm_ca / norm_ab
    p = np.dot(diff_ab, diff_ca)
    m = (norm_ab / np.linalg.norm(a - b)) * np.dot(diff_ab, diff_ab)

    return (k + p) / m


