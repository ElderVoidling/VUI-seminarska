from sklearn.metrics import r2_score

def train_model(model, train_loader, test_loader, scaler_y, criterion, optimizer, epochs=50):
    train_losses, train_r2s = [], []
    test_r2s = []

    for epoch in range(epochs):
        model.train()
        running_loss = 0.0
        all_preds, all_trues = [], []

        # ——— Training pass ———
        for Xb, yb in train_loader:
            Xb, yb = Xb.to(device), yb.to(device)
            optimizer.zero_grad()
            out = model(Xb)
            loss = criterion(out, yb)
            loss.backward()
            optimizer.step()

            running_loss += loss.item() * Xb.size(0)
            all_preds.extend(out.detach().cpu().squeeze().tolist())
            all_trues.extend(yb.detach().cpu().squeeze().tolist())

        # Epoch‐level train metrics
        avg_loss = running_loss / len(train_loader.dataset)
        train_losses.append(avg_loss)

        # Denormalize to compute R² in original units
        preds_inv = scaler_y.inverse_transform(np.array(all_preds).reshape(-1,1)).flatten()
        trues_inv = scaler_y.inverse_transform(np.array(all_trues).reshape(-1,1)).flatten()
        train_r2 = r2_score(trues_inv, preds_inv)
        train_r2s.append(train_r2)

        # ——— Validation pass ———
        model.eval()
        val_preds, val_trues = [], []
        with torch.no_grad():
            for Xb, yb in test_loader:
                Xb, yb = Xb.to(device), yb.to(device)
                out = model(Xb)
                val_preds.extend(out.cpu().squeeze().tolist())
                val_trues.extend(yb.cpu().squeeze().tolist())

        val_preds_inv = scaler_y.inverse_transform(np.array(val_preds).reshape(-1,1)).flatten()
        val_trues_inv = scaler_y.inverse_transform(np.array(val_trues).reshape(-1,1)).flatten()
        test_r2 = r2_score(val_trues_inv, val_preds_inv)
        test_r2s.append(test_r2)

        print(f"Epoch {epoch+1}/{epochs}  "
              f"Train Loss: {avg_loss:.4f}  "
              f"Train R²: {train_r2:.4f}  "
              f"Test R²: {test_r2:.4f}")

    return train_losses, train_r2s, test_r2s


def plot_metrics(train_losses, train_r2s, test_r2s):
    epochs = range(1, len(train_losses) + 1)
    fig, ax1 = plt.subplots(figsize=(10,5))

    # Loss curve
    ax1.set_xlabel("Epoch")
    ax1.set_ylabel("Train Loss (MSE)", color="tab:red")
    ax1.plot(epochs, train_losses, color="tab:red", label="Train Loss")
    ax1.tick_params(axis="y", labelcolor="tab:red")

    # R² curves on second axis
    ax2 = ax1.twinx()
    ax2.set_ylabel("R² Score", color="tab:blue")
    ax2.plot(epochs, train_r2s, color="tab:blue", linestyle="--", label="Train R²")
    ax2.plot(epochs, test_r2s,  color="tab:blue", linestyle="-",  label="Test R²")
    ax2.tick_params(axis="y", labelcolor="tab:blue")

    # Legends
    lines, labels = ax1.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    ax1.legend(lines + lines2, labels + labels2, loc="best")

    plt.title("Training Progress: Loss & R²")
    fig.tight_layout()
    plt.grid(True)
    plt.show()



def predict(model, X):
    model.eval()
    xt = torch.tensor(X, dtype=torch.float32).to(device)
    with torch.no_grad():
        yt = model(xt).cpu().squeeze().numpy()
    return yt






