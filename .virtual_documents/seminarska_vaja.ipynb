import numpy as np

def average_recommended_adjustment_differences(
    model,
    XB_test,
    Xc_test,
    nudge_alpha,
    scaler_xc,
    scaler_y,
    binary_feature_names,
    continuous_feature_names,
    ordinal_feature_names,
    ordinal_bounds,
    device,
    print_raw_gradients=False,
    max_samples=None,
):
    """
    For each sample in XB_test/Xc_test, calls get_recommended_adjustment with verbose=False,
    computes (new - original) per feature, averages across samples, prints and returns the averages.
    Returns:
        (avg_bin_dict, avg_cont_dict)
    """
    # Try to enable a notebook/console-friendly progress bar
    try:
        from tqdm.auto import tqdm
        _tqdm = tqdm
    except Exception:
        _tqdm = None

    def _to_1d_numpy(row):
        try:
            import torch
            if isinstance(row, torch.Tensor):
                row = row.detach().cpu().numpy()
        except Exception:
            pass
        if hasattr(row, "to_numpy"):
            row = row.to_numpy()
        arr = np.asarray(row)
        if arr.ndim == 2:
            if arr.shape[0] == 1:
                arr = arr[0]
            elif arr.shape[1] == 1:
                arr = arr[:, 0]
        return arr

    n_total = len(XB_test)
    n = n_total if max_samples is None else min(n_total, max_samples)

    sum_bin = np.zeros(len(binary_feature_names), dtype=float)
    sum_cont = np.zeros(len(continuous_feature_names), dtype=float)

    iterator = range(n)
    if _tqdm is not None:
        iterator = _tqdm(iterator, total=n, desc="Computing recommended adjustments", leave=False)

    for i in iterator:
        orig_bin = _to_1d_numpy(XB_test[i])
        orig_cont = _to_1d_numpy(Xc_test[i])

        new_bin, new_cont = get_recommended_adjustment(
            model=model,
            sample_binary_values=orig_bin,
            sample_continuous_values=orig_cont,
            nudge_alpha=nudge_alpha,
            scaler_xc=scaler_xc,
            scaler_y=scaler_y,
            binary_feature_names=binary_feature_names,
            continuous_feature_names=continuous_feature_names,
            ordinal_feature_names=ordinal_feature_names,
            ordinal_bounds=ordinal_bounds,
            device=device,
            verbose=False,
            print_raw_gradients=print_raw_gradients,
        )

        new_bin = _to_1d_numpy(new_bin)
        new_cont = _to_1d_numpy(new_cont)

        if new_bin.shape[0] != sum_bin.shape[0] or new_cont.shape[0] != sum_cont.shape[0]:
            raise ValueError("Shape mismatch between features and returned arrays.")

        sum_bin += (new_bin - orig_bin)
        sum_cont += (new_cont - orig_cont)

    avg_bin = sum_bin / n
    avg_cont = sum_cont / n

    # Pretty print
    try:
        import pandas as pd
        print("Average binary feature deltas (new - original):")
        display(pd.Series(avg_bin, index=binary_feature_names))
        print("Average continuous feature deltas (new - original):")
        display(pd.Series(avg_cont, index=continuous_feature_names))
    except Exception:
        print("Average binary feature deltas (new - original):")
        for name, delta in zip(binary_feature_names, avg_bin):
            print(f"  {name}: {delta:.6f}")
        print("Average continuous feature deltas (new - original):")
        for name, delta in zip(continuous_feature_names, avg_cont):
            print(f"  {name}: {delta:.6f}")

    avg_bin_dict = {name: float(val) for name, val in zip(binary_feature_names, avg_bin)}
    avg_cont_dict = {name: float(val) for name, val in zip(continuous_feature_names, avg_cont)}
    return avg_bin_dict, avg_cont_dict


