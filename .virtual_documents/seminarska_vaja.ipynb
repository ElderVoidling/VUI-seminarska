import pandas as pd
import numpy as np
import pingouin as pg
import scikit_posthocs as sp

def _p_matrix(df, factor, y_col, method):
    data = df[[factor, y_col]].dropna()
    groups = sorted(pd.unique(data[factor]))
    pmat = pd.DataFrame(np.nan, index=groups, columns=groups, dtype=float)

    if method == "games-howell":
        ph = pg.pairwise_gameshowell(data=data, dv=y_col, between=factor)
        for _, r in ph.iterrows():
            g1, g2, p = r["A"], r["B"], float(r["pval"])
            pmat.loc[g1, g2] = p
            pmat.loc[g2, g1] = p

    elif method == "bonferroni":
        ph = pg.pairwise_ttests(
            data=data, dv=y_col, between=factor,
            padjust="bonf", parametric=True, equal_var=False
        )
        for _, r in ph.iterrows():
            g1, g2, p = r["A"], r["B"], float(r["p-corr"])
            pmat.loc[g1, g2] = p
            pmat.loc[g2, g1] = p

    elif method == "tukey":
        tuk = sp.posthoc_tukey(data, val_col=y_col, group_col=factor)
        tuk = tuk.reindex(index=groups, columns=groups)
        pmat = tuk.astype(float)
    else:
        raise ValueError("method mora biti 'games-howell', 'bonferroni' ali 'tukey'")
    np.fill_diagonal(pmat.values, np.nan)
    return pmat

def _format_triangle(pmat, alpha=0.05, pct_digits=2, tiny=1e-4):
    groups = list(pmat.index)
    out = pd.DataFrame("", index=groups, columns=groups)
    for i, gi in enumerate(groups):
        for j, gj in enumerate(groups):
            if i == j:
                out.iloc[i, j] = "-"
            elif i < j:
                p = pmat.loc[gi, gj]
                if pd.isna(p):
                    out.iloc[i, j] = ""
                else:
                    out.iloc[i, j] = "<0.01%" if p < tiny else f"{p*100:.{pct_digits}f}%"
            else:  # i > j
                p = pmat.loc[gi, gj] if not pd.isna(pmat.loc[gi, gj]) else pmat.loc[gj, gi]
                out.iloc[i, j] = "DA" if (p < alpha) else "NE"
    return out

def posthoc_triangle_matrix(df, factor, y_col="BMI", method="games-howell", alpha=0.05, pct_digits=2):
    pmat = _p_matrix(df, factor, y_col, method)
    return _format_triangle(pmat, alpha=alpha, pct_digits=pct_digits)

# --- Usage for your factors ---
factors = ["GenHlth", "Age", "Education", "Income"]
method = "games-howell"  # or "bonferroni" or "tukey"
alpha = 0.05

matrices = {f: posthoc_triangle_matrix(df, f, y_col="BMI", method=method, alpha=alpha, pct_digits=2)
            for f in factors}

for f in factors:
    print(f"\nPost-hoc triangular matrix for {f} ({method}, α={alpha}):")
    display(matrices[f])

