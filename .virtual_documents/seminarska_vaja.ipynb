import torch
import numpy as np
import pandas as pd

def run_db_simulation(
    model,
    scaler,
    original_df,
    feature_columns,
    device,
    priority_order_map,
    max_steps_per_feature=10,
    y_col="Diabetes_012",
):
    """
    Simulira spremembe za VSE osebe z y_col == 1.

    Vrne:
      - simulation_results: list slovarjev z logom sprememb na osebo
      - pre_median: mediana (po stolpcih) vseh diabetikov pred simulacijo
      - post_median: mediana (po stolpcih) tistih, ki so se preklopili v 0
      - pre_mean: povprečje (po stolpcih) vseh diabetikov pred simulacijo
      - post_mean_all: povprečje (po stolpcih) končnih vrednosti (vsi obravnavani)
      - post_mean_converted: povprečje (po stolpcih) tistih, ki so se preklopili v 0
    """
    model.eval()
    simulation_results = []

    # Indeksi vseh diabetikov (po labelu)
    all_diabetic_indices = original_df[original_df[y_col] == 1].index.tolist()
    if not all_diabetic_indices:
        print("Ni najdenih diabetičnih osebkov za simulacijo.")
        return [], None, None, None, None, None

    # Pre median/mean (nestandardizirano) za VSE diabetike
    diabetics_df = (
        original_df.loc[all_diabetic_indices, feature_columns]
        .apply(pd.to_numeric, errors="coerce")
    )
    pre_median = diabetics_df.median()
    pre_mean = diabetics_df.mean()

    print(
        f"\n--- Zagon simulacije za VSE diabetike (N={len(all_diabetic_indices)}) ---"
    )

    for idx_pos, original_idx in enumerate(all_diabetic_indices, start=1):
        original_person_data = (
            original_df.loc[original_idx, feature_columns].values.reshape(1, -1)
        )
        current_scaled = scaler.transform(original_person_data.copy())
        current_tensor = torch.tensor(
            current_scaled, dtype=torch.float32, device=device
        )

        init_proba = float(model(current_tensor).item())
        init_class = int(init_proba > 0.5)

        person_log = {
            "original_index": int(original_idx),
            "initial_data": original_person_data[0].tolist(),
            "initial_proba": init_proba,
            "initial_class": init_class,
            "final_classification": init_class,
            "changes_made": [],
        }

        # Če je že 0, ne spreminjamo; zabeležimo končno stanje
        if init_class == 0:
            person_log["final_data"] = original_person_data[0].tolist()
            person_log["final_proba"] = init_proba
            simulation_results.append(person_log)
            continue

        # Poskusi sprememb po prioritetah
        person_scaled = current_scaled.copy()
        classification_changed = False
        original_feature_values_non_scaled = scaler.inverse_transform(
            person_scaled.copy()
        )[0]

        print(
            f"\n[{idx_pos}/{len(all_diabetic_indices)}] Oseba idx={original_idx}: "
            f"začetna p(1)={init_proba:.4f} (class=1) → poskus preklopa"
        )

        for feature_name in priority_order_map:
            if feature_name not in feature_columns:
                print(
                    f"  Opozorilo: '{feature_name}' ni v feature_columns. Preskakujem."
                )
                continue

            f_idx = feature_columns.index(feature_name)
            f_info = priority_order_map[feature_name]
            steps_taken = 0

            cur_tensor = torch.tensor(
                person_scaled, dtype=torch.float32, device=device
            )
            cur_proba = float(model(cur_tensor).item())
            cur_class = int(cur_proba > 0.5)
            if cur_class == 0:
                classification_changed = True
                break

            print(
                f"  Spreminjam {feature_name} (trenutna p(1)={cur_proba:.4f}) "
                f"do največ {max_steps_per_feature} korakov"
            )

            while cur_class == 1 and steps_taken < max_steps_per_feature:
                tmp_scaled = person_scaled.copy()
                tmp_non_scaled = scaler.inverse_transform(tmp_scaled.copy())
                changed = False

                if f_info["direction"] == "switch_to_0":
                    if tmp_non_scaled[0, f_idx] == 1:
                        tmp_non_scaled[0, f_idx] = 0
                        changed = True
                        steps_taken += 1
                    new_scaled = scaler.transform(tmp_non_scaled) if changed else None

                elif f_info["direction"] == "switch_to_1":
                    if tmp_non_scaled[0, f_idx] == 0:
                        tmp_non_scaled[0, f_idx] = 1
                        changed = True
                        steps_taken += 1
                    new_scaled = scaler.transform(tmp_non_scaled) if changed else None

                elif f_info["direction"] == "decrease_ordinal":
                    if tmp_non_scaled[0, f_idx] > 1:
                        tmp_non_scaled[0, f_idx] -= 1
                        changed = True
                        steps_taken += 1
                        new_scaled = scaler.transform(tmp_non_scaled)
                    else:
                        break

                elif f_info["direction"] == "increase_ordinal":
                    cur_val = tmp_non_scaled[0, f_idx]
                    if feature_name in ("Education", "Age"):
                        max_val = original_df[feature_name].max()
                        if cur_val < max_val:
                            tmp_non_scaled[0, f_idx] += 1
                            changed = True
                            steps_taken += 1
                            new_scaled = scaler.transform(tmp_non_scaled)
                        else:
                            break
                    else:
                        break

                elif f_info["direction"] == "decrease":
                    step = f_info.get("step_size_scaled", 1.0)
                    cur_non_scaled = scaler.inverse_transform(
                        person_scaled.copy()
                    )[0, f_idx]
                    if cur_non_scaled > original_df[feature_name].min():
                        tmp_scaled[0, f_idx] -= step
                        changed = True
                        steps_taken += 1
                        new_scaled = tmp_scaled
                    else:
                        break

                elif f_info["direction"] == "increase":
                    step = f_info.get("step_size_scaled", 1.0)
                    cur_non_scaled = scaler.inverse_transform(
                        person_scaled.copy()
                    )[0, f_idx]
                    if cur_non_scaled < original_df[feature_name].max():
                        tmp_scaled[0, f_idx] += step
                        changed = True
                        steps_taken += 1
                        new_scaled = tmp_scaled
                    else:
                        break

                else:
                    break

                if not changed:
                    break

                person_scaled = new_scaled
                cur_tensor = torch.tensor(
                    person_scaled, dtype=torch.float32, device=device
                )
                cur_proba = float(model(cur_tensor).item())
                cur_class = int(cur_proba > 0.5)
                cur_non_scaled = scaler.inverse_transform(person_scaled.copy())[0]

                person_log["changes_made"].append(
                    {
                        "feature": feature_name,
                        "original_value_at_step_start": float(
                            original_feature_values_non_scaled[f_idx]
                        ),
                        "changed_value_to": float(cur_non_scaled[f_idx]),
                        "prediction_proba_after_change": cur_proba,
                        "prediction_class_after_change": cur_class,
                        "steps_taken_for_feature": steps_taken,
                    }
                )

                if cur_class == 0:
                    print(
                        f"    → Uspeh: class=0 po {steps_taken} korakih na "
                        f"{feature_name}, p(1)={cur_proba:.4f}"
                    )
                    classification_changed = True
                    break

            if classification_changed:
                break

        # Končno stanje (ne glede na uspeh)
        final_non_scaled = scaler.inverse_transform(person_scaled.copy())[0]
        final_tensor = torch.tensor(person_scaled, dtype=torch.float32, device=device)
        final_proba = float(model(final_tensor).item())
        final_class = int(final_proba > 0.5)

        person_log["final_data"] = final_non_scaled.tolist()
        person_log["final_proba"] = final_proba
        person_log["final_classification"] = final_class

        if not classification_changed:
            print(
                f"  Oseba idx={original_idx}: ostane class=1 "
                f"(p(1)={final_proba:.4f}) kljub poskusom."
            )

        simulation_results.append(person_log)

    # Povzetni okviri za "po simulaciji"
    all_final = pd.DataFrame(
        [r["final_data"] for r in simulation_results], columns=feature_columns
    ).apply(pd.to_numeric, errors="coerce")

    converted = [
        r["final_data"]
        for r in simulation_results
        if (r["final_classification"] == 0 and len(r["changes_made"]) > 0)
    ]
    converted_df = (
        pd.DataFrame(converted, columns=feature_columns).apply(
            pd.to_numeric, errors="coerce"
        )
        if len(converted) > 0
        else None
    )

    # Median
    post_median = converted_df.median() if converted_df is not None else None

    # Mean
    post_mean_all = all_final.mean() if not all_final.empty else None
    post_mean_converted = (
        converted_df.mean() if converted_df is not None and not converted_df.empty else None
    )

    # Povzetek
    converted_n = sum(
        1 for r in simulation_results if (r["final_classification"] == 0 and len(r["changes_made"]) > 0)
    )
    print(
        f"\n✅ Simulacija končana. Uspešno preklopljenih (z vsaj eno spremembo): "
        f"{converted_n} od {len(all_diabetic_indices)}"
    )

    print("\nMediana (pred) – diabetiki (Y=1):")
    print(pre_median.to_string())

    if post_median is not None:
        print("\nMediana (po) – uspešno preklopljeni v class=0:")
        print(post_median.to_string())
    else:
        print("\nMediana (po): ni podatkov (ni uspešnih preklopov).")

    print("\nPovprečje (pred) – diabetiki (Y=1):")
    print(pre_mean.to_string())

    if post_mean_all is not None:
        print("\nPovprečje (po) – končne vrednosti (vsi obravnavani):")
        print(post_mean_all.to_string())
    else:
        print("\nPovprečje (po) – končne vrednosti: ni podatkov.")

    if post_mean_converted is not None:
        print("\nPovprečje (po) – le uspešno preklopljeni v class=0:")
        print(post_mean_converted.to_string())
    else:
        print("\nPovprečje (po) – le uspešno preklopljeni: ni podatkov.")

    return (
        simulation_results,
        pre_median,
        post_median,
        pre_mean,
        post_mean_all,
        post_mean_converted,
    )

def print_vertical_summary(
    feature_columns,
    pre_median,
    post_median,
    pre_mean,
    post_mean_all,
    post_mean_converted,
    float_fmt="{:.4f}",
):
    # Sestavi stolpce, ki so na voljo
    parts = {}
    if pre_median is not None:
        parts["median_pre"] = pre_median
    if post_median is not None:
        parts["median_post_conv"] = post_median
    if pre_mean is not None:
        parts["mean_pre"] = pre_mean
    if post_mean_all is not None:
        parts["mean_post_all"] = post_mean_all
    if post_mean_converted is not None:
        parts["mean_post_conv"] = post_mean_converted

    summary_df = pd.concat(parts, axis=1).reindex(feature_columns)

    # Dodaj razlike (če so potrebni stolpci na voljo)
    if {"median_pre", "median_post_conv"}.issubset(summary_df.columns):
        summary_df["Δ_median_postconv"] = (
            summary_df["median_post_conv"] - summary_df["median_pre"]
        )
    if {"mean_pre", "mean_post_all"}.issubset(summary_df.columns):
        summary_df["Δ_mean_post_all"] = (
            summary_df["mean_post_all"] - summary_df["mean_pre"]
        )
    if {"mean_pre", "mean_post_conv"}.issubset(summary_df.columns):
        summary_df["Δ_mean_post_conv"] = (
            summary_df["mean_post_conv"] - summary_df["mean_pre"]
        )

    print("\n— Vertikalni povzetek po spremenljivkah —")
    print(summary_df.to_string(float_format=lambda x: float_fmt.format(x)))

    return summary_df

#klic simulacije
