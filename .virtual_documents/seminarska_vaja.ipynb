import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm

# 1) Naloži podatke
df = pd.read_csv("diabetes_01_filtered.csv")
X = df.drop(columns=['Diabetes_012']).values
y = df['Diabetes_012'].values

# 2) Standardiziraj
scaler   = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3) PCA v 2D
pca      = PCA(n_components=2)
X_pca    = pca.fit_transform(X_scaled)

# 4) Izračun centroidov v originalnem prostoru
a = X_scaled[y == 0].mean(axis=0)
b = X_scaled[y == 1].mean(axis=0)

# 5) Projekcija centroidov v PCA-koordinate
mean0_pca = pca.transform(a.reshape(1, -1)).ravel()
mean1_pca = pca.transform(b.reshape(1, -1)).ravel()

# 6) Rotacija PCA-projekcije tako, da je prva os ∥ centroid_diff
d      = mean1_pca - mean0_pca
axis_x = d / np.linalg.norm(d)
axis_y = np.array([-axis_x[1], axis_x[0]])
T      = np.vstack([axis_x, axis_y]).T
X_rot      = X_pca.dot(T)
mean0_rot  = mean0_pca.dot(T)
mean1_rot  = mean1_pca.dot(T)

# 7)
def f1(c, a, b):
    """
    Compute o = (k + p) / m
      where k = ||c - a|| / ||a - b||
            p = (b - a) · (c - a)
            m = (||b - a|| / ||a - b||) * ((b - a) · (b - a))
    """
    # vectors
    diff_ca = c - a
    diff_ab = b - a

    # norms
    norm_ca = np.linalg.norm(diff_ca)
    norm_ab = np.linalg.norm(diff_ab)

    # components
    k = norm_ca / norm_ab
    p = np.dot(diff_ab, diff_ca)
    m = (norm_ab / np.linalg.norm(a - b)) * np.dot(diff_ab, diff_ab)

    return (k + p) / m

# 8) Izračun nove značilke za vsak vzorec
new_numeric_diabetic_feature = np.array([f(p, a, b) for p in X_scaled])


# 1) find the max absolute so we can symmetrize
