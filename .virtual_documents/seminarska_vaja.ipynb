import pandas as pd
import torch
import torch.nn as nn
import os
from datetime import datetime # Za iskanje najnovejšega modela
from sklearn.preprocessing import StandardScaler # Potrebujemo scaler za simulacijo
from torch.utils.data import DataLoader, TensorDataset # Lahko so potrebni za evaluate_model, če ga kličete
from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay # Za prikaz matrike zmede
from sklearn.model_selection import train_test_split
import matplotlib.pyplot as plt # Za grafe

# --- 1. Definiramo napravo (CPU/GPU) ---
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
