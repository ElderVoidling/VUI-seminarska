        "razmerje_max_min": round(ratio, 3),
        "equal_strict(≤1.2)": ratio <= 1.2,
        "equal_loose(≤2.0)": ratio <= 2.0,
        "Komentar": (
            "≈ enake velikosti" if ratio <= 1.2 else
            ("OK-ish (do 2×)" if ratio <= 2.0 else "velike razlike")
        )
    }

