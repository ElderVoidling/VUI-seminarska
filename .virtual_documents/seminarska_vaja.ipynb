# === Diagnostika: BMI (Y) vs. numerične X (scatter + QQ + K–S) ===
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
NUMERIC_X_COLS = ["PhysHlth", "MentHlth"]  # numerične X spremenljivke
ALPHA = 0.05
MAX_QQ_POINTS = 5000
RANDOM_STATE = 42

# --- 1) Preberi podatke ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
for c in NUMERIC_X_COLS:
    assert c in df.columns, f"{c} ni v stolpcih!"

# --- 2) Pomožne ---
def iqr_outlier_share(x: np.ndarray):
    x = x[~np.isnan(x)]
    if x.size == 0:
        return np.nan
    q1, q3 = np.percentile(x, [25, 75])
    iqr = q3 - q1
    lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
    return np.mean((x < lo) | (x > hi))

def normality_comment_from_share(out_share):
    if pd.isna(out_share): return "ni podatkov"
    if out_share <= 0.012: return "≈ normalno"
    elif out_share <= 0.03: return "rahla odstopanja"
    else: return "verjetno nenormalno"

def sample_for_qq(x: np.ndarray, max_n=MAX_QQ_POINTS, random_state=RANDOM_STATE):
    x = x[~np.isnan(x)]
    if x.size <= max_n:
        return x
    rng = np.random.default_rng(random_state)
    idx = rng.choice(x.size, size=max_n, replace=False)
    return x[idx]

def ks_normal_test(x: np.ndarray):
    """K–S proti N(mu_hat, sigma_hat). (aproksimacija, ker parametre ocenimo iz podatkov)"""
    x = x[~np.isnan(x)]
    if x.size < 2:
        return np.nan, np.nan
    mu, sigma = np.mean(x), np.std(x, ddof=1)
    if sigma <= 0 or not np.isfinite(sigma):
        return np.nan, np.nan
    d, p = stats.kstest(x, 'norm', args=(mu, sigma))
    return d, p

def ks_comment(p, alpha=ALPHA):
    if not np.isfinite(p):
        return "ni podatkov"
    return "verjetno normalno" if p >= alpha else "verjetno nenormalno"

# --- 3) Diagnostika po X ---
for x_col in NUMERIC_X_COLS:
    # veljavni pari brez NaN
    mask = (~df[x_col].isna()) & (~df[Y_COL].isna())
    x = df.loc[mask, x_col].astype(float).to_numpy()
    y = df.loc[mask, Y_COL].astype(float).to_numpy()

    # heuristika iz IQR (delež outlierjev)
    out_x = iqr_outlier_share(x)
    out_y = iqr_outlier_share(y)
    comm_x = normality_comment_from_share(out_x)
    comm_y = normality_comment_from_share(out_y)

    # K–S test (aproks.)
    d_x, p_x = ks_normal_test(x)
    d_y, p_y = ks_normal_test(y)
    ks_comm_x = ks_comment(p_x)
    ks_comm_y = ks_comment(p_y)

    # --- IZPIS (kompaktno) ---
    print(f"\n=== {Y_COL} vs {x_col} (n={x.size}) ===")
    print(f"IQR outlier_share: X={out_x*100:.2f}% → {comm_x} | Y={out_y*100:.2f}% → {comm_y}")
    if np.isfinite(p_x):
        print(f"K–S normalnost X: D={d_x:.3f}, p={p_x:.3e} → {ks_comm_x}")
    else:
        print("K–S normalnost X: ni podatkov")
    if np.isfinite(p_y):
        print(f"K–S normalnost Y: D={d_y:.3f}, p={p_y:.3e} → {ks_comm_y}")
    else:
        print("K–S normalnost Y: ni podatkov")

    # --- FIG: 1 vrstica = [Scatter, QQ(Y), QQ(X)] ---
    fig, axes = plt.subplots(1, 3, figsize=(14, 3.5))

    # (1) Scatter BMI ~ X
    axes[0].scatter(x, y, s=5, alpha=0.4)
    axes[0].set_title(f"Scatter: {Y_COL} vs {x_col}", fontsize=10)
    axes[0].set_xlabel(x_col, fontsize=9)
    axes[0].set_ylabel(Y_COL, fontsize=9)

    # (2) QQ plot Y
    y_qq = sample_for_qq(y)
    stats.probplot(y_qq, dist="norm", plot=axes[1])
    axes[1].set_title(f"QQ {Y_COL}", fontsize=10)

    # (3) QQ plot X
    x_qq = sample_for_qq(x)
    stats.probplot(x_qq, dist="norm", plot=axes[2])
    axes[2].set_title(f"QQ {x_col}", fontsize=10)

    fig.suptitle(f"{Y_COL} vs {x_col} — Scatter + QQ + K–S", fontsize=11)
    fig.tight_layout(rect=[0, 0, 1, 0.92])
    plt.show()

print("\n✅ Končano: scatter + QQ + K–S diagnostika za numerične X.")






import numpy as np
import pandas as pd
from scipy import stats

# ==== Nastavitve ====
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
ALPHA = 0.05

df = pd.read_csv(CSV_PATH)

# --- Izberi numerične spremenljivke (razen Y_COL) ---
num_cols = ["PhysHlth", "MentHlth"]

rows = []

for x_col in num_cols:
    x = df[x_col].astype(float)
    y = df[Y_COL].astype(float)

    mask = (~x.isna()) & (~y.isna())
    x_valid, y_valid = x[mask], y[mask]

    if x_valid.nunique() < 2:
        continue  # preskoči konstante

    # Spearman korelacija
    rho, p_val = stats.spearmanr(x_valid, y_valid)

    signif = p_val < ALPHA
    sklep = "statistično značilna povezava" if signif else "ni statistično značilne povezave"

    # Smer povezave
    if signif:
        smer = "pozitivna" if rho > 0 else "negativna"
    else:
        smer = "-"

    row = {
        "spremenljivka": x_col,
        "izbran_test": "Spearman",
        "rho": rho,
        "p_value": p_val,
        "Sklep": sklep,
        "Smer": smer
    }
    rows.append(row)

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

results












