red_stretch = 0.5
# 2) set up a diverging norm centered on 0
norm = TwoSlopeNorm(vmin=-abs_max * blue_stretch, vcenter=color_center, vmax=abs_max * red_stretch)

# 3) do your scatter with norm (not vmin/vmax)
plt.figure(figsize=(6,6))
sc = plt.scatter(
    X_rot[:,0], X_rot[:,1],
