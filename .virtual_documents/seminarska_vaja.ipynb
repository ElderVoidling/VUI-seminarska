    norm=norm,              # <-- this makes 0 map to the midpoint (white)
    s=10, alpha=1
)
plt.colorbar(sc, label='new_numeric_diabetic_feature')

# plot the centroids
plt.scatter(mean0_rot[0], mean0_rot[1],
            marker='X', s=200, color='blue', edgecolor='k', label='Mean (Class 0)')
plt.scatter(mean1_rot[0], mean1_rot[1],
            marker='X', s=200, color='red',  edgecolor='k', label='Mean (Class 1)')

plt.axhline(0, color='grey', linestyle='--')
plt.axvline(0, color='grey', linestyle='--')
plt.xlabel('Rotated axis ∥ (mean1 – mean0)')
