# === Diagnostika BMI (Y) vs. ordinalne / večskupinske X (≥3 kategorij) + QQ ploti ===
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
BINS = 50
RANDOM_STATE = 42
MAX_OVERLAY_GROUPS = 6   # max št. kategorij v prekrivnem histogramu (za berljivost)
MAX_QQ_POINTS = 2000     # vzorčenje za QQ (da ni preveč točk)

# --- 1) Preberi podatke ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"

# --- 2) Izbor ordinalnih/kategoričnih X (≥3 kategorij) ---
preferred = [c for c in ["GenHlth", "Age", "Education", "Income"] if c in df.columns]

def is_multicat(s: pd.Series, min_k=3, max_k=12):
    if s.name == Y_COL: 
        return False
    vals = pd.unique(s.dropna())
    k = vals.size
    return (k >= min_k) and (k <= max_k)

if preferred:
    multicat_cols = preferred
else:
    multicat_cols = [c for c in df.columns if is_multicat(df[c])]

print(f"Najdene večskupinske/ordinalne X ({len(multicat_cols)}): {multicat_cols}")

# --- 3) Pomožne ---
def iqr_outlier_share(x: np.ndarray):
    x = x[~np.isnan(x)]
    if x.size == 0:
        return np.nan
    q1, q3 = np.percentile(x, [25, 75])
    iqr = q3 - q1
    lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
    return np.mean((x < lo) | (x > hi))

def normality_comment_from_share(out_share):
    if pd.isna(out_share):
        return "ni podatkov"
    if out_share <= 0.012: return "≈ normalno"
    elif out_share <= 0.03: return "rahla odstopanja"
    else: return "verjetno nenormalno"

def summarize_group(arr):
    arr = np.asarray(arr, dtype=float)
    arr = arr[~np.isnan(arr)]
    if arr.size == 0:
        return dict(n=0, median=np.nan, out_share=np.nan)
    return dict(n=arr.size, median=float(np.median(arr)), out_share=float(iqr_outlier_share(arr)))

def sample_for_qq(x: np.ndarray, max_n=MAX_QQ_POINTS, random_state=RANDOM_STATE):
    x = x[~np.isnan(x)]
    if x.size <= max_n: return x
    rng = np.random.default_rng(random_state)
    return rng.choice(x, size=max_n, replace=False)

def top_k_categories_by_n(series, k=MAX_OVERLAY_GROUPS):
    order = series.value_counts(dropna=False).sort_values(ascending=False).index.tolist()
    return order[:k]

# --- 4) Diagnostika ---
for x_col in multicat_cols:
    x = df[x_col]
    y = df[Y_COL].astype(float)
    mask = (~x.isna()) & (~y.isna())
    x_valid, y_valid = x[mask], y[mask]

    levels = pd.Categorical(x_valid).categories.tolist() if not pd.api.types.is_numeric_dtype(x_valid) else sorted(pd.unique(x_valid))
    try: levels = sorted(levels)
    except: pass

    groups = [y_valid[x_valid == lvl].to_numpy() for lvl in levels]
    ns = [g.size for g in groups]
    levels, groups = [lvl for lvl,n in zip(levels,ns) if n>0], [g for g in groups if g.size>0]

    if len(groups) < 3:
        print(f"\n=== {x_col} → BMI ===\n⚠️ Manj kot 3 neprazne kategorije — preskočim.")
        continue

    # opisna tabela
    rows, max_out_share = [], 0.0
    for lvl,g in zip(levels,groups):
        s = summarize_group(g)
        max_out_share = max(max_out_share, 0 if pd.isna(s["out_share"]) else s["out_share"])
        rows.append({
            "kategorija": lvl, "n": s["n"], "median_BMI": s["median"],
            "outlier_share_%": None if pd.isna(s["out_share"]) else round(100*s["out_share"],2),
            "normalnost (heur)": normality_comment_from_share(s["out_share"])
        })
    desc = pd.DataFrame(rows)

    lev_stat, lev_p = stats.levene(*groups, center='mean')

    print(f"\n=== {x_col} (≥3) → BMI ===")
    print(desc.to_string(index=False))
    print(f"Levene p={lev_p:.3e} → variance: {'enake' if lev_p>=0.05 else 'neenake'}")
    print(f"Sklep normalnost (najslabša skupina): {normality_comment_from_share(max_out_share)}")

    # --- FIG 1: Hist + Boxplot + Violin ---
    fig, axes = plt.subplots(1, 3, figsize=(15, 3.2))
    top_levels = top_k_categories_by_n(x_valid, k=MAX_OVERLAY_GROUPS)
    for lvl in top_levels:
        y_l = y_valid[x_valid == lvl].to_numpy()
        axes[0].hist(y_l, bins=BINS, alpha=0.5, density=True, label=str(lvl))
    axes[0].set_title(f"Hist (top {len(top_levels)} skupin)", fontsize=10); axes[0].legend(fontsize=7,ncols=2)
    axes[1].boxplot(groups, labels=[str(l) for l in levels], showfliers=True)
    axes[1].set_title("Boxplot"); axes[1].tick_params(axis='x',labelrotation=30 if len(levels)>6 else 0)
    parts = axes[2].violinplot(groups, showmeans=True, showmedians=False, showextrema=False)
    axes[2].set_title("Violin"); axes[2].set_xticks(range(1,len(levels)+1)); axes[2].set_xticklabels([str(l) for l in levels], rotation=30 if len(levels)>6 else 0, fontsize=8)
    fig.suptitle(f"{x_col} vs BMI — hist/box/violin", fontsize=11); fig.tight_layout(rect=[0,0,1,0.92]); plt.show()

    # --- FIG 2: QQ ploti v eni vrstici ---
    fig, axes = plt.subplots(1, len(groups), figsize=(3*len(groups), 3))
    if len(groups)==1: axes=[axes]
    for ax,g,lvl in zip(axes, groups, levels):
        g_sample = sample_for_qq(g)
        stats.probplot(g_sample, dist="norm", plot=ax)
        ax.set_title(f"QQ: {lvl}", fontsize=9)
    fig.suptitle(f"{x_col} vs BMI — QQ ploti po skupinah", fontsize=11)
    fig.tight_layout(rect=[0,0,1,0.92]); plt.show()

print("\n✅ Končano: diagnostični pregledi + QQ ploti po skupinah za vse ordinalne/večskupinske X.")









import numpy as np
import pandas as pd
from scipy import stats

# ==== Nastavitve ====
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "BMI"
ALPHA = 0.05
expanded_report = False  # False = skrajšano poročilo; True = razširjeno

df = pd.read_csv(CSV_PATH)

# --- Izbor ordinalnih / večskupinskih X (≥3 kategorij) ---
preferred = [c for c in ["GenHlth", "Age", "Education", "Income"] if c in df.columns]

def is_multicat(s: pd.Series, min_k=3, max_k=20):
    if s.name == Y_COL:
        return False
    vals = pd.unique(s.dropna())
    k = vals.size
    return (k >= min_k) and (k <= max_k)

if preferred:
    multicat_cols = preferred
else:
    multicat_cols = [c for c in df.columns if is_multicat(df[c])]

print(f"Najdene večskupinske/ordinalne X ({len(multicat_cols)}): {multicat_cols}")

# --- Pomožne funkcije ---
def kruskal_epsilon_squared(H, N, k):
    """Epsilon-squared efektna mera za Kruskal–Wallis: ε² = (H - k + 1) / (N - 1)."""
    if N <= 1:
        return np.nan
    return (H - k + 1) / (N - 1)

def eps_magnitude(eps):
    if not np.isfinite(eps):
        return "neznano"
    a = abs(eps)
    if a < 0.01: return "zelo majhen"
    if a < 0.06: return "majhen"
    if a < 0.14: return "srednji"
    return "velik"

rows = []
g_= []
for x_col in multicat_cols:
    x = df[x_col]
    y = df[Y_COL].astype(float)

    mask = (~x.isna()) & (~y.isna())
    x_valid, y_valid = x[mask], y[mask]

    # ➡️ Preprosto: unikatne vrednosti kategorij, sortirane
    levels = sorted(pd.unique(x_valid))

    # Zgradi skupine glede na kategorije
    groups = [y_valid[x_valid == lvl].to_numpy() for lvl in levels]
    tmp = [(lvl, g) for lvl, g in zip(levels, groups) if g.size > 0]
    if len(tmp) < 3:
        print(f"⚠️ {x_col}: manj kot 3 neprazne kategorije — preskočim.")
        continue
    levels, groups = zip(*tmp)
    levels, groups = list(levels), list(groups)

    # Kruskal–Wallis H test
    H_stat, p_val = stats.kruskal(*groups)
    N = sum(g.size for g in groups)
    k = len(groups)
    eps2 = kruskal_epsilon_squared(H_stat, N, k)
    dfree = k - 1  # stopinje prostosti
    g_ = groups
    # Mediane po skupinah
    medians = [float(np.median(g)) for g in groups]
    ns = [g.size for g in groups]
    order_idx = np.argsort(medians)
    lowest_cat = str(levels[int(order_idx[0])])
    highest_cat = str(levels[int(order_idx[-1])])

    signif = p_val < ALPHA
    sklep = "statistično značilne razlike med kategorijami" if signif else "ni statistično značilnih razlik"
    eps_mag = eps_magnitude(eps2)

    row = {
        "spremenljivka": x_col,
        "izbran_test": "Kruskal–Wallis H",
        "k": k,
        "df": dfree,
        "H_stat": H_stat,
        "p_value": p_val,
        "epsilon_sq": eps2,
        "eps_magnitude": eps_mag,
        "Sklep": sklep,
        "Najnižja_mediana_kat": lowest_cat,
        "Najvišja_mediana_kat": highest_cat
    }

    if expanded_report:
        for lvl, n, med in zip(levels, ns, medians):
            row[f"n[{lvl}]"] = n
            row[f"median_BMI[{lvl}]"] = med

    rows.append(row)

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

# Skrajšana ali razširjena tabela
if not expanded_report:
    keep = [
        "spremenljivka","izbran_test","k","df",
        "H_stat","p_value",
        "Sklep"
    ]
    results = results[keep]

pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

results



