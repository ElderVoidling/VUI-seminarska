def evaluate_model_dual(model, test_loader, scaler_y):
    model.to(device)
    model.eval()
    y_preds = []
    y_trues = []

    with torch.no_grad():
        for x_cont, x_bin, yb in test_loader:
            x_cont, x_bin, yb = x_cont.to(device), x_bin.to(device), yb.to(device)

            output = model(x_cont, x_bin)
            y_preds.extend(output.cpu().squeeze().tolist())
            y_trues.extend(yb.cpu().squeeze().tolist())

    # Denormalize
    y_preds_inv = scaler_y.inverse_transform(np.array(y_preds).reshape(-1, 1)).flatten()
    y_trues_inv = scaler_y.inverse_transform(np.array(y_trues).reshape(-1, 1)).flatten()

    mse = mean_squared_error(y_trues_inv, y_preds_inv)
    mae = mean_absolute_error(y_trues_inv, y_preds_inv)
    r2 = r2_score(y_trues_inv, y_preds_inv)

    print(f"📉 MSE: {mse:.2f}")
    print(f"📉 MAE: {mae:.2f}")
    print(f"📈 R² Score: {r2:.4f}")

    # Scatter plot
    plt.figure(figsize=(6, 6))
    plt.scatter(y_trues_inv, y_preds_inv, alpha=0.3)
    plt.plot(
        [y_trues_inv.min(), y_trues_inv.max()],
        [y_trues_inv.min(), y_trues_inv.max()],
        'r--'
    )
    plt.xlabel("True BMI")
    plt.ylabel("Predicted BMI")
    plt.title("True vs Predicted BMI")
    plt.grid(True)
    plt.show()



import torch
import torch.nn as nn
import torch.nn.functional as F

class ResidualBlock(nn.Module):
    def __init__(self, dim, dropout=0.3):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(dim, dim),
            nn.BatchNorm1d(dim),
            nn.LeakyReLU(),
            nn.Dropout(dropout),
            nn.Linear(dim, dim),
            nn.BatchNorm1d(dim),
        )
        self.act = nn.LeakyReLU()

    def forward(self, x):
        return self.act(self.net(x) + x)


class ExtraDeepDualInputNet(nn.Module):
    def __init__(self, n_cont, n_bin):
        super().__init__()

        ### Continuous branch (very deep + wide) ###
        self.cont_initial = nn.Sequential(
            nn.Linear(n_cont, 1024),
            nn.BatchNorm1d(1024),
            nn.LeakyReLU(),
            nn.Dropout(0.6),
        )
        self.cont_res1 = ResidualBlock(1024, dropout=0.5)
        self.cont_res2 = ResidualBlock(1024, dropout=0.5)
        self.cont_down1 = nn.Sequential(
            nn.Linear(1024, 512),
            nn.BatchNorm1d(512),
            nn.LeakyReLU(),
            nn.Dropout(0.5),
        )
        self.cont_res3 = ResidualBlock(512, dropout=0.4)
        self.cont_res4 = ResidualBlock(512, dropout=0.4)
        self.cont_down2 = nn.Sequential(
            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.LeakyReLU(),
            nn.Dropout(0.4),
        )
        self.cont_res5 = ResidualBlock(256, dropout=0.3)
        self.cont_final = nn.Sequential(
            nn.Linear(256, 128),
            nn.LeakyReLU(),
        )

        ### Binary branch (deeper embedding) ###
        self.bin_initial = nn.Sequential(
            nn.Linear(n_bin, 256),
            nn.BatchNorm1d(256),
            nn.LeakyReLU(),
            nn.Dropout(0.5),
        )
        self.bin_res1 = ResidualBlock(256, dropout=0.4)
        self.bin_res2 = ResidualBlock(256, dropout=0.4)
        self.bin_down1 = nn.Sequential(
            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.4),
        )
        self.bin_res3 = ResidualBlock(128, dropout=0.3)
        self.bin_res4 = ResidualBlock(128, dropout=0.3)
        self.bin_final = nn.Sequential(
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
            nn.Linear(64, 32),
            nn.Sigmoid(),   # compressed binary embedding
        )

        ### Joint head (larger combiner) ###
        self.head = nn.Sequential(
            nn.Linear(128 + 32, 256),
            nn.BatchNorm1d(256),
            nn.LeakyReLU(),
            nn.Dropout(0.4),

            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.3),

            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.2),

            nn.Linear(64, 1)
        )

    def forward(self, x_cont, x_bin):
        # Continuous path
        c = self.cont_initial(x_cont)
        c = self.cont_res1(c)
        c = self.cont_res2(c)
        c = self.cont_down1(c)
        c = self.cont_res3(c)
        c = self.cont_res4(c)
        c = self.cont_down2(c)
        out_c = self.cont_final(c)

        # Binary path
        b = self.bin_initial(x_bin)
        b = self.bin_res1(b)
        b = self.bin_res2(b)
        b = self.bin_down1(b)
        b = self.bin_res3(b)
        b = self.bin_res4(b)
        out_b = self.bin_final(b)

        # Merge & head
        merged = torch.cat([out_c, out_b], dim=1)
        return self.head(merged)



# 1) Instantiate your dual‐branch model
model = ExtraDeepDualInputNet(n_cont=len(cont_cols), n_bin=len(binary_cols)).to(device)
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)


# 4) Run training + plot
train_losses, train_r2s, test_r2s = train_model_dual(
    model, train_loader, test_loader,
    scaler_y, criterion, optimizer,
    epochs=5
)


plot_metrics(train_losses, train_r2s, test_r2s)


evaluate_model_dual(model, test_loader, scaler_y)



