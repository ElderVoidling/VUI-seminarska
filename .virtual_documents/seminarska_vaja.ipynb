def evaluate_model_dual(model, test_loader, scaler_y):
    model.to(device)
    model.eval()
    y_preds = []
    y_trues = []

    with torch.no_grad():
        for x_cont, x_bin, yb in test_loader:
            x_cont, x_bin, yb = x_cont.to(device), x_bin.to(device), yb.to(device)

            output = model(x_cont, x_bin)
            y_preds.extend(output.cpu().squeeze().tolist())
            y_trues.extend(yb.cpu().squeeze().tolist())

    # Denormalize
    y_preds_inv = scaler_y.inverse_transform(np.array(y_preds).reshape(-1, 1)).flatten()
    y_trues_inv = scaler_y.inverse_transform(np.array(y_trues).reshape(-1, 1)).flatten()

    mse = mean_squared_error(y_trues_inv, y_preds_inv)
    mae = mean_absolute_error(y_trues_inv, y_preds_inv)
    r2 = r2_score(y_trues_inv, y_preds_inv)

    print(f"📉 MSE: {mse:.2f}")
    print(f"📉 MAE: {mae:.2f}")
    print(f"📈 R² Score: {r2:.4f}")

    # Scatter plot
    plt.figure(figsize=(6, 6))
    plt.scatter(y_trues_inv, y_preds_inv, alpha=0.3)
    plt.plot(
        [y_trues_inv.min(), y_trues_inv.max()],
        [y_trues_inv.min(), y_trues_inv.max()],
        'r--'
    )
    plt.xlabel("True BMI")
    plt.ylabel("Predicted BMI")
    plt.title("True vs Predicted BMI")
    plt.grid(True)
    plt.show()



evaluate_model_dual(model, test_loader, scaler_y)


















