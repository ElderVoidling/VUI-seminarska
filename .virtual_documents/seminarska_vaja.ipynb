        )

        # Binary branch
        self.bin_initial = nn.Sequential(
            nn.Linear(n_bin, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.4),
        )
        self.bin_res1 = ResidualBlock(128, dropout=0.3)
        self.bin_down1 = nn.Sequential(
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
        )
        self.bin_res2 = ResidualBlock(64, dropout=0.2)
        self.bin_final = nn.Sequential(
            nn.Linear(64, 32),
            nn.Sigmoid(),
        )

        # Joint head
        self.head = nn.Sequential(
            nn.Linear(128 + 32, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.2),
            nn.Linear(64, 1),
        )

    def forward(self, x_cont, x_bin):
        # continuous path
        c = self.cont_initial(x_cont)
        c = self.cont_res1(c)
        c = self.cont_down1(c)
        c = self.cont_res2(c)
        out_c = self.cont_final(c)

        # binary path
        b = self.bin_initial(x_bin)
        b = self.bin_res1(b)
        b = self.bin_down1(b)
        b = self.bin_res2(b)
        out_b = self.bin_final(b)

        # merge & head
        merged = torch.cat([out_c, out_b], dim=1)
        return self.head(merged)



