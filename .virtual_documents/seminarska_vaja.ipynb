def simulate_stepwise(idx, model0, model1, X_scaled, a, device, k=100):
    """
    Simulates k korakov iz točke X_scaled[idx] proti centroidu a.
    Vrne: pot točk v scaled prostoru (np.array oblike (k+1, dim))
    """
    p = X_scaled[idx].copy()
    step_vec = (a - p) / k
    path_points = [p.copy()]

    print(f"\nSimulating sample idx={idx}: initial class=1")
    for i in range(1, k + 1):
        inp = torch.tensor(p, dtype=torch.float32, device=device).unsqueeze(0)
        with torch.no_grad():
            pred0 = model0(inp).item()
            pred1 = model1(inp).item()

        print(f"Step {i:3d}: pred0={pred0:.4f}, pred1={pred1:.4f}")
        print(f"         sample[0:5]={p[:5]}")
        print(f"         step_vec[0:5]={step_vec[:5]}\n")

        p += step_vec
        path_points.append(p.copy())

    return np.array(path_points)



