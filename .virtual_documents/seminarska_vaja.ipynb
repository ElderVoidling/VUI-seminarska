# === Diabetes_012 (binarna) vs. numerične X — normalnost + variance + grafe ===
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
BINS = 50
MAX_QQ_POINTS = 20000  # vzorčenje za QQ (na skupino) zaradi hitrosti
RANDOM_STATE = 42
MIN_UNIQUE_FOR_CONT = 14  # prag, da X obravnavamo kot "kontinuirno"

sns.set_theme(style="whitegrid")

# --- 1) Preberi podatke ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
# omeji Y na {0,1}
df = df[df[Y_COL].isin([0, 1])].copy()

# --- 2) Najdi numerične neodvisne (izloči binarne 0/1) ---
def is_continuous_numeric(s: pd.Series) -> bool:
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    if set(vals).issubset({0, 1}):  # izloči čiste binarne
        return False
    return len(vals) >= MIN_UNIQUE_FOR_CONT

num_cols = [c for c in df.columns if c != Y_COL and is_continuous_numeric(df[c])]
print(f"Najdene numerične X ({len(num_cols)}): {num_cols}")

# --- 3) Pomožne funkcije (za KS in QQ) ---
def sample_for_qq(x: np.ndarray, max_n=MAX_QQ_POINTS, random_state=RANDOM_STATE):
    x = x[~np.isnan(x)]
    if x.size <= max_n:
        return x
    rng = np.random.default_rng(random_state)
    idx = rng.choice(x.size, size=max_n, replace=False)
    return x[idx]

# KS (aproks.) proti N(mu_hat, sigma_hat) — po skupinah
def ks_normal_test(x: np.ndarray):
    x = x[~np.isnan(x)]
    if x.size < 2:
        return np.nan, np.nan
    mu, sigma = np.mean(x), np.std(x, ddof=1)
    if sigma <= 0 or not np.isfinite(sigma):
        return np.nan, np.nan
    d, p = stats.kstest(x, "norm", args=(mu, sigma))
    return d, p

def ks_comment(p):
    if not np.isfinite(p):
        return "ni podatkov"
    return "zavrnemo normalnost" if p < 0.05 else "≈ normalno"

def levene_comment(p):
    return f"Levene p={p:.3e} → variance: " + ("enake" if p >= 0.05 else "neenake")

# --- 4) Diagnostika po numeričnih X: samo KS + Levene + grafi ---
for x_col in num_cols:
    y0 = df.loc[df[Y_COL] == 0, x_col].to_numpy(dtype=float)
    y1 = df.loc[df[Y_COL] == 1, x_col].to_numpy(dtype=float)

    # Levene (center='mean')
    lev_stat, lev_p = stats.levene(y0, y1, center="mean", nan_policy="omit")

    # KS po skupinah (approx)
    ks0_D, ks0_p = ks_normal_test(y0)
    ks1_D, ks1_p = ks_normal_test(y1)

    # Zgoščeni izpis: samo normalnost in variance
    print(f"\n=== {x_col} (num) → {Y_COL} ===")
    print(
        f"KS (approx) Y=0: D={ks0_D:.3f}, p={ks0_p:.3e} → {ks_comment(ks0_p)}"
    )
    print(
        f"KS (approx) Y=1: D={ks1_D:.3f}, p={ks1_p:.3e} → {ks_comment(ks1_p)}"
    )
    print(levene_comment(lev_p))

    # FIG: ena vrstica z 4 grafi
    fig, axes = plt.subplots(1, 4, figsize=(14, 3.2))

    # 1) Histogram (prekrivno po Y)
    axes[0].hist(
        y0, bins=BINS, alpha=0.6, density=True, label="Y=0", color="tab:blue"
    )
    axes[0].hist(
        y1, bins=BINS, alpha=0.6, density=True, label="Y=1", color="tab:orange"
    )
    axes[0].set_title("Hist (Y=0 vs Y=1)", fontsize=10)
    axes[0].set_xlabel(x_col, fontsize=9)
    axes[0].set_ylabel("Gostota", fontsize=9)
    axes[0].legend(fontsize=8)

    # 2) Boxplot (po Y)
    axes[1].boxplot([y0, y1], labels=["Y=0", "Y=1"], showfliers=True, widths=0.6)
    axes[1].set_title("Boxplot", fontsize=10)
    axes[1].set_xlabel(Y_COL, fontsize=9)
    axes[1].set_ylabel(x_col, fontsize=9)

    # 3) QQ (Y=0)
    y0_qq = sample_for_qq(y0)
    stats.probplot(y0_qq, dist="norm", plot=axes[2])
    axes[2].set_title("QQ (Y=0)", fontsize=10)

    # 4) QQ (Y=1)
    y1_qq = sample_for_qq(y1)
    stats.probplot(y1_qq, dist="norm", plot=axes[3])
    axes[3].set_title("QQ (Y=1)", fontsize=10)

    fig.suptitle(f"{x_col} vs {Y_COL}", fontsize=11)
    fig.tight_layout(rect=[0, 0, 1, 0.92])
    plt.show()

print("\n✅ Končano: samo KS (normalnost) + Levene (variance) + histogram/box/QQ.")





# === Diabetes_012 (binarna) vs. numerične X — Mann–Whitney U (brez AUC/RBC/FDR) ===
import numpy as np
import pandas as pd
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
ALPHA = 0.05
MIN_UNIQUE_FOR_CONT = 14  # prag, da X obravnavamo kot "kontinuirno"
expanded_report = False  # True -> dodaj povprečja, SD, IQR

# --- 1) Podatki ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
df = df[df[Y_COL].isin([0, 1])].copy()

# --- 2) Izbor numeričnih X (izloči čiste 0/1) ---
def is_continuous_numeric(s: pd.Series) -> bool:
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    if set(vals).issubset({0, 1}):
        return False
    return len(vals) >= MIN_UNIQUE_FOR_CONT

num_cols = [c for c in df.columns if c != Y_COL and is_continuous_numeric(df[c])]
print(f"Najdene numerične X ({len(num_cols)}): {num_cols}")

def iqr(arr: np.ndarray) -> float:
    arr = arr[~np.isnan(arr)]
    if arr.size == 0:
        return np.nan
    q1, q3 = np.percentile(arr, [25, 75])
    return float(q3 - q1)

# --- 3) Mann–Whitney U po vseh numeričnih X ---
rows = []
for x_col in num_cols:
    x0 = df.loc[df[Y_COL] == 0, x_col].astype(float).to_numpy()
    x1 = df.loc[df[Y_COL] == 1, x_col].astype(float).to_numpy()

    x0 = x0[~np.isnan(x0)]
    x1 = x1[~np.isnan(x1)]
    n0, n1 = x0.size, x1.size

    if n0 == 0 or n1 == 0:
        u_stat, p_val = np.nan, np.nan
        med0, med1, diff_med = np.nan, np.nan, np.nan
        smer_str = "ni podatkov"
        sklep = "ni podatkov"
    else:
        # Test (two-sided); method='auto' izbere exact/asimptotični glede na podatke
        u_stat, p_val = stats.mannwhitneyu(
            x1, x0, alternative="two-sided", method="auto"
        )
        med0 = float(np.nanmedian(x0))
        med1 = float(np.nanmedian(x1))
        diff_med = med1 - med0
        smer_str = (
            f"{x_col} je višji pri Y=1"
            if diff_med > 0
            else f"{x_col} je nižji pri Y=1"
            if diff_med < 0
            else "mediani sta enaki"
        )
        sklep = (
            "statistično značilna razlika" if p_val < ALPHA else "ni značilne razlike"
        )

    row = {
        "spremenljivka": x_col,
        "test": "Mann–Whitney U",
        "U_stat": float(u_stat) if np.isfinite(u_stat) else np.nan,
        "p_value": float(p_val) if np.isfinite(p_val) else np.nan,
        "n0": int(n0),
        "n1": int(n1),
        "Sklep": sklep,
        "Smer": smer_str,
    }

    if expanded_report:
        mean0 = float(np.nanmean(x0)) if n0 > 0 else np.nan
        mean1 = float(np.nanmean(x1)) if n1 > 0 else np.nan
        sd0 = float(np.nanstd(x0, ddof=1)) if n0 > 1 else np.nan
        sd1 = float(np.nanstd(x1, ddof=1)) if n1 > 1 else np.nan
        row.update(
            dict(
                median_0=med0,
                median_1=med1,
                diff_median_10=diff_med,
                mean_0=mean0,
                mean_1=mean1,
                sd_0=sd0,
                sd_1=sd1,
                iqr_0=iqr(x0),
                iqr_1=iqr(x1),
            )
        )

    rows.append(row)

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

# Nastavitve Pandasa za poln izpis
pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)

display(results)








# === Diabetes_012 (binarna) vs. ordinalne/kategorične X — χ², trend, grafi ===
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
ALPHA = 0.05
CONF_LEVEL = 0.95

# izberi X z max toliko kategorij (ignoriraj "high-cardinality")
MAX_CATS = 13
# privzeto: numerične kategorije obravnavaj kot ordinalne (naraščajoči red)
ASSUME_NUMERIC_IS_ORDINAL = True

# opcijsko: ročni vrstni red za posamezne X (če želiš drugačen od default)
# primer: ORDER_MAP = {"OrdinalFeature": [1, 2, 3, 4, 5]}
ORDER_MAP: dict[str, list] = {}

# grafi
SHOW_PROP_CI = True
SHOW_RESID_HEATMAP = True

sns.set_theme(style="whitegrid")

# --- 1) Podatki ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
df = df[df[Y_COL].isin([0, 1])].copy()

# --- 2) Izbor kategoričnih/ordinalnih X (izločimo binarne 0/1) ---
def is_categorical_candidate(s: pd.Series) -> bool:
    # štejemo kot kandidat, če je object/category ali numeric z malo različnimi vrednostmi
    if pd.api.types.is_categorical_dtype(s) or pd.api.types.is_object_dtype(s):
        return s.dropna().nunique() >= 2 and s.dropna().nunique() <= MAX_CATS
    if pd.api.types.is_numeric_dtype(s):
        vals = pd.unique(s.dropna())
        if set(vals).issubset({0, 1}):  # binarne X damo drugam, ne sem
            return False
        return 2 <= len(vals) <= MAX_CATS
    return False

cat_cols = [c for c in df.columns if c != Y_COL and is_categorical_candidate(df[c])]
print(f"Najdene kategorične/ordinalne X ({len(cat_cols)}): {cat_cols}")

# --- 3) Pomožne funkcije ---
def wilson_ci(k: int, n: int, conf: float = CONF_LEVEL):
    if n == 0:
        return (np.nan, np.nan)
    z = stats.norm.ppf(1 - (1 - conf) / 2)
    p = k / n
    den = 1 + (z**2) / n
    center = (p + (z**2) / (2 * n)) / den
    half = (z * np.sqrt(p * (1 - p) / n + (z**2) / (4 * n**2))) / den
    return float(center - half), float(center + half)

def cramers_v(chi2: float, n: int, r: int, c: int):
    if n == 0:
        return np.nan
    phi2 = chi2 / n
    k = min(r - 1, c - 1)
    if k <= 0:
        return np.nan
    return float(np.sqrt(phi2 / k))

def is_ordinal_column(s: pd.Series, name: str):
    # če je v ORDER_MAP, je ordinalen; sicer numeric in ASSUME_NUMERIC_IS_ORDINAL
    if name in ORDER_MAP:
        return True
    if pd.api.types.is_numeric_dtype(s) and ASSUME_NUMERIC_IS_ORDINAL:
        return True
    return False

def get_order(s: pd.Series, name: str):
    if name in ORDER_MAP:
        return ORDER_MAP[name]
    vals = list(pd.unique(s.dropna()))
    if pd.api.types.is_numeric_dtype(s):
        return sorted(vals)
    # za nenumerične, uporabi pogostost ali abecedni red; tu abecedni
    return sorted(vals, key=lambda x: str(x))

def cochran_armitage_2xk(y: pd.Series, x: pd.Series, scores=None):
    """
    Cochran–Armitage trend test (2×k): test linearnega trenda deleža Y=1 čez
    urejene kategorije X. Vrne (Z, p_two_sided).
    Implementacija s privzetimi skori 0..k-1 (ali danimi 'scores').
    """
    m = pd.DataFrame({"y": y, "x": x}).dropna()
    if m.empty:
        return (np.nan, np.nan)
    # urejenost kategorij
    cats = get_order(m["x"], x.name if hasattr(x, "name") else "x")
    m["x"] = pd.Categorical(m["x"], categories=cats, ordered=True)
    tab = pd.crosstab(m["y"], m["x"]).reindex(index=[0, 1], columns=cats, fill_value=0)
    y1 = tab.loc[1].values.astype(float)
    nj = tab.sum(axis=0).values.astype(float)
    N = tab.values.sum()
    m_tot = y1.sum()
    if N <= 0 or m_tot in (0, N):
        return (np.nan, np.nan)  # brez variacije v Y
    if scores is None:
        scores = np.arange(len(cats), dtype=float)
    else:
        scores = np.asarray(scores, dtype=float)
        if scores.shape[0] != len(cats):
            raise ValueError("Dolžina 'scores' se ne ujema s št. kategorij.")
    p_hat = m_tot / N
    xbar_w = np.sum(nj * scores) / N
    # statistika T in var(T) po modelu Bin(nj, p_hat)
    T = np.sum(scores * (y1 - nj * p_hat))
    varT = p_hat * (1 - p_hat) * np.sum(nj * (scores - xbar_w) ** 2)
    if varT <= 0:
        return (np.nan, np.nan)
    Z = T / np.sqrt(varT)
    p_two = 2 * (1 - stats.norm.cdf(abs(Z)))
    return (float(Z), float(p_two))

def plot_proportion_with_ci(ct: pd.DataFrame, title: str, ordinal: bool):
    # ct: 2×k (vrstice Y: 0,1; stolpci: kategorije X v pravem redu)
    cats = list(ct.columns)
    k = len(cats)
    n = ct.sum(axis=0).values
    y1 = ct.loc[1].values
    p = y1 / n
    ci = [wilson_ci(int(y1[i]), int(n[i])) for i in range(k)]
    lo = np.array([c[0] for c in ci])
    hi = np.array([c[1] for c in ci])

    fig, ax = plt.subplots(figsize=(max(4.8, 0.9 * k), 3.6))
    x = np.arange(k)
    ax.errorbar(
        x,
        p,
        yerr=[p - lo, hi - p],
        fmt="o-",
        capsize=4,
        color="tab:blue",
        ecolor="gray",
        lw=1,
        ms=5,
    )
    ax.set_xticks(x)
    ax.set_xticklabels(cats, rotation=0)
    ax.set_ylim(0, 1)
    ax.set_ylabel("P(Y=1)")
    ax.set_title(title + (" (ordinalni trend)" if ordinal else ""))
    ax.grid(axis="y", alpha=0.2)
    plt.tight_layout()
    plt.show()

def plot_residual_heatmap(ct: pd.DataFrame, exp: np.ndarray, title: str):
    resid = (ct.values - exp) / np.sqrt(exp)
    fig, ax = plt.subplots(figsize=(max(4.5, 0.6 * ct.shape[1]), 3.6))
    sns.heatmap(
        resid,
        annot=True,
        fmt=".2f",
        cmap="coolwarm",
        center=0,
        cbar=True,
        xticklabels=ct.columns,
        yticklabels=ct.index,
        linewidths=0.5,
        linecolor="white",
        ax=ax,
    )
    ax.set_title(title + " – std. residuali")
    ax.set_xlabel("X kategorije")
    ax.set_ylabel(f"{Y_COL} (0/1)")
    plt.tight_layout()
    plt.show()

# --- 4) Glavna zanka: testi + grafi ---
rows = []
for x_col in cat_cols:
    x = df[x_col]
    ordinal = is_ordinal_column(x, x_col)
    cats = get_order(x, x_col) if ordinal else get_order(x, x_col)
    # 2×k tabela (Y v vrsticah 0/1, X kategorije v stolpcih)
    ct = (
        pd.crosstab(df[Y_COL], pd.Categorical(x, categories=cats, ordered=ordinal))
        .reindex(index=[0, 1], columns=cats, fill_value=0)
    )

    # Pearson χ² (brez Yates; veliko n)
    chi2, p_chi, dof, exp = stats.chi2_contingency(ct.values, correction=False)
    V = cramers_v(chi2, int(ct.values.sum()), ct.shape[0], ct.shape[1])

    # Cochran–Armitage trend (samo če je ordinal in k>=3)
    if ordinal and ct.shape[1] >= 3:
        Z_ca, p_ca = cochran_armitage_2xk(df[Y_COL], x)
    else:
        Z_ca, p_ca = (np.nan, np.nan)

    # Izpis
    print(f"\n=== {x_col} (k={ct.shape[1]}) vs {Y_COL} ===")
    print(ct)
    print(f"χ²(df={dof}) = {chi2:.3f}, p = {p_chi:.3e} | Cramér V = {V:.3f}")
    if np.isfinite(p_ca):
        print(f"Cochran–Armitage trend: Z = {Z_ca:.3f}, p = {p_ca:.3e}")

    # Grafi
    if SHOW_PROP_CI:
        plot_proportion_with_ci(
            ct,
            title=f"P(Y=1) po kategorijah: {x_col}",
            ordinal=ordinal,
        )
    if SHOW_RESID_HEATMAP:
        plot_residual_heatmap(ct, exp, title=f"{x_col} vs {Y_COL}")

    # Povzetek
    rows.append(
        dict(
            feature=x_col,
            k=ct.shape[1],
            chi2=chi2,
            df=dof,
            p_chi=p_chi,
            cramer_V=V,
            CA_Z=Z_ca,
            CA_p=p_ca,
        )
    )

# Pregledna tabela
res = pd.DataFrame(rows).sort_values("p_chi").reset_index(drop=True)
print("\nTop rezultati (po χ² p):")
display(res.head(10))





