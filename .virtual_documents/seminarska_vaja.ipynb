import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA
import matplotlib.pyplot as plt

# 1) Naloži in standardiziraj
df = pd.read_csv("diabetes_01_filtered.csv")
X = df.drop(columns=['Diabetes_012']).values
y = df['Diabetes_012'].values
Xs = StandardScaler().fit_transform(X)

# 2) LDA za prvo os
lda = LDA(n_components=1)
X_lda1 = lda.fit_transform(Xs, y).ravel()  # 1D array

# 3) Izračun smeri LDA in residuali
w = lda.coef_[0]                         # surova smer
u = w / np.linalg.norm(w)               # normalizirana
R = Xs - np.outer(Xs.dot(u), u)         # residuali: odstranjena LDA-projekcija

# 4) PCA na residualih za drugo os
pca = PCA(n_components=1)
X_res2 = pca.fit_transform(R).ravel()

# 5) Scatter plot v 2D
plt.figure(figsize=(6,6))
plt.scatter(X_lda1, X_res2, c=y, cmap='coolwarm', s=0.01, alpha=0.9)
plt.axvline(0, color='grey', linestyle='--', linewidth=1)
plt.axhline(0, color='grey', linestyle='--', linewidth=1)
plt.xlabel('LDA Component (diabetes score)')
plt.ylabel('PCA on LDA-residuals')
plt.title('2D: LDA os + pravokotna PCA os')
plt.show()






import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA
import matplotlib.pyplot as plt

# 1) Naloži podatke
df = pd.read_csv("diabetes_01_filtered.csv")
X = df.drop(columns=['Diabetes_012']).values
y = df['Diabetes_012'].values

# 2) Standardiziraj
scaler   = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3a) PCA za 2D vizualizacijo (originalni prostor)
pca2     = PCA(n_components=2)
X_pca    = pca2.fit_transform(X_scaled)

# 3b) LDA + residuali
lda      = LDA(n_components=1)
X_lda1   = lda.fit_transform(X_scaled, y).ravel()
w        = lda.coef_[0]
u        = w / np.linalg.norm(w)                   # LDA-os
R        = X_scaled - np.outer(X_lda1, u)          # residuali
pca_res  = PCA(n_components=1)
X_res2   = pca_res.fit_transform(R).ravel()
v        = pca_res.components_[0]                  # residualna os

# 4) Izračun centroidov in median
mean0   = X_scaled[y==0].mean(axis=0)
mean1   = X_scaled[y==1].mean(axis=0)
med0    = np.median(X_scaled[y==0], axis=0)
med1    = np.median(X_scaled[y==1], axis=0)

# 5a) Projekcija centroidov/median v PCA prostor
mean0_pca = pca2.transform(mean0.reshape(1,-1)).ravel()
mean1_pca = pca2.transform(mean1.reshape(1,-1)).ravel()
med0_pca  = pca2.transform(med0.reshape(1,-1)).ravel()
med1_pca  = pca2.transform(med1.reshape(1,-1)).ravel()

# 5b) Projekcija centroidov/median na LDA+residualni prostor
s1_mean0   = mean0.dot(u)
s1_mean1   = mean1.dot(u)
s1_med0    = med0.dot(u)
s1_med1    = med1.dot(u)
s2_mean0   = (mean0 - s1_mean0*u).dot(v)
s2_mean1   = (mean1 - s1_mean1*u).dot(v)
s2_med0    = (med0  - s1_med0 *u).dot(v)
s2_med1    = (med1  - s1_med1 *u).dot(v)

# 6a) Plot: PCA + Centroidi/Mediane
plt.figure(figsize=(6,6))
plt.scatter(X_pca[:,0], X_pca[:,1], c=y, cmap='coolwarm', s=10, alpha=0.6, label='_nolegend_')
plt.scatter(*mean0_pca, marker='X', s=200, color='blue',   edgecolor='k', label='Mean (Class 0)')
plt.scatter(*mean1_pca, marker='X', s=200, color='red',    edgecolor='k', label='Mean (Class 1)')
plt.scatter(*med0_pca,  marker='D', s=120, color='cyan',   edgecolor='k', label='Median (Class 0)')
plt.scatter(*med1_pca,  marker='D', s=120, color='magenta',edgecolor='k', label='Median (Class 1)')
plt.xlabel('PC1'); plt.ylabel('PC2')
plt.title('PCA projekcija z centroidi in medianami')
plt.legend(); plt.grid(True)
plt.show()

# 6b) Plot: LDA-os + pravokotna PCA-residualna os
plt.figure(figsize=(6,6))
plt.scatter(X_lda1, X_res2, c=y, cmap='coolwarm', s=10, alpha=0.6, label='_nolegend_')
plt.scatter(s1_mean0, s2_mean0, marker='X', s=200, color='blue',   edgecolor='k', label='Mean (Class 0)')
plt.scatter(s1_mean1, s2_mean1, marker='X', s=200, color='red',    edgecolor='k', label='Mean (Class 1)')
plt.scatter(s1_med0,  s2_med0,  marker='D', s=120, color='cyan',   edgecolor='k', label='Median (Class 0)')
plt.scatter(s1_med1,  s2_med1,  marker='D', s=120, color='magenta',edgecolor='k', label='Median (Class 1)')
plt.axvline(0, color='grey', linestyle='--'); plt.axhline(0, color='grey', linestyle='--')
plt.xlabel('LDA Component (diabetes score)')
plt.ylabel('PCA on LDA-residuals')
plt.title('2D: LDA-os + pravokotna PCA os')
plt.legend(); plt.grid(True)
plt.show()



import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt

# 1) Naloži podatke
df = pd.read_csv("diabetes_01_filtered.csv")
X = df.drop(columns=['Diabetes_012']).values
y = df['Diabetes_012'].values

# 2) Standardiziraj
scaler   = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3) PCA v 2D
pca      = PCA(n_components=2)
X_pca    = pca.fit_transform(X_scaled)

# 4) Izračun centroidov (mean) na standardiziranih podatkih
mean0    = X_scaled[y == 0].mean(axis=0)
mean1    = X_scaled[y == 1].mean(axis=0)

# 5) Projekcija centroidov v PCA-koordinate
mean0_pca = pca.transform(mean0.reshape(1, -1)).ravel()
mean1_pca = pca.transform(mean1.reshape(1, -1)).ravel()

# 6) Scatter plot s centroidi
plt.figure(figsize=(6,6))
plt.scatter(
    X_pca[:,0], X_pca[:,1],
    c=y, cmap='coolwarm', alpha=0.6, s=10,
    label='_nolegend_'
)
plt.scatter(
    *mean0_pca, marker='X', s=200,
    color='blue', edgecolor='k', label='Mean (Class 0)'
)
plt.scatter(
    *mean1_pca, marker='X', s=200,
    color='red',  edgecolor='k', label='Mean (Class 1)'
)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA projekcija z označenima centroidoma')
plt.legend()
plt.grid(True)
plt.show()




# 4) Vektor med centroidoma v PCA prostoru
d = mean1_pca - mean0_pca
axis_x = d / np.linalg.norm(d)                # enotski vektor za novo x-os
axis_y = np.array([-axis_x[1], axis_x[0]])    # pravokotni vektor za novo y-os

# 5) Projekcija vseh točk na novi koordinatni sistem
#    [axis_x, axis_y] oblikuje transformacijsko matriko
T = np.vstack([axis_x, axis_y]).T             # 2×2
X_rot = X_pca.dot(T)                          # projecirano v novo bazo

# 6) Projecija centroidov in scatter plot
mean0_rot = mean0_pca.dot(T)
mean1_rot = mean1_pca.dot(T)

plt.figure(figsize=(6,6))
plt.scatter(X_rot[:,0], X_rot[:,1], c=y, cmap='coolwarm', s=10, alpha=0.6, label='_nolegend_')
plt.scatter(mean0_rot[0], mean0_rot[1], marker='X', s=200, color='blue',  edgecolor='k', label='Mean (Class 0)')
plt.scatter(mean1_rot[0], mean1_rot[1], marker='X', s=200, color='red',   edgecolor='k', label='Mean (Class 1)')
plt.axhline(0, color='grey', linestyle='--')
plt.axvline(0, color='grey', linestyle='--')
plt.xlabel('New PC axis ∥ (mean1 – mean0)')
plt.ylabel('Orthogonal axis')
plt.title('PCA-projekcija z vodoravno osjo ∥ razliki centroidov')
plt.legend()
plt.grid(True)
plt.show()



def f(p, c_n, c_d):
    # p, c_n, c_d are 2-vectors
    num = np.linalg.norm(c_n - p)
    den = np.linalg.norm(c_n - c_d)
    return (num/den) * np.dot(c_n - p, c_d - p)






import numpy as np
import matplotlib.pyplot as plt

# --- 1) Definiraj osi iz mean0_pca, mean1_pca ---
d      = mean1_pca - mean0_pca
axis_x = d / np.linalg.norm(d)                # enotski vektor za novo x-os
axis_y = np.array([-axis_x[1], axis_x[0]])    # pravokotni vektor za novo y-os

# --- 2) Funkcija f_grid_pca z novo formulo k * s ---
def f_grid_pca(X, Y, c_n, c_d):
    P       = np.stack([X, Y], axis=-1)      # (H,W,2)
    diff_pa = P - c_n                        # (pažljivo vrstni red: p - a)
    diff_ba = c_d - c_n
    norm_pa = np.linalg.norm(diff_pa, axis=-1)
    norm_ba = np.linalg.norm(diff_ba)
    # k = ||p - a|| / ||b - a||
    k = norm_pa / norm_ba
    # s = ((b - a)/||b - a||) · ((p - a)/||p - a||)
    u_ba    = diff_ba / norm_ba
    u_pa    = diff_pa / norm_pa[..., None]
    s       = np.sum(u_ba * u_pa, axis=-1)
    return k * s

# --- 3) Grid v rotiranem (u,v) prostoru ---
margin = 5
u_min, u_max = X_rot[:,0].min() - margin, X_rot[:,0].max() + margin
v_min, v_max = X_rot[:,1].min() - margin, X_rot[:,1].max() + margin
U = np.linspace(u_min, u_max, 300)
V = np.linspace(v_min, v_max, 300)
UU, VV = np.meshgrid(U, V)

# --- 4) Pretvori (UU,VV) nazaj v PCA-koordinate ---
P_pca_X = UU * axis_x[0] + VV * axis_y[0]
P_pca_Y = UU * axis_x[1] + VV * axis_y[1]

# --- 5) Izračun Z in centrirana barvna lestvica ---
Z = f_grid_pca(P_pca_X, P_pca_Y, mean0_pca, mean1_pca)
abs_max = np.max(np.abs(Z))

# --- 6) Risanje ---
plt.figure(figsize=(7,6))
plt.contourf(UU, VV, Z, levels=50, cmap='coolwarm', vmin=-abs_max, vmax=abs_max)
plt.colorbar(label='f-value (k·s)')

# Scatter prej rotiranih točk in centroidov
plt.scatter(X_rot[:,0], X_rot[:,1], c=y, cmap='coolwarm', s=8, alpha=0.5)
plt.scatter(mean0_rot[0], mean0_rot[1], marker='X', s=150, color='blue',  label='Mean (Class 0)')
plt.scatter(mean1_rot[0], mean1_rot[1], marker='X', s=150, color='red',   label='Mean (Class 1)')

plt.axhline(0, color='grey', linestyle='--')
plt.axvline(0, color='grey', linestyle='--')
plt.xlim(u_min, u_max); plt.ylim(v_min, v_max)
plt.xlabel('Rotated axis ∥ (mean1 – mean0)')
plt.ylabel('Rotated orthogonal axis')
plt.title('Heatmap of $f(p)=k·s$ in rotated PCA space')
plt.legend(); plt.grid(True)
plt.show()






import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler

# 1) Naloži podatke
df = pd.read_csv("diabetes_01_filtered.csv")
X = df.drop(columns=['Diabetes_012']).values
y = df['Diabetes_012'].values

# 2) Standardiziraj
scaler   = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3) Izračun centroidov v standardiziranem prostoru
a = X_scaled[y == 0].mean(axis=0)   # a = cent_nedi
b = X_scaled[y == 1].mean(axis=0)   # b = cent_di

# 4) Definicija nove funkcije f(p) = k * s
#    k = ||p - a|| / ||b - a||
#    s = ((b - a)/||b - a||) · ((p - a)/||p - a||)
def f(p, a, b):
    diff_pa = p - a
    diff_ba = b - a
    norm_pa = np.linalg.norm(diff_pa)
    norm_ba = np.linalg.norm(diff_ba)
    k = norm_pa / norm_ba
    s = np.dot(diff_ba / norm_ba, diff_pa / norm_pa)
    return k * s

# 5) Izračun nove značilke za vsak vzorec
new_numeric_diabetic_feature = np.array([
    f(p, a, b) for p in X_scaled
])

# 6) Osnovne statistike
stats = {
    'min':    new_numeric_diabetic_feature.min(),
    '25%':    np.percentile(new_numeric_diabetic_feature, 25),
