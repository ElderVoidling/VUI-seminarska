# === 2×2: Diabetes_012 (binarna) vs. binarne X — χ² + učinki + grafi ===
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1), ime naj te ne moti
CONF_LEVEL = 0.95
ALPHA = 0.05

SHOW_COUNTS_HEATMAP = True
SHOW_RESID_HEATMAP = True
SHOW_FOREST_OR = False
FOREST_MAX = 30  # največ featurjev na forest grafu (za preglednost)
FOREST_SORT_BY = "p_FDR"  # "p_FDR" (če na voljo) ali "p"

sns.set_theme(style="whitegrid")

# Preberi podatke
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"

# Omeji na {0,1} in odstrani NaN
before_n = len(df)
df = df[df[Y_COL].isin([0, 1])].copy()
removed = before_n - len(df)
if removed > 0:
    print(f"Opozorilo: odstranjenih {removed} vrstic (Y ni bil 0/1).")

# Helper: ali je stolpec binaren (⊆{0,1})
def is_binary_series(s: pd.Series) -> bool:
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    return set(vals).issubset({0, 1})

# Izberi binarne X (razen Y)
binary_cols = [c for c in df.columns if c != Y_COL and is_binary_series(df[c])]
print(f"Najdene binarne X ({len(binary_cols)}): {binary_cols}")

# Wilson CI za delež
def wilson_ci(k: int, n: int, conf: float = CONF_LEVEL):
    if n == 0:
        return (np.nan, np.nan)
    z = stats.norm.ppf(1 - (1 - conf) / 2)
    p = k / n
    den = 1 + (z**2) / n
    center = (p + (z**2) / (2 * n)) / den
    half = (z * np.sqrt(p * (1 - p) / n + (z**2) / (4 * n**2))) / den
    return (center - half, center + half)

# Efektne mere iz 2×2 tabele
def effect_sizes_from_ct(ct: pd.DataFrame, conf: float = CONF_LEVEL):
    # Tabela z vrsticami Y (0,1) in stolpci X (0,1)
    a = float(ct.loc[1, 1])  # Y=1, X=1
    b = float(ct.loc[0, 1])  # Y=0, X=1
    c = float(ct.loc[1, 0])  # Y=1, X=0
    d = float(ct.loc[0, 0])  # Y=0, X=0

    n = a + b + c + d
    n1 = a + b  # X=1 total
    n0 = c + d  # X=0 total
    m1 = a + c  # Y=1 total
    m0 = b + d  # Y=0 total

    # Phi (s predznakom)
    denom = np.sqrt(n1 * n0 * m1 * m0)
    phi = (a * d - b * c) / denom if denom > 0 else np.nan

    # Deleži
    p1 = a / n1 if n1 > 0 else np.nan  # P(Y=1 | X=1)
    p0 = c / n0 if n0 > 0 else np.nan  # P(Y=1 | X=0)

    # RD in Newcombe CI (Wilson za p1 in p0)
    p1_L, p1_U = wilson_ci(int(a), int(n1))
    p0_L, p0_U = wilson_ci(int(c), int(n0))
    rd = p1 - p0 if np.isfinite(p1) and np.isfinite(p0) else np.nan
    rd_L = (p1_L - p0_U) if np.all(np.isfinite([p1_L, p0_U])) else np.nan
    rd_U = (p1_U - p0_L) if np.all(np.isfinite([p1_U, p0_L])) else np.nan

    # RR in CI (log metoda, Haldane–Anscombe za ničelne celice)
    use_ha = any(v == 0 for v in [a, b, c, d])
    if use_ha:
        a_, b_, c_, d_ = a + 0.5, b + 0.5, c + 0.5, d + 0.5
    else:
        a_, b_, c_, d_ = a, b, c, d
    p1_ = a_ / (a_ + b_)
    p0_ = c_ / (c_ + d_)
    rr = p1_ / p0_ if p0_ > 0 else np.inf
    if np.isfinite(rr) and p1_ > 0 and p0_ > 0:
        se_log_rr = np.sqrt(1 / a_ - 1 / (a_ + b_) + 1 / c_ - 1 / (c_ + d_))
        z = stats.norm.ppf(1 - (1 - CONF_LEVEL) / 2)
        rr_L = np.exp(np.log(rr) - z * se_log_rr)
        rr_U = np.exp(np.log(rr) + z * se_log_rr)
    else:
        rr_L, rr_U = np.nan, np.nan

    # OR in CI (log metoda, Haldane–Anscombe za ničelne celice)
    orv = (a_ * d_) / (b_ * c_) if (b_ * c_) > 0 else np.inf
    if np.isfinite(orv):
        se_log_or = np.sqrt(1 / a_ + 1 / b_ + 1 / c_ + 1 / d_)
        z = stats.norm.ppf(1 - (1 - CONF_LEVEL) / 2)
        or_L = np.exp(np.log(orv) - z * se_log_or)
        or_U = np.exp(np.log(orv) + z * se_log_or)
    else:
        or_L, or_U = np.nan, np.nan

    return dict(
        n=int(n),
        phi=phi,
        p1=p1,
        p0=p0,
        rd=rd,
        rd_L=rd_L,
        rd_U=rd_U,
        rr=rr,
        rr_L=rr_L,
        rr_U=rr_U,
        orv=orv,
        or_L=or_L,
        or_U=or_U,
        had_zeros=use_ha,
    )

# Vizualizacija: counts heatmap (obs + exp) in residuals
def plot_2x2(ct: pd.DataFrame, exp: np.ndarray, title_prefix: str):
    if SHOW_COUNTS_HEATMAP:
        fig, ax = plt.subplots(figsize=(4.4, 3.6))
        ann = np.empty_like(exp, dtype=object)
        for i in range(ct.shape[0]):
            for j in range(ct.shape[1]):
                ann[i, j] = f"{int(ct.iloc[i, j])}\n({exp[i, j]:.1f})"
        sns.heatmap(
            ct,
            annot=ann,
            fmt="",
            cmap="Blues",
            cbar=False,
            linewidths=0.5,
            linecolor="white",
            ax=ax,
        )
        ax.set_title(f"{title_prefix} – št. (prič.)")
        ax.set_xlabel("X (0/1)")
        ax.set_ylabel(f"{Y_COL} (0/1)")
        plt.tight_layout()
        plt.show()

    if SHOW_RESID_HEATMAP:
        resid = (ct.values - exp) / np.sqrt(exp)
        fig, ax = plt.subplots(figsize=(4.4, 3.6))
        sns.heatmap(
            resid,
            annot=True,
            fmt=".2f",
            cmap="coolwarm",
            center=0,
            cbar=True,
            xticklabels=ct.columns,
            yticklabels=ct.index,
            linewidths=0.5,
            linecolor="white",
            ax=ax,
        )
        ax.set_title(f"{title_prefix} – std. residuali")
        ax.set_xlabel("X (0/1)")
        ax.set_ylabel(f"{Y_COL} (0/1)")
        plt.tight_layout()
        plt.show()

# Glavna zanka: χ² test + izpisi in grafi
rows = []
for x_col in binary_cols:
    # 2×2 tabela (vrstice Y: 0,1; stolpci X: 0,1)
    ct = (
        pd.crosstab(df[Y_COL], df[x_col])
        .reindex(index=[0, 1], columns=[0, 1], fill_value=0)
    )

    # Pearson χ² (brez Yates, ker veliko n)
    chi2, p, dof, exp = stats.chi2_contingency(ct.values, correction=False)

    # Efektne mere
    eff = effect_sizes_from_ct(ct)

    # Zgoščeni izpis
    print(f"\n=== {x_col} (2×2) vs {Y_COL} ===")
    print(ct)
    print(
        f"χ²(1)={chi2:.3f}, p={p:.3e} | phi={eff['phi']:.3f} "
        f"(Cramér's V za 2×2)"
    )
    # print(
    #     f"RD = {eff['rd']*100:.2f} pp  "
    #     f"[{eff['rd_L']*100:.2f}, {eff['rd_U']*100:.2f}]"
    # )
    # print(f"RR = {eff['rr']:.3f}  [{eff['rr_L']:.3f}, {eff['rr_U']:.3f}]")
    or_note = " (HA 0.5)" if eff["had_zeros"] else ""
    print(
        f"OR = {eff['orv']:.3f}  "
        f"[{eff['or_L']:.3f}, {eff['or_U']:.3f}]{or_note}"
    )

    # Grafi
    plot_2x2(ct, exp, title_prefix=f"{x_col} vs {Y_COL}")

    # Za agregatni povzetek
    rows.append(
        dict(
            feature=x_col,
            n=eff["n"],
            chi2=chi2,
            p=p,
            phi=eff["phi"],
            # RD=eff["rd"],
            # RD_L=eff["rd_L"],
            # RD_U=eff["rd_U"],
            # RR=eff["rr"],
            # RR_L=eff["rr_L"],
            # RR_U=eff["rr_U"],
            OR=eff["orv"],
            OR_L=eff["or_L"],
            OR_U=eff["or_U"],
            # had_zero_cell=eff["had_zeros"],
        )
    )

# Povzetek v DataFrame + (opcijsko) FDR korekcija
res = pd.DataFrame(rows).sort_values("p").reset_index(drop=True)
try:
    from statsmodels.stats.multitest import multipletests

