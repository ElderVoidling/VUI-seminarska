# Klasične metrike
precision = tp / (tp + fp) if (tp + fp) > 0 else 0
recall = tp / (tp + fn) if (tp + fn) > 0 else 0  # = sensitivity/TPR
f1_score = (
    2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0
)

print(f"\nPreciznost (Precision): {precision:.4f}")
print(f"Priziv (Recall / Sensitivity): {recall:.4f}")
print(f"F1-Score: {f1_score:.4f}")

# --- DODANO: AUC, Sensitivity, Specificity (skupaj) ---
# AUC (ROC) potrebuje verjetnosti
y_test_proba_final = model.predict_proba(X_test_scaled)[:, 1]
auc_roc = roc_auc_score(y_test, y_test_proba_final)

sensitivity = recall  # že izračunano zgoraj
specificity = tn / (tn + fp) if (tn + fp) > 0 else 0  # TNR


print("\n--- Dodatne metrike (Test) ---")
print(f"ROC AUC: {auc_roc:.4f}")
print(f"Sensitivity (Recall/TPR): {sensitivity:.4f}")
print(f"Specificity (TNR): {specificity:.4f}")
