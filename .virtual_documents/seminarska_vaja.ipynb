      </div>
      <div style="font-size:{tf_sz}pt;">
        <h4 style="font-size:{tt_sz}pt;">Relativni deleži (%)</h4>{r_html}
      </div>
    </div>
    """
    display(HTML(html))



import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.gridspec import GridSpec
from matplotlib.patches import Patch
from IPython.display import display, Markdown


def show_numerical_data(
    feature: str,
    figsize=(15, 6),
    font_scale=0.9,
    title_size=15,
    label_size=15,
    xtick_size=14,  # velikost fonta samo za x-ticke
    ytick_size=14,  # velikost fonta samo za y-ticke
    xtick_rotation=0,  # rotacija x-tick oznak
    hist_bins=25,
    # neuporabljeno (pusti zaradi združljivosti s starim klicem)
    row_heights=(1, 0.5),
    x_label_coords=None,
    y_label_coords=(-0.14, 0.5),
    annot_x_offset=0,
    annot_y_offset=0,
    # dodatno: stikalo za KDE in element histograma
    kde=True,
    hist_element="step",  # "step" | "bars" | "poly"
):
    """
    Dva grafa + deskriptivna statistika za kvantitativno spremenljivko:
    - Boxplot po skupinah (Diabetes_012) z anotiranimi povprečji.
    - Histogram (+ opcijski KDE) z ločenimi skupinami.

    Opombe:
    - stat='density' in common_norm=False: vsak 'hue' (skupina) je
      normiran zase, zato primerjamo oblike porazdelitev (ne velikosti vzorcev).
    """

    # velikosti pisav
    t_sz = title_size * font_scale
    l_sz = label_size * font_scale
    xt_sz = xtick_size * font_scale
    yt_sz = ytick_size * font_scale
    bar_txt_sz = label_size * font_scale

    # opisi skupin
    xticklabels = ["0\nne diabetik", "1\nprediabetik", "2\ndiabetik"]
    legend_labels = [
        "0 - ne diabetik",
        "1 - prediabetik",
        "2 - diabetik",
    ]

    with sns.plotting_context("notebook", font_scale=font_scale):
        fig = plt.figure(figsize=figsize)
        gs = GridSpec(1, 2, figure=fig, wspace=0.4)

        ax_box = fig.add_subplot(gs[0, 0])
        ax_hist = fig.add_subplot(gs[0, 1])

        # 1) Boxplot
        sns.boxplot(
            x="Diabetes_012",
            y=feature,
            data=data,
            palette="Set2",
            dodge=False,
            ax=ax_box,
            showfliers=False,
        )
        means = data.groupby("Diabetes_012")[feature].mean()
        for i, m in enumerate(means):
            ax_box.text(
                i + annot_x_offset,
                m + annot_y_offset,
                f"{m:.2f}",
                color="red",
                ha="center",
                va="bottom",
                fontsize=bar_txt_sz,
            )
        ax_box.set_title(
            f"Boxplot {feature} po statusu diabetesa", fontsize=t_sz
        )
        ax_box.set_xlabel("Status diabetesa", fontsize=l_sz)
        ax_box.set_ylabel(feature, fontsize=l_sz)
        if x_label_coords:
            ax_box.xaxis.set_label_coords(*x_label_coords)
        if y_label_coords:
            ax_box.yaxis.set_label_coords(*y_label_coords)
        ax_box.set_xticks([0, 1, 2])
        ax_box.set_xticklabels(xticklabels)
        ax_box.tick_params(
            axis="x", labelsize=xt_sz, rotation=xtick_rotation
        )
        ax_box.tick_params(axis="y", labelsize=yt_sz)
        if ax_box.get_legend():
            ax_box.get_legend().remove()

        # 2) Histogram + KDE (po skupinah)
        pal = sns.color_palette("Set2", n_colors=3)
        sns.histplot(
            data=data,
            x=feature,
            hue="Diabetes_012",
            bins=hist_bins,
            kde=kde,
            element=hist_element,
            stat="density",
            common_norm=False,
            palette=pal,
            ax=ax_hist,
            hue_order=[0, 1, 2],
            legend=False,  # svoj custom legend spodaj
        )
        ax_hist.set_title(f"Histogram & KDE {feature}", fontsize=t_sz)
        ax_hist.set_xlabel(feature, fontsize=l_sz)
        ax_hist.set_ylabel("Gostota verjetnosti", fontsize=l_sz)
        if x_label_coords:
            ax_hist.xaxis.set_label_coords(*x_label_coords)
        if y_label_coords:
            ax_hist.yaxis.set_label_coords(*y_label_coords)
        ax_hist.tick_params(
            axis="x", labelsize=xt_sz, rotation=xtick_rotation
        )
        ax_hist.tick_params(axis="y", labelsize=yt_sz)

        # legenda (3 vnosi za skupine)
        handles = [
            Patch(facecolor=pal[i], edgecolor="k", label=legend_labels[i])
            for i in range(3)
        ]
        ax_hist.legend(
            handles=handles,
            title="Status diabetesa",
            frameon=True,
        )

        plt.tight_layout()
        plt.show()

    # Deskriptivna statistika
    stats = data.groupby("Diabetes_012")[feature].describe().T
    display(Markdown(f"**Deskriptivna statistika za {feature}:**"))
    display(stats)

