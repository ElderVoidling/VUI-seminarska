import torch
import torch.nn as nn
import torch.nn.functional as F

class ResidualBlock(nn.Module):
    def __init__(self, dim, dropout=0.3):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(dim, dim),
            nn.BatchNorm1d(dim),
            nn.LeakyReLU(),
            nn.Dropout(dropout),
            nn.Linear(dim, dim),
            nn.BatchNorm1d(dim),
        )
        self.act = nn.LeakyReLU()

    def forward(self, x):
        return self.act(self.net(x) + x)


class DeepDualInputNet(nn.Module):
    def __init__(self, n_cont, n_bin):
        super().__init__()

        # Continuous branch
        self.cont_initial = nn.Sequential(
            nn.Linear(n_cont, 512),
            nn.BatchNorm1d(512),
            nn.LeakyReLU(),
            nn.Dropout(0.5),
        )
        self.cont_res1 = ResidualBlock(512, dropout=0.4)
        self.cont_down1 = nn.Sequential(
            nn.Linear(512, 256),
            nn.BatchNorm1d(256),
            nn.LeakyReLU(),
            nn.Dropout(0.4),
        )
        self.cont_res2 = ResidualBlock(256, dropout=0.3)
        self.cont_final = nn.Sequential(
            nn.Linear(256, 128),
            nn.LeakyReLU(),
        )

        # Binary branch
        self.bin_initial = nn.Sequential(
            nn.Linear(n_bin, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.4),
        )
        self.bin_res1 = ResidualBlock(128, dropout=0.3)
        self.bin_down1 = nn.Sequential(
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
        )
        self.bin_res2 = ResidualBlock(64, dropout=0.2)
        self.bin_final = nn.Sequential(
            nn.Linear(64, 32),
            nn.Sigmoid(),
        )

        # Joint head
        self.head = nn.Sequential(
            nn.Linear(128 + 32, 128),
            nn.BatchNorm1d(128),
            nn.LeakyReLU(),
            nn.Dropout(0.3),
            nn.Linear(128, 64),
            nn.LeakyReLU(),
            nn.Dropout(0.2),
            nn.Linear(64, 1),
        )

    def forward(self, x_cont, x_bin):
        # continuous path
        c = self.cont_initial(x_cont)
        c = self.cont_res1(c)
        c = self.cont_down1(c)
        c = self.cont_res2(c)
        out_c = self.cont_final(c)

        # binary path
        b = self.bin_initial(x_bin)
        b = self.bin_res1(b)
        b = self.bin_down1(b)
        b = self.bin_res2(b)
        out_b = self.bin_final(b)

        # merge & head
        merged = torch.cat([out_c, out_b], dim=1)
        return self.head(merged)



# 1) Instantiate your dual‐branch model
model = DeepDualInputNet(n_cont=len(cont_cols), n_bin=len(binary_cols)).to(device)
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)



# 2) Training loop for dual inputs
def train_model_dual(model, train_loader, test_loader, scaler_y, criterion, optimizer, epochs=50):
    train_losses, train_r2s, test_r2s = [], [], []

    for epoch in range(1, epochs+1):
        model.train()
        running_loss = 0.0
        all_preds, all_trues = [], []

        # ——— Training pass ———
        for x_cont, x_bin, yb in train_loader:
            x_cont, x_bin, yb = x_cont.to(device), x_bin.to(device), yb.to(device)
            optimizer.zero_grad()

            out = model(x_cont, x_bin)
            loss = criterion(out, yb)
            loss.backward()
            optimizer.step()

            running_loss += loss.item() * x_cont.size(0)
            all_preds.extend(out.detach().cpu().squeeze().tolist())
            all_trues.extend(yb.detach().cpu().squeeze().tolist())

        avg_loss = running_loss / len(train_loader.dataset)
        train_losses.append(avg_loss)

        # Denormalize for R²
        preds_inv = scaler_y.inverse_transform(np.array(all_preds).reshape(-1,1)).flatten()
        trues_inv = scaler_y.inverse_transform(np.array(all_trues).reshape(-1,1)).flatten()
        train_r2 = r2_score(trues_inv, preds_inv)
        train_r2s.append(train_r2)

        # ——— Validation pass ———
        model.eval()
        val_preds, val_trues = [], []
        with torch.no_grad():
            for x_cont, x_bin, yb in test_loader:
                x_cont, x_bin, yb = x_cont.to(device), x_bin.to(device), yb.to(device)
                out = model(x_cont, x_bin)
                val_preds.extend(out.cpu().squeeze().tolist())
                val_trues.extend(yb.cpu().squeeze().tolist())

        val_preds_inv   = scaler_y.inverse_transform(np.array(val_preds).reshape(-1,1)).flatten()
        val_trues_inv   = scaler_y.inverse_transform(np.array(val_trues).reshape(-1,1)).flatten()
        test_r2 = r2_score(val_trues_inv, val_preds_inv)
        test_r2s.append(test_r2)

        print(f"Epoch {epoch}/{epochs}  "
              f"Loss: {avg_loss:.4f}  "
              f"Train R²: {train_r2:.4f}  "
              f"Test R²: {test_r2:.4f}")

    return train_losses, train_r2s, test_r2s

# 3) Plotting remains the same
def plot_metrics(train_losses, train_r2s, test_r2s):
    epochs = range(1, len(train_losses) + 1)
    fig, ax1 = plt.subplots(figsize=(10,5))

    ax1.set_xlabel("Epoch")
    ax1.set_ylabel("Train Loss (MSE)", color="tab:red")
    ax1.plot(epochs, train_losses, color="tab:red", label="Train Loss")
    ax1.tick_params(axis="y", labelcolor="tab:red")

    ax2 = ax1.twinx()
    ax2.set_ylabel("R² Score", color="tab:blue")
    ax2.plot(epochs, train_r2s, color="tab:blue", linestyle="--", label="Train R²")
    ax2.plot(epochs, test_r2s,  color="tab:blue", linestyle="-",  label="Test R²")
    ax2.tick_params(axis="y", labelcolor="tab:blue")

    lines, labels  = ax1.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    ax1.legend(lines + lines2, labels + labels2, loc="best")

    plt.title("Training Progress: Loss & R²")
    fig.tight_layout()
    plt.grid(True)
    plt.show()



# 4) Run training + plot
train_losses, train_r2s, test_r2s = train_model_dual(
    model, train_loader, test_loader,
    scaler_y, criterion, optimizer,
    epochs=10
)


plot_metrics(train_losses, train_r2s, test_r2s)


