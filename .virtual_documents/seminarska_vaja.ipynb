import os
import pandas as pd

# 1) Preberi originalni dataset
df_original = pd.read_csv("diabetes_01_filtered.csv")

# 2) Prepričaj se, da imaš vse štiri nove feature v spremenljivkah:
#    new_feature_0, new_feature_1, new_feature_2, new_feature_3
#    (npr. kot numpy arraye ali sezname iste dolžine kot df_original)

# 3) Ustvari mapo, kamor boš shranil augmented CSV-je
output_dir = "./Augmented Datasets"
os.makedirs(output_dir, exist_ok=True)

# 4) Seznam vseh novih feature in imen
features = [
    (new_feature_0, "new_feature_0"),
    (new_feature_1, "new_feature_1"),
    (new_feature_2, "new_feature_2"),
    (new_feature_3, "new_feature_3"),
]

# 5) Za vsako metodo:
for i, (feat, feat_name) in enumerate(features):
    # Kopija originala
    df_aug = df_original.copy()
    # Dodaj novo kolono
    df_aug[feat_name] = feat
    # Določi ime datoteke
    out_path = os.path.join(
        output_dir,
        f"diabetes_01_augmented_method_{i}.csv"
    )
    # Shrani
    df_aug.to_csv(out_path, index=False)
    print(f"Saved augmented dataset: {out_path}")












# Modified train function
def train_model(model, train_loader, test_loader, scaler_y, criterion, optimizer, epochs=50):
    epoch_losses = []
    epoch_r2_scores = []

    for epoch in range(epochs):
        model.train()
        epoch_loss = 0

        for batch_X, batch_y in train_loader:
            batch_X = batch_X.to(device)
            batch_y = batch_y.to(device)

            optimizer.zero_grad()
            output = model(batch_X)
            loss = criterion(output, batch_y)
            loss.backward()
            optimizer.step()
            epoch_loss += loss.item()

        avg_loss = epoch_loss / len(train_loader)
        epoch_losses.append(avg_loss)

        # Evaluate on test set after each epoch
        model.eval()
        y_preds = []
        y_trues = []

        with torch.no_grad():
            for batch_X, batch_y in test_loader:
                batch_X = batch_X.to(device)
                batch_y = batch_y.to(device)
                output = model(batch_X)
                y_preds.extend(output.cpu().squeeze().tolist())
                y_trues.extend(batch_y.cpu().squeeze().tolist())

        # Denormalize
        y_preds_inv = scaler_y.inverse_transform(np.array(y_preds).reshape(-1, 1)).flatten()
        y_trues_inv = scaler_y.inverse_transform(np.array(y_trues).reshape(-1, 1)).flatten()
        r2 = r2_score(y_trues_inv, y_preds_inv)
        epoch_r2_scores.append(r2)

        print(f"Epoch {epoch+1}/{epochs} - Loss: {avg_loss:.4f} - R²: {r2:.4f}")

    return epoch_losses, epoch_r2_scores

def plot_loss_and_r2(losses, r2_scores):
    epochs = range(1, len(losses) + 1)
    
    fig, ax1 = plt.subplots(figsize=(10, 5))

    # Plot loss
    color = 'tab:red'
    ax1.set_xlabel('Epoch')
    ax1.set_ylabel('Loss (MSE)', color=color)
    ax1.plot(epochs, losses, color=color, label='Loss (MSE)')
    ax1.tick_params(axis='y', labelcolor=color)

    # Second y-axis for R²
    ax2 = ax1.twinx()
    color = 'tab:blue'
    ax2.set_ylabel('R² Score', color=color)
    ax2.plot(epochs, r2_scores, color=color, label='R² Score')
    ax2.tick_params(axis='y', labelcolor=color)

    # Title and layout
    plt.title("Training Progress: Loss & R² per Epoch")
    fig.tight_layout()
    plt.grid(True)
    plt.show()

def evaluate_model(model, test_loader, scaler_y):
    model.to(device)
    model.eval()
    y_preds = []
    y_trues = []

    with torch.no_grad():
        for batch_X, batch_y in test_loader:
            batch_X = batch_X.to(device)
            batch_y = batch_y.to(device)

            output = model(batch_X)
            y_preds.extend(output.cpu().squeeze().tolist())
            y_trues.extend(batch_y.cpu().squeeze().tolist())

    # Denormalize
    y_preds_inv = scaler_y.inverse_transform(np.array(y_preds).reshape(-1,1)).flatten()
    y_trues_inv = scaler_y.inverse_transform(np.array(y_trues).reshape(-1,1)).flatten()

    mse = mean_squared_error(y_trues_inv, y_preds_inv)
    mae = mean_absolute_error(y_trues_inv, y_preds_inv)
    r2 = r2_score(y_trues_inv, y_preds_inv)

    print(f"📉 MSE: {mse:.2f}")
    print(f"📉 MAE: {mae:.2f}")
    print(f"📈 R² Score: {r2:.4f}")

    # Scatter plot
    plt.figure(figsize=(6,6))
    plt.scatter(y_trues_inv, y_preds_inv, alpha=0.3)
    plt.plot([y_trues_inv.min(), y_trues_inv.max()],
             [y_trues_inv.min(), y_trues_inv.max()], 'r--')
    plt.xlabel("True BMI")
    plt.ylabel("Predicted BMI")
    plt.title("True vs Predicted BMI")
    plt.grid(True)
    plt.show()



from sklearn.metrics import r2_score

def train_model(model, train_loader, test_loader, scaler_y, criterion, optimizer, epochs=50):
    train_losses, train_r2s = [], []
    test_r2s = []

    for epoch in range(epochs):
        model.train()
        running_loss = 0.0
        all_preds, all_trues = [], []

        # ——— Training pass ———
        for Xb, yb in train_loader:
            Xb, yb = Xb.to(device), yb.to(device)
            optimizer.zero_grad()
            out = model(Xb)
            loss = criterion(out, yb)
            loss.backward()
            optimizer.step()

            running_loss += loss.item() * Xb.size(0)
            all_preds.extend(out.detach().cpu().squeeze().tolist())
            all_trues.extend(yb.detach().cpu().squeeze().tolist())

        # Epoch‐level train metrics
        avg_loss = running_loss / len(train_loader.dataset)
        train_losses.append(avg_loss)

        # Denormalize to compute R² in original units
        preds_inv = scaler_y.inverse_transform(np.array(all_preds).reshape(-1,1)).flatten()
        trues_inv = scaler_y.inverse_transform(np.array(all_trues).reshape(-1,1)).flatten()
        train_r2 = r2_score(trues_inv, preds_inv)
        train_r2s.append(train_r2)

        # ——— Validation pass ———
        model.eval()
        val_preds, val_trues = [], []
        with torch.no_grad():
            for Xb, yb in test_loader:
                Xb, yb = Xb.to(device), yb.to(device)
                out = model(Xb)
                val_preds.extend(out.cpu().squeeze().tolist())
                val_trues.extend(yb.cpu().squeeze().tolist())

        val_preds_inv = scaler_y.inverse_transform(np.array(val_preds).reshape(-1,1)).flatten()
        val_trues_inv = scaler_y.inverse_transform(np.array(val_trues).reshape(-1,1)).flatten()
        test_r2 = r2_score(val_trues_inv, val_preds_inv)
        test_r2s.append(test_r2)

        print(f"Epoch {epoch+1}/{epochs}  "
              f"Train Loss: {avg_loss:.4f}  "
              f"Train R²: {train_r2:.4f}  "
              f"Test R²: {test_r2:.4f}")

    return train_losses, train_r2s, test_r2s


def plot_metrics(train_losses, train_r2s, test_r2s):
    epochs = range(1, len(train_losses) + 1)
    fig, ax1 = plt.subplots(figsize=(10,5))

    # Loss curve
    ax1.set_xlabel("Epoch")
    ax1.set_ylabel("Train Loss (MSE)", color="tab:red")
    ax1.plot(epochs, train_losses, color="tab:red", label="Train Loss")
    ax1.tick_params(axis="y", labelcolor="tab:red")

    # R² curves on second axis
    ax2 = ax1.twinx()
    ax2.set_ylabel("R² Score", color="tab:blue")
    ax2.plot(epochs, train_r2s, color="tab:blue", linestyle="--", label="Train R²")
    ax2.plot(epochs, test_r2s,  color="tab:blue", linestyle="-",  label="Test R²")
    ax2.tick_params(axis="y", labelcolor="tab:blue")

    # Legends
    lines, labels = ax1.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    ax1.legend(lines + lines2, labels + labels2, loc="best")

    plt.title("Training Progress: Loss & R²")
    fig.tight_layout()
    plt.grid(True)
    plt.show()



def predict(model, X):
    model.eval()
    xt = torch.tensor(X, dtype=torch.float32).to(device)
    with torch.no_grad():
        yt = model(xt).cpu().squeeze().numpy()
    return yt






