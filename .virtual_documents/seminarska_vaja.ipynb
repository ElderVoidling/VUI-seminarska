# ---- 6) Define stepwise simulation function ----
def simulate_stepwise(idx, k=100):
    """
    For a single diabetic sample at index idx:
    - Perform inference with model0 and model1
    - Step k times toward the non-diabetic centroid 'a'
    - Print at each step: predictions, sample values, and step vector
    """
    p = X_scaled[idx].copy()  # start point in scaled space
    step_vec = (a - p) / k     # constant step
    print(f"\nSimulating sample idx={idx}: initial class=1")
    for i in range(1, k+1):
        # inference
        inp = torch.tensor(p, dtype=torch.float32, device=device).unsqueeze(0)
        with torch.no_grad():
            pred0 = model0(inp).item()
            pred1 = model1(inp).item()
        # print status
        print(f"Step {i:3d}: pred0={pred0:.4f}, pred1={pred1:.4f}")
        print(f"         sample[0:5]={p[:5]}")
        print(f"         step_vec[0:5]={step_vec[:5]}\n")
        # move point
        p += step_vec






