def simulate_stepwise(idx, k=100):
    """
    Vrne pot točk v scaled prostoru, kot np.array oblike (k+1, dim)
    """
    p = X_scaled[idx].copy()
    step_vec = (a - p) / k
    path_points = [p.copy()]

    for _ in range(k):
        p += step_vec
        path_points.append(p.copy())

    return np.array(path_points)



