import numpy as np
import pandas as pd
import torch
from tqdm.auto import tqdm

def adjust_dataset_BMI(
    model: torch.nn.Module,
    all_binary_values,
    all_continuous_values,
    nudge_alpha: float,
    scaler_xc,
    scaler_y,
    binary_feature_names,
    continuous_feature_names,
    ordinal_feature_names,
    ordinal_bounds,
    use_only_practicaly_sensible_features: bool = True,
    device: torch.device = None,
    use_absolute: bool = False,    # default changed to False (use signed diffs)
    verbose: bool = True,
    print_raw_gradients: bool = False,
    show_progress: bool = True,
    progress_desc: str = "Adjusting samples",
    progress_unit: str = "sample",
    aggregate: str = "median",     # "median" (default) or "mean"
    update_steps: int = 1
):
    """
    Iteratively applies get_recommended_adjustment per sample (update_steps times).
    Aggregates GLOBAL differences: final-step output minus ORIGINAL input.

    Returns:
      - X_adjusted_binary: (N, n_bin) final rounded adjusted binary features (ints)
      - X_adjusted_cont:   (N, n_cont) final rounded adjusted continuous features (floats; ordinals rounded)
      - df: DataFrame with aggregated per-feature diffs (median/mean) across samples
      - raw_diffs:     (N, n_bin+n_cont) per-sample RAW diffs (final latent bin + final raw cont) vs original
      - rounded_diffs: (N, n_bin+n_cont) per-sample ROUNDED diffs (final rounded) vs original
    """
    all_binary_values = np.asarray(all_binary_values)
    all_continuous_values = np.asarray(all_continuous_values)
    N = all_binary_values.shape[0]
    assert all_continuous_values.shape[0] == N, "Binary and continuous must have same N samples."

    mu  = np.asarray(scaler_xc.mean_, dtype=np.float32).reshape(1, -1)
    sig = np.asarray(scaler_xc.scale_, dtype=np.float32).reshape(1, -1)

    raw_diffs_list = []
    rounded_diffs_list = []
    Xb_adj_list = []
    Xc_adj_list = []

    iterator = tqdm(range(N), desc=progress_desc, unit=progress_unit, leave=False) if show_progress else range(N)

    for i in iterator:
        orig_bin  = np.asarray(all_binary_values[i], dtype=np.float32).reshape(-1)
        orig_cont = np.asarray(all_continuous_values[i], dtype=np.float32).reshape(-1)

        cur_bin  = orig_bin.copy()
        cur_cont = orig_cont.copy()

        last_bin_lat = None
        last_xc_z = None
        last_bin_rounded = None
        last_cont_rounded = None

        for _ in range(int(update_steps)):
            new_bin_rounded, new_cont_rounded, new_xc_z, new_bin_lat = get_recommended_adjustment(
                model=model,
                sample_binary_values=cur_bin,
                sample_continuous_values=cur_cont,
                nudge_alpha=nudge_alpha,
                scaler_xc=scaler_xc,
                scaler_y=scaler_y,
                binary_feature_names=binary_feature_names,
                continuous_feature_names=continuous_feature_names,
                ordinal_feature_names=ordinal_feature_names,
                ordinal_bounds=ordinal_bounds,
                device=device,
                verbose=False,
                print_raw_gradients=print_raw_gradients,
                return_only_rounded=False,
                use_only_practicaly_sensible_features=use_only_practicaly_sensible_features
            )
            last_bin_lat = new_bin_lat
            last_xc_z = new_xc_z
            last_bin_rounded = np.asarray(new_bin_rounded, dtype=np.int64).reshape(-1)
            last_cont_rounded = np.asarray(new_cont_rounded, dtype=np.float32).reshape(-1)

            cur_bin = last_bin_rounded.astype(np.float32)
            cur_cont = last_cont_rounded.astype(np.float32)

        final_bin_lat = last_bin_lat.detach().cpu().numpy().reshape(-1)
        final_cont_raw = (last_xc_z.detach().cpu().numpy() * sig + mu).reshape(-1)

        diff_raw = np.concatenate([final_bin_lat - orig_bin, final_cont_raw - orig_cont])
        diff_rounded = np.concatenate([last_bin_rounded - orig_bin, last_cont_rounded - orig_cont])

        if use_absolute:
            diff_raw = np.abs(diff_raw)
            diff_rounded = np.abs(diff_rounded)

        raw_diffs_list.append(diff_raw)
        rounded_diffs_list.append(diff_rounded)
        Xb_adj_list.append(last_bin_rounded)
        Xc_adj_list.append(last_cont_rounded)

    raw_diffs = np.stack(raw_diffs_list, axis=0)
    rounded_diffs = np.stack(rounded_diffs_list, axis=0)
    X_adjusted_binary = np.stack(Xb_adj_list, axis=0)
    X_adjusted_cont   = np.stack(Xc_adj_list, axis=0)

    if aggregate not in {"mean", "median"}:
        raise ValueError("aggregate must be 'mean' or 'median'")
    agg_func = np.median if aggregate == "median" else np.mean
    col_raw = ("median_raw_diff" if aggregate == "median" else "avg_raw_diff")
    col_rounded = ("median_rounded_diff" if aggregate == "median" else "avg_rounded_diff")

    agg_raw     = agg_func(raw_diffs, axis=0)
    agg_rounded = agg_func(rounded_diffs, axis=0)

    feature_names = list(binary_feature_names) + list(continuous_feature_names)
    df = pd.DataFrame({col_raw: agg_raw, col_rounded: agg_rounded}, index=feature_names)

    if verbose:
        print(f"{aggregate.capitalize()} GLOBAL differences per feature over {update_steps} step(s) (absolute={use_absolute}):")
        try:
            from IPython.display import display
            display(df)
        except Exception:
            print(df)

    return X_adjusted_binary, X_adjusted_cont, df, raw_diffs, rounded_diffs











# === 2×2: Diabetes_012 (binarna) vs. binarne X — χ² + učinki + grafi ===
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
CONF_LEVEL = 0.95
ALPHA = 0.05

SHOW_COUNTS_HEATMAP = True
COUNTS_HEATMAP_ADD_PCT = True  # prikaži % (od vseh) v anotacijah heatmape
SHOW_STACKED_PROP = True  # 100% zloženi graf deležev po X
STACKED_TEXT_THRESHOLD = 3.0  # ne piši % v segment, če < 3%

sns.set_theme(style="whitegrid")

# Preberi podatke
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"

# Omeji na {0,1} in odstrani NaN
before_n = len(df)
df = df[df[Y_COL].isin([0, 1])].copy()
removed = before_n - len(df)
if removed > 0:
    print(f"Opozorilo: odstranjenih {removed} vrstic (Y ni bil 0/1).")

# Helper: ali je stolpec binaren (⊆{0,1})
def is_binary_series(s: pd.Series) -> bool:
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    return set(vals).issubset({0, 1})

# Izberi binarne X (razen Y)
binary_cols = [c for c in df.columns if c != Y_COL and is_binary_series(df[c])]
print(f"Najdene binarne X ({len(binary_cols)}): {binary_cols}")

# Wilson CI za delež
def wilson_ci(k: int, n: int, conf: float = CONF_LEVEL):
    if n == 0:
        return (np.nan, np.nan)
    z = stats.norm.ppf(1 - (1 - conf) / 2)
    p = k / n
    den = 1 + (z**2) / n
    center = (p + (z**2) / (2 * n)) / den
    half = (z * np.sqrt(p * (1 - p) / n + (z**2) / (4 * n**2))) / den
    return (center - half, center + half)

# Efektne mere iz 2×2 tabele (brez phi/Cramér's V)
def effect_sizes_from_ct(ct: pd.DataFrame, conf: float = CONF_LEVEL):
    # Tabela z vrsticami Y (0,1) in stolpci X (0,1)
    a = float(ct.loc[1, 1])  # Y=1, X=1
    b = float(ct.loc[0, 1])  # Y=0, X=1
    c = float(ct.loc[1, 0])  # Y=1, X=0
    d = float(ct.loc[0, 0])  # Y=0, X=0

    n = a + b + c + d
    n1 = a + b  # X=1 total
    n0 = c + d  # X=0 total

    # Deleži
    p1 = a / n1 if n1 > 0 else np.nan  # P(Y=1 | X=1)
    p0 = c / n0 if n0 > 0 else np.nan  # P(Y=1 | X=0)

    # RD in Newcombe CI (Wilson za p1 in p0)
    p1_L, p1_U = wilson_ci(int(a), int(n1))
    p0_L, p0_U = wilson_ci(int(c), int(n0))
    rd = p1 - p0 if np.isfinite(p1) and np.isfinite(p0) else np.nan
    rd_L = (p1_L - p0_U) if np.all(np.isfinite([p1_L, p0_U])) else np.nan
    rd_U = (p1_U - p0_L) if np.all(np.isfinite([p1_U, p0_L])) else np.nan

    # RR in CI (log metoda, Haldane–Anscombe za ničelne celice)
    use_ha = any(v == 0 for v in [a, b, c, d])
    if use_ha:
        a_, b_, c_, d_ = a + 0.5, b + 0.5, c + 0.5, d + 0.5
    else:
        a_, b_, c_, d_ = a, b, c, d
    p1_ = a_ / (a_ + b_)
    p0_ = c_ / (c_ + d_)
    rr = p1_ / p0_ if p0_ > 0 else np.inf
    if np.isfinite(rr) and p1_ > 0 and p0_ > 0:
        se_log_rr = np.sqrt(1 / a_ - 1 / (a_ + b_) + 1 / c_ - 1 / (c_ + d_))
        z = stats.norm.ppf(1 - (1 - CONF_LEVEL) / 2)
        rr_L = np.exp(np.log(rr) - z * se_log_rr)
        rr_U = np.exp(np.log(rr) + z * se_log_rr)
    else:
        rr_L, rr_U = np.nan, np.nan

    # OR in CI (log metoda, Haldane–Anscombe za ničelne celice)
    orv = (a_ * d_) / (b_ * c_) if (b_ * c_) > 0 else np.inf
    if np.isfinite(orv):
        se_log_or = np.sqrt(1 / a_ + 1 / b_ + 1 / c_ + 1 / d_)
        z = stats.norm.ppf(1 - (1 - CONF_LEVEL) / 2)
        or_L = np.exp(np.log(orv) - z * se_log_or)
        or_U = np.exp(np.log(orv) + z * se_log_or)
    else:
        or_L, or_U = np.nan, np.nan

    return dict(
        n=int(n),
        p1=p1,
        p0=p0,
        rd=rd,
        rd_L=rd_L,
        rd_U=rd_U,
        rr=rr,
        rr_L=rr_L,
        rr_U=rr_U,
        orv=orv,
        or_L=or_L,
        or_U=or_U,
        had_zeros=use_ha,
    )

# Cramérjev V (splošna formula; za 2×2 se skrči na sqrt(chi2 / n))
def cramers_v_from_chi2(chi2_val: float, n: int, r: int, c: int) -> float:
    if n <= 0:
        return np.nan
    denom = min(r - 1, c - 1)
    if denom <= 0:
        return np.nan
    return float(np.sqrt(chi2_val / (n * denom)))

# Vizualizacija
def plot_2x2(ct: pd.DataFrame, exp: np.ndarray, title_prefix: str):
    # 1) Counts heatmap (opaženo + pričakovano + % od vseh)
    if SHOW_COUNTS_HEATMAP:
        fig, ax = plt.subplots(figsize=(4.8, 3.8))
        total = ct.values.sum()
        ann = np.empty_like(exp, dtype=object)
        for i in range(ct.shape[0]):
            for j in range(ct.shape[1]):
                obs = int(ct.iloc[i, j])
                txt = f"{obs}\n({exp[i, j]:.1f})"
                if COUNTS_HEATMAP_ADD_PCT and total > 0:
                    pct = 100.0 * obs / total
                    txt += f"\n{pct:.1f}%"
                ann[i, j] = txt
        sns.heatmap(
            ct,
            annot=ann,
            fmt="",
            cmap="Blues",
            cbar=False,
            linewidths=0.5,
            linecolor="white",
            xticklabels=ct.columns,
            yticklabels=ct.index,
            ax=ax,
        )
        ax.set_title(
            f"{title_prefix} – št. (prič.)"
            + (" + %" if COUNTS_HEATMAP_ADD_PCT else "")
        )
        ax.set_xlabel("X (0/1)")
        ax.set_ylabel(f"{Y_COL} (0/1)")
        plt.tight_layout()
        plt.show()

    # 2) 100% zloženi graf deležev po X (stolpci = X, segmenti = Y)
    if SHOW_STACKED_PROP:
        col_perc = (ct.div(ct.sum(axis=0), axis=1) * 100).fillna(0)
        seg_colors = {0: "lightgray", 1: "tab:blue"}

        fig, ax = plt.subplots(figsize=(5.2, 3.6))
        xs = list(ct.columns)  # [0, 1]
        y_vals = list(ct.index)  # [0, 1]
        for j, x in enumerate(xs):
            left = 0.0
            for y in y_vals:
                w = float(col_perc.loc[y, x])
                ax.barh(
                    y=[j],
                    width=[w],
                    left=[left],
                    color=seg_colors[y],
                    edgecolor="white",
                    height=0.6,
                    label=f"{Y_COL}={y}" if j == 0 else "_nolegend_",
                )
                if w >= STACKED_TEXT_THRESHOLD:
                    ax.text(
                        left + w / 2.0,
                        j,
                        f"{w:.1f}%",
                        ha="center",
                        va="center",
                        color="black" if y == 0 else "white",
                        fontsize=9,
                    )
                left += w

        ax.set_yticks([0, 1])
        ax.set_yticklabels([f"X={xs[0]}", f"X={xs[1]}"])
        ax.set_xlim(0, 100)
        ax.set_xlabel("Delež v % (znotraj X)", fontsize=10)
        ax.set_title(f"{title_prefix} – 100% zloženi deleži po X", fontsize=11)
        ax.legend(title=f"{Y_COL}", loc="lower right", frameon=True)
        ax.grid(axis="x", alpha=0.2, linestyle="--")
        plt.tight_layout()
        plt.show()


def crosstab_with_margins(ct: pd.DataFrame, total_label: str = "Σ"):
    ct2 = ct.copy()
    row_tot = ct2.sum(axis=1)
    col_tot = ct2.sum(axis=0)
    grand = int(row_tot.sum())

    ct2[total_label] = row_tot

    last_row = pd.Series(
        list(col_tot.values) + [grand],
        index=ct2.columns,
        name=total_label,
    )
    ct2 = pd.concat([ct2, last_row.to_frame().T])

    try:
        ct2 = ct2.astype(int)
    except Exception:
        pass

    return ct2


def expected_with_margins(
    exp: np.ndarray, ct_like: pd.DataFrame, total_label: str = "Σ", decimals: int = 1
):
    exp_df = pd.DataFrame(exp, index=ct_like.index, columns=ct_like.columns)
    row_tot = exp_df.sum(axis=1)
    col_tot = exp_df.sum(axis=0)
    grand = float(exp_df.values.sum())

    exp_df[total_label] = row_tot
    last_row = pd.Series(
        list(col_tot.values) + [grand],
        index=exp_df.columns,
        name=total_label,
    )
    exp_df = pd.concat([exp_df, last_row.to_frame().T])

    return exp_df.round(decimals)


# Glavna zanka: χ² test + izpisi in grafi
rows = []
for x_col in binary_cols:
    # 2×2 tabela (vrstice Y: 0,1; stolpci X: 0,1)
    ct = (
        pd.crosstab(df[Y_COL], df[x_col])
        .reindex(index=[0, 1], columns=[0, 1], fill_value=0)
    )

    # Pearson χ² (brez Yates, ker veliko n)
    chi2, p, dof, exp = stats.chi2_contingency(ct.values, correction=False)

    # Efektne mere
    eff = effect_sizes_from_ct(ct)

    # Cramérjev V (za 2×2 enak phi = sqrt(χ²/N))
    n_total = int(ct.values.sum())
    r, c = ct.shape
    cramer_v = cramers_v_from_chi2(chi2, n_total, r, c)

    # Zgoščeni izpis
    print(f"\n=== {x_col} (2×2) vs {Y_COL} ===")

    ct_print = crosstab_with_margins(ct, total_label="Σ")
    exp_print = expected_with_margins(
        exp, ct_like=ct, total_label="Σ", decimals=1
    )
    print("Opažene (dejanske) frekvence (z vsotami):")
    display(ct_print)
    print("Pričakovane frekvence pod H0 (z vsotami):")
    display(exp_print)

    print(f"χ²(1)={chi2:.3f}, p={p:.3e}, Cramér V={cramer_v:.3f}")
    or_note = " (HA 0.5)" if eff["had_zeros"] else ""
    print(
        "Odds Ratio \n"
        f"OR = {eff['orv']:.3f}  "
        f"[{eff['or_L']:.3f}, {eff['or_U']:.3f}]{or_note}"
    )

    # Grafi
    plot_2x2(ct, exp, title_prefix=f"{x_col} vs {Y_COL}")

    # Za agregatni povzetek (dodaj cramer_V v tabelo)
    rows.append(
        dict(
            feature=x_col,
            n=n_total,
            chi2=chi2,
            p=p,
            OR=eff["orv"],
            OR_L=eff["or_L"],
            OR_U=eff["or_U"],
            cramer_V=cramer_v,  # <-- dodano
        )
    )

# Povzetek v DataFrame + (opcijsko) FDR korekcija
res = pd.DataFrame(rows).sort_values("p").reset_index(drop=True)
try:
    from statsmodels.stats.multitest import multipletests

    # res["p_FDR"] = multipletests(res["p"].values, method="fdr_bh")[1]
except Exception:
    pass

print("\nTop rezultati (po p):")
display(res)














# === Diabetes_012 (binarna) vs. numerične X — normalnost + variance + grafe ===
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
BINS = 50
MAX_QQ_POINTS = 20000  # vzorčenje za QQ (na skupino) zaradi hitrosti
RANDOM_STATE = 42
MIN_UNIQUE_FOR_CONT = 14  # prag, da X obravnavamo kot "kontinuirno"

sns.set_theme(style="whitegrid")

# --- 1) Preberi podatke ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
# omeji Y na {0,1}
df = df[df[Y_COL].isin([0, 1])].copy()

# --- 2) Najdi numerične neodvisne (izloči binarne 0/1) ---
def is_continuous_numeric(s: pd.Series) -> bool:
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    if set(vals).issubset({0, 1}):  # izloči čiste binarne
        return False
    return len(vals) >= MIN_UNIQUE_FOR_CONT

num_cols = [c for c in df.columns if c != Y_COL and is_continuous_numeric(df[c])]
print(f"Najdene numerične X ({len(num_cols)}): {num_cols}")

# --- 3) Pomožne funkcije (za KS in QQ) ---
def sample_for_qq(x: np.ndarray, max_n=MAX_QQ_POINTS, random_state=RANDOM_STATE):
    x = x[~np.isnan(x)]
    if x.size <= max_n:
        return x
    rng = np.random.default_rng(random_state)
    idx = rng.choice(x.size, size=max_n, replace=False)
    return x[idx]

# KS (aproks.) proti N(mu_hat, sigma_hat) — po skupinah
def ks_normal_test(x: np.ndarray):
    x = x[~np.isnan(x)]
    if x.size < 2:
        return np.nan, np.nan
    mu, sigma = np.mean(x), np.std(x, ddof=1)
    if sigma <= 0 or not np.isfinite(sigma):
        return np.nan, np.nan
    d, p = stats.kstest(x, "norm", args=(mu, sigma))
    return d, p

def ks_comment(p):
    if not np.isfinite(p):
        return "ni podatkov"
    return "zavrnemo normalnost" if p < 0.05 else "≈ normalno"

def levene_comment(p):
    return f"Levene p={p:.3e} → variance: " + ("enake" if p >= 0.05 else "neenake")

# --- 4) Diagnostika po numeričnih X: samo KS + Levene + grafi ---
for x_col in num_cols:
    y0 = df.loc[df[Y_COL] == 0, x_col].to_numpy(dtype=float)
    y1 = df.loc[df[Y_COL] == 1, x_col].to_numpy(dtype=float)

    # Levene (center='mean')
    lev_stat, lev_p = stats.levene(y0, y1, center="mean", nan_policy="omit")

    # KS po skupinah (approx)
    ks0_D, ks0_p = ks_normal_test(y0)
    ks1_D, ks1_p = ks_normal_test(y1)

    # Zgoščeni izpis: samo normalnost in variance
    print(f"\n=== {x_col} (num) → {Y_COL} ===")
    print(
        f"KS (approx) Y=0: D={ks0_D:.3f}, p={ks0_p:.3e} → {ks_comment(ks0_p)}"
    )
    print(
        f"KS (approx) Y=1: D={ks1_D:.3f}, p={ks1_p:.3e} → {ks_comment(ks1_p)}"
    )
    print(levene_comment(lev_p))

    # FIG: ena vrstica z 4 grafi
    fig, axes = plt.subplots(1, 4, figsize=(14, 3.2))

    # 1) Histogram (prekrivno po Y)
    axes[0].hist(
        y0, bins=BINS, alpha=0.6, density=True, label="Y=0", color="tab:blue"
    )
    axes[0].hist(
        y1, bins=BINS, alpha=0.6, density=True, label="Y=1", color="tab:orange"
    )
    axes[0].set_title("Hist (Y=0 vs Y=1)", fontsize=10)
    axes[0].set_xlabel(x_col, fontsize=9)
    axes[0].set_ylabel("Gostota", fontsize=9)
    axes[0].legend(fontsize=8)

    # 2) Boxplot (po Y)
    axes[1].boxplot([y0, y1], labels=["Y=0", "Y=1"], showfliers=True, widths=0.6)
    axes[1].set_title("Boxplot", fontsize=10)
    axes[1].set_xlabel(Y_COL, fontsize=9)
    axes[1].set_ylabel(x_col, fontsize=9)

    # 3) QQ (Y=0)
    y0_qq = sample_for_qq(y0)
    stats.probplot(y0_qq, dist="norm", plot=axes[2])
    axes[2].set_title("QQ (Y=0)", fontsize=10)

    # 4) QQ (Y=1)
    y1_qq = sample_for_qq(y1)
    stats.probplot(y1_qq, dist="norm", plot=axes[3])
    axes[3].set_title("QQ (Y=1)", fontsize=10)

    fig.suptitle(f"{x_col} vs {Y_COL}", fontsize=11)
    fig.tight_layout(rect=[0, 0, 1, 0.92])
    plt.show()

print("\n✅ Končano: samo KS (normalnost) + Levene (variance) + histogram/box/QQ.")





# === Diabetes_012 (binarna) vs. numerične X — Mann–Whitney U + AUC (iz U) ===
import numpy as np
import pandas as pd
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
ALPHA = 0.05
MIN_UNIQUE_FOR_CONT = 14  # prag, da X obravnavamo kot "kontinuirno"
expanded_report = False  # True -> dodaj povprečja, SD, IQR

# --- 1) Podatki ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
df = df[df[Y_COL].isin([0, 1])].copy()

# --- 2) Izbor numeričnih X (izloči čiste 0/1) ---
def is_continuous_numeric(s: pd.Series) -> bool:
    if not pd.api.types.is_numeric_dtype(s):
        return False
    vals = pd.unique(s.dropna())
    if set(vals).issubset({0, 1}):
        return False
    return len(vals) >= MIN_UNIQUE_FOR_CONT

num_cols = [c for c in df.columns if c != Y_COL and is_continuous_numeric(df[c])]
print(f"Najdene numerične X ({len(num_cols)}): {num_cols}")

def iqr(arr: np.ndarray) -> float:
    arr = arr[~np.isnan(arr)]
    if arr.size == 0:
        return np.nan
    q1, q3 = np.percentile(arr, [25, 75])
    return float(q3 - q1)

# --- 3) Mann–Whitney U po vseh numeričnih X + AUC iz U ---
rows = []
for x_col in num_cols:
    x0 = df.loc[df[Y_COL] == 0, x_col].astype(float).to_numpy()
    x1 = df.loc[df[Y_COL] == 1, x_col].astype(float).to_numpy()

    x0 = x0[~np.isnan(x0)]
    x1 = x1[~np.isnan(x1)]
    n0, n1 = x0.size, x1.size

    if n0 == 0 or n1 == 0:
        u_stat, p_val = np.nan, np.nan
        med0, med1, diff_med = np.nan, np.nan, np.nan
        smer_str = "ni podatkov"
        sklep = "ni podatkov"
        auc = np.nan
    else:
        # Two-sided p (method='auto' izbere exact/asimptotični)
        u_stat, p_val = stats.mannwhitneyu(
            x1, x0, alternative="two-sided", method="auto"
        )

        # AUC iz U za pozitivno skupino (Y=1):
        # U1 = sum(ranki Y=1) - n1*(n1+1)/2 ; AUC = U1 / (n1*n0)
        z = np.concatenate([x1, x0])
        ranks = stats.rankdata(z, method="average")
        r1_sum = ranks[:n1].sum()
        U1 = r1_sum - n1 * (n1 + 1) / 2.0
        auc = float(U1 / (n1 * n0))

        med0 = float(np.nanmedian(x0))
        med1 = float(np.nanmedian(x1))
        diff_med = med1 - med0
        smer_str = (
            f"{x_col} je višji pri Y=1"
            if diff_med > 0
            else f"{x_col} je nižji pri Y=1"
            if diff_med < 0
            else "mediani sta enaki"
        )
        sklep = (
            "statistično značilna razlika" if p_val < ALPHA else "ni značilne razlike"
        )

    row = {
        "spremenljivka": x_col,
        "test": "Mann–Whitney U",
        "U_stat(min)": float(u_stat) if np.isfinite(u_stat) else np.nan,
        "p_value": float(p_val) if np.isfinite(p_val) else np.nan,
        "AUC": float(auc) if np.isfinite(auc) else np.nan,
        "AUC_signal": (abs(auc - 0.5) if np.isfinite(auc) else np.nan),
        "n0": int(n0),
        "n1": int(n1),
        "Sklep": sklep,
        "Smer": smer_str,
    }

    if expanded_report and np.isfinite(auc):
        mean0 = float(np.nanmean(x0)) if n0 > 0 else np.nan
        mean1 = float(np.nanmean(x1)) if n1 > 0 else np.nan
        sd0 = float(np.nanstd(x0, ddof=1)) if n0 > 1 else np.nan
        sd1 = float(np.nanstd(x1, ddof=1)) if n1 > 1 else np.nan
        row.update(
            dict(
                median_0=med0,
                median_1=med1,
                diff_median_10=diff_med,
                mean_0=mean0,
                mean_1=mean1,
                sd_0=sd0,
                sd_1=sd1,
                iqr_0=iqr(x0),
                iqr_1=iqr(x1),
            )
        )

    rows.append(row)

results = pd.DataFrame(rows).sort_values("p_value").reset_index(drop=True)

# Če želiš rangirati po moči signala, raje:
# results = results.sort_values("AUC_signal", ascending=False).reset_index(drop=True)

pd.set_option("display.max_colwidth", None)
pd.set_option("display.width", None)
display(results)














# === Diabetes_012 (binarna) vs. ordinalne/kategorične X — χ² + grafi ===
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy import stats
from IPython.display import display

# Nastavitve
CSV_PATH = "./diabetes_01_filtered.csv"
Y_COL = "Diabetes_012"  # binarna (0/1)
ALPHA = 0.05
CONF_LEVEL = 0.95

# izberi X z max toliko kategorij (ignoriraj "high-cardinality")
MAX_CATS = 13
# privzeto: numerične kategorije obravnavaj kot ordinalne (naraščajoči red)
ASSUME_NUMERIC_IS_ORDINAL = True

# opcijsko: ročni vrstni red za posamezne X (če želiš drugačen od default)
# primer: ORDER_MAP = {"OrdinalFeature": [1, 2, 3, 4, 5]}
ORDER_MAP: dict[str, list] = {}

# grafi
SHOW_PROP_CI = True
SHOW_RESID_HEATMAP = True

sns.set_theme(style="whitegrid")

# --- 1) Podatki ---
df = pd.read_csv(CSV_PATH)
assert Y_COL in df.columns, f"{Y_COL} ni v stolpcih!"
df = df[df[Y_COL].isin([0, 1])].copy()

# --- 2) Izbor kategoričnih/ordinalnih X (izločimo binarne 0/1) ---
def is_categorical_candidate(s: pd.Series) -> bool:
    # štejemo kot kandidat, če je object/category ali numeric z malo različnimi
    # vrednostmi
    if pd.api.types.is_categorical_dtype(s) or pd.api.types.is_object_dtype(s):
        return s.dropna().nunique() >= 2 and s.dropna().nunique() <= MAX_CATS
    if pd.api.types.is_numeric_dtype(s):
        vals = pd.unique(s.dropna())
        if set(vals).issubset({0, 1}):  # binarne X damo drugam, ne sem
            return False
        return 2 <= len(vals) <= MAX_CATS
    return False

cat_cols = [c for c in df.columns if c != Y_COL and is_categorical_candidate(df[c])]
print(f"Najdene kategorične/ordinalne X ({len(cat_cols)}): {cat_cols}")

# --- 3) Pomožne funkcije ---
def wilson_ci(k: int, n: int, conf: float = CONF_LEVEL):
    if n == 0:
        return (np.nan, np.nan)
    z = stats.norm.ppf(1 - (1 - conf) / 2)
    p = k / n
    den = 1 + (z**2) / n
    center = (p + (z**2) / (2 * n)) / den
    half = (z * np.sqrt(p * (1 - p) / n + (z**2) / (4 * n**2))) / den
    return float(center - half), float(center + half)

def is_ordinal_column(s: pd.Series, name: str):
    # če je v ORDER_MAP, je ordinalen; sicer numeric in ASSUME_NUMERIC_IS_ORDINAL
    if name in ORDER_MAP:
        return True
    if pd.api.types.is_numeric_dtype(s) and ASSUME_NUMERIC_IS_ORDINAL:
        return True
    return False

def get_order(s: pd.Series, name: str):
    if name in ORDER_MAP:
        return ORDER_MAP[name]
    vals = list(pd.unique(s.dropna()))
    if pd.api.types.is_numeric_dtype(s):
        return sorted(vals)
    # za nenumerične, uporabi pogostost ali abecedni red; tu abecedni
    return sorted(vals, key=lambda x: str(x))

def plot_proportion_with_ci(ct: pd.DataFrame, title: str, ordinal: bool):
    # ct: 2×k (vrstice Y: 0,1; stolpci: kategorije X v pravem redu)
    cats = list(ct.columns)
    k = len(cats)
    n = ct.sum(axis=0).values
    y1 = ct.loc[1].values
    p = y1 / n
    ci = [wilson_ci(int(y1[i]), int(n[i])) for i in range(k)]
    lo = np.array([c[0] for c in ci])
    hi = np.array([c[1] for c in ci])

    fig, ax = plt.subplots(figsize=(max(4.8, 0.9 * k), 3.6))
    x = np.arange(k)
    ax.errorbar(
        x,
        p,
        yerr=[p - lo, hi - p],
        fmt="o-",
        capsize=4,
        color="tab:blue",
        ecolor="gray",
        lw=1,
        ms=5,
    )
    ax.set_xticks(x)
    ax.set_xticklabels(cats, rotation=0)
    ax.set_ylim(0, 1)
    ax.set_ylabel("P(Y=1)")
    ax.set_title(title + (" (ordinalni trend)" if ordinal else ""))
    ax.grid(axis="y", alpha=0.2)
    plt.tight_layout()
    plt.show()

def plot_residual_heatmap(ct: pd.DataFrame, exp: np.ndarray, title: str):
    resid = (ct.values - exp) / np.sqrt(exp)
    fig, ax = plt.subplots(figsize=(max(4.5, 0.6 * ct.shape[1]), 3.6))
    sns.heatmap(
        resid,
        annot=True,
        fmt=".2f",
        cmap="coolwarm",
        center=0,
        cbar=True,
        xticklabels=ct.columns,
        yticklabels=ct.index,
        linewidths=0.5,
        linecolor="white",
        ax=ax,
    )
    ax.set_title(title + " – std. residuali")
    ax.set_xlabel("X kategorije")
    ax.set_ylabel(f"{Y_COL} (0/1)")
    plt.tight_layout()
    plt.show()

def cramers_v_from_chi2(chi2_val: float, n: int, r: int, c: int) -> float:
    # Cramér V = sqrt((chi2 / n) / min(r-1, c-1)) (osnovna enačba za 2 x k kontingentčno tabelo)
    if n <= 0:
        return np.nan
    k = min(r - 1, c - 1)
    if k <= 0:
        return np.nan
    return float(np.sqrt((chi2_val / n) / k))

# --- 4) Glavna zanka: χ² + grafi ---
rows = []
for x_col in cat_cols:
    x = df[x_col]
    ordinal = is_ordinal_column(x, x_col)
    cats = get_order(x, x_col) if ordinal else get_order(x, x_col)

    # 2×k tabela (Y v vrsticah 0/1, X kategorije v stolpcih)
    ct = (
        pd.crosstab(df[Y_COL], pd.Categorical(x, categories=cats, ordered=ordinal))
        .reindex(index=[0, 1], columns=cats, fill_value=0)
    )

    # Pearson χ² (brez Yates; veliko n)
    chi2, p_chi, dof, exp = stats.chi2_contingency(ct.values, correction=False)

    # Programatični p iz χ² in df (survival function)
    p_calc = stats.chi2.sf(chi2, dof)

    # Cramérjev V (efektna mera)
    n_total = int(ct.values.sum())
    r, c = ct.shape
    cramer_v = cramers_v_from_chi2(chi2, n_total, r, c)

    # Izpis
    print(f"\n=== {x_col} (k={ct.shape[1]}) vs {Y_COL} ===")
    print(ct)
    print(
        f"χ²(df={dof}) = {chi2:.3f}, p (contingency) = {p_chi:.3e}, "
        f"p (sf) = {p_calc:.3e}, Cramér V = {cramer_v:.3f}"
    )

    # Grafi
    if SHOW_PROP_CI:
        plot_proportion_with_ci(
            ct, title=f"P(Y=1) po kategorijah: {x_col}", ordinal=ordinal
        )
    if SHOW_RESID_HEATMAP:
        plot_residual_heatmap(ct, exp, title=f"{x_col} vs {Y_COL}")

    # Povzetek (dodaj Cramér V v tabelo)
    rows.append(
        dict(
            feature=x_col,
            k=ct.shape[1],
            chi2=chi2,
            df=dof,
            p_contingency=p_chi,
            cramer_V=cramer_v,  # <-- dodano
        )
    )

# Pregledna tabela
res = pd.DataFrame(rows)
print("\nTop rezultati:")
display(res.head(10))








