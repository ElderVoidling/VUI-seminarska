#nova funkcija

def show_nominal_data(
    feature,
    figsize=(13, 5),
    font_scale=1,
    title_size=15,
    label_size=15,
    xtick_size=12,
    ytick_size=12,
    xtick_rotation=0,
    bar_text_size=11,
    table_title_size=15,
    table_font_size=9,
    # labele counts
    counts_label_type="center",  # "center" ali "edge"
    counts_label_pad=2,  # osnovni odmik v točkah
    counts_label_offsets=None,  # per-label odmik (točke)
    # labele relativnih deležev
    rel_label_type="center",  # "center" ali "edge"
    rel_label_pad=2,  # odmik v točkah
    rel_decimals=2,  # št. decimalk za % labele
    rel_label_offsets=None,  # NOVO: per-label odmik (točke) za % graf
):
    """
    Prikaže 2 grafa in tabele za nominalno spremenljivko (npr. binarno 0/1).
    - Stacked bar (absolutne frekvence) + labele s številom
    - Stacked bar (relativni deleži v %) + labele v %

    counts_label_offsets / rel_label_offsets:
      - skalar -> enak odmik za vse segmente,
      - dict po kategoriji -> {cat: offset},
      - dict po (skupina, kategorija) -> {(grp, cat): offset},
      - 2D array ali DataFrame oblike (n_grps, n_cats) z index=[0,1,2]
        in columns=seznam kategorij feature-a.

    Odmiki so v točkah (points) in se seštevajo k *_label_pad.
    """

    # skaliranje
    title_sz = title_size * font_scale
    label_sz = label_size * font_scale
    xtick_sz = xtick_size * font_scale
    ytick_sz = ytick_size * font_scale
    bar_txt_sz = bar_text_size * font_scale
    tbl_title_sz = table_title_size * font_scale
    tbl_font_sz = table_font_size * font_scale

    group_order = [0, 1, 2]
    xticklabels = ["0\nne diabetik", "1\nprediabetik", "2\ndiabetik"]

    with sns.plotting_context("notebook", font_scale=font_scale):
        # tabele frekvenc
        counts = (
            data.groupby("Diabetes_012")[feature]
            .value_counts()
            .unstack(fill_value=0)
            .reindex(index=group_order)
        )
        # determinističen red kategorij (stolpcev)
        counts = counts.reindex(sorted(counts.columns), axis=1)
        rel_counts = counts.div(counts.sum(axis=1), axis=0) * 100

        cat_cols = list(counts.columns)
        palette = sns.color_palette("Set2", n_colors=len(cat_cols))

        fig, axes = plt.subplots(1, 2, figsize=figsize)

        # 1) Absolutne frekvence (stacked)
        counts.plot(
            kind="bar", stacked=True, color=palette, ax=axes[0], edgecolor="k"
        )
        axes[0].set_title(
            f"Absolutne frekvence {feature}", fontsize=title_sz
        )
        axes[0].set_xlabel("Status diabetesa", fontsize=label_sz)
        axes[0].set_ylabel("Število primerov", fontsize=label_sz)
        axes[0].set_xticks(range(len(group_order)))
        axes[0].set_xticklabels(xticklabels, rotation=xtick_rotation)
        axes[0].tick_params(axis="x", labelsize=xtick_sz)
        axes[0].tick_params(axis="y", labelsize=ytick_sz)
        axes[0].legend(title=feature)

        # helper: per-label offset (counts)
        def _get_counts_offset(i_grp, j_cat):
            grp_label = counts.index[i_grp]
            cat_label = cat_cols[j_cat]
            o = counts_label_offsets
            if o is None:
                return 0.0
            if isinstance(o, (int, float, np.floating)):
                return float(o)
            if isinstance(o, dict):
                if (grp_label, cat_label) in o:
                    return float(o[(grp_label, cat_label)])
                if cat_label in o:
                    return float(o[cat_label])
                if grp_label in o:
                    return float(o[grp_label])
                return 0.0
            if isinstance(o, pd.DataFrame):
                try:
                    return float(o.loc[grp_label, cat_label])
                except Exception:
                    return 0.0
            try:
                arr = np.asarray(o, dtype=float)
                if arr.shape == (len(group_order), len(cat_cols)):
                    return float(arr[i_grp, j_cat])
            except Exception:
                pass
            return 0.0

        # Labele counts: ročno z annotate (zaradi per-label offsetov)
        for j, cont in enumerate(axes[0].containers):
            for i, patch in enumerate(cont.patches):
                h = patch.get_height()
                if h <= 0:
                    continue
                x = patch.get_x() + patch.get_width() / 2.0
                y0 = patch.get_y()
                y_top = y0 + h
                if counts_label_type == "center":
                    y_anchor = y0 + h / 2.0
                    va = "center"
                else:
                    y_anchor = y_top
                    va = "bottom"
                dy_pts = counts_label_pad + _get_counts_offset(i, j)
                if counts_label_type == "edge" and dy_pts < 0:
                    va = "top"
                axes[0].annotate(
                    f"{int(h)}",
                    xy=(x, y_anchor),
                    xytext=(0, dy_pts),
                    textcoords="offset points",
                    ha="center",
                    va=va,
                    fontsize=bar_txt_sz,
                )

        # 2) Relativni deleži (stacked, %)
        rel_counts.plot(
            kind="bar", stacked=True, color=palette, ax=axes[1], edgecolor="k"
        )
        axes[1].set_title(
            f"Relativni deleži {feature} (%)", fontsize=title_sz
        )
        axes[1].set_xlabel("Status diabetesa", fontsize=label_sz)
        axes[1].set_ylabel("Delež (%)", fontsize=label_sz)
        axes[1].set_xticks(range(len(group_order)))
        axes[1].set_xticklabels(xticklabels, rotation=xtick_rotation)
        axes[1].tick_params(axis="x", labelsize=xtick_sz)
        axes[1].tick_params(axis="y", labelsize=ytick_sz)
        axes[1].set_ylim(0, 100)
        axes[1].legend(title=feature)

        fmt = "{:." + str(rel_decimals) + "f}%"

        # helper: per-label offset (relative)
        def _get_rel_offset(i_grp, j_cat):
            grp_label = rel_counts.index[i_grp]
            cat_label = cat_cols[j_cat]
            o = rel_label_offsets
            if o is None:
                return 0.0
            if isinstance(o, (int, float, np.floating)):
                return float(o)
            if isinstance(o, dict):
                if (grp_label, cat_label) in o:
                    return float(o[(grp_label, cat_label)])
                if cat_label in o:
                    return float(o[cat_label])
                if grp_label in o:
                    return float(o[grp_label])
                return 0.0
            if isinstance(o, pd.DataFrame):
                try:
                    return float(o.loc[grp_label, cat_label])
                except Exception:
                    return 0.0
            try:
                arr = np.asarray(o, dtype=float)
                if arr.shape == (len(group_order), len(cat_cols)):
                    return float(arr[i_grp, j_cat])
            except Exception:
                pass
            return 0.0

        # Labele %: če je rel_label_offsets podan -> annotate; sicer bar_label
        if rel_label_offsets is not None:
            for j, cont in enumerate(axes[1].containers):
                for i, patch in enumerate(cont.patches):
                    h = patch.get_height()
                    if h <= 0:
                        continue
                    x = patch.get_x() + patch.get_width() / 2.0
                    y0 = patch.get_y()
                    y_top = y0 + h
                    if rel_label_type == "center":
                        y_anchor = y0 + h / 2.0
                        va = "center"
                    else:
                        y_anchor = y_top
                        va = "bottom"
                    dy_pts = rel_label_pad + _get_rel_offset(i, j)
                    if rel_label_type == "edge" and dy_pts < 0:
                        va = "top"
                    axes[1].annotate(
                        fmt.format(h),
                        xy=(x, y_anchor),
                        xytext=(0, dy_pts),
                        textcoords="offset points",
                        ha="center",
                        va=va,
                        fontsize=bar_txt_sz,
                    )
        else:
            for cont in axes[1].containers:
                labels = [
                    fmt.format(p.get_height()) if p.get_height() > 0 else ""
                    for p in cont
                ]
                axes[1].bar_label(
                    cont,
                    labels=labels,
                    label_type=rel_label_type,
                    padding=rel_label_pad,
                    fontsize=bar_txt_sz,
                )

        plt.tight_layout()
        plt.show()

    # HTML tabele
    counts_html = counts.to_html()
    rel_html = rel_counts.round(2).to_html()
    html = f"""
    <div style="display: flex; gap:40px;">
      <div style="font-size:{tbl_font_sz}pt;">
        <h4 style="font-size:{tbl_title_sz}pt; margin-bottom:8px;">
          Absolutne frekvence za {feature}
        </h4>
        {counts_html}
      </div>
      <div style="font-size:{tbl_font_sz}pt;">
        <h4 style="font-size:{tbl_title_sz}pt; margin-bottom:8px;">
          Relativni deleži za {feature} (%)
        </h4>
        {rel_html}
      </div>
    </div>
    """
    display(HTML(html))


