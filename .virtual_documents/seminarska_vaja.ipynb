import numpy as np
import matplotlib.pyplot as plt
from IPython.display import clear_output

def calculate_standard_deviation(values):
    arr = np.asarray(values, dtype=float)
    return float(np.std(arr))

# === NEW: online update helpers ===
def online_mean_replace(prev_mean: float, n: int, old_value: float, new_value: float) -> float:
    """
    O(1) update of the population mean when a single element x_old is replaced by x_new.
    """
    return prev_mean + (new_value - old_value) / float(n)

def online_std_replace(prev_std: float, prev_mean: float, n: int, old_value: float, new_value: float) -> float:
    """
    O(1) update of the population standard deviation when a single element is replaced.
    Matches np.std(..., ddof=0).
    Derivation via sums: var = S2/n - mean^2, with S2 = sum(x^2).
    """
    # reconstruct previous S1 and S2 from mean/std
    prev_var = float(prev_std) ** 2
    S1_prev = float(prev_mean) * n
    S2_prev = n * (prev_var + float(prev_mean) ** 2)

    # apply replacement
    S1_new = S1_prev - float(old_value) + float(new_value)
    S2_new = S2_prev - float(old_value) ** 2 + float(new_value) ** 2

    mean_new = S1_new / float(n)
    var_new = max(S2_new / float(n) - mean_new ** 2, 0.0)  # guard tiny negatives from fp error
    return float(np.sqrt(var_new))

def clear_plot_outputs():
    clear_output(wait=True)

def plot_BMI_in_sigma(BMI_values, USL, LSL):
    vals = np.asarray(BMI_values, dtype=float)
    mean_point = float(np.mean(vals))
    std = float(np.std(vals))

    # restrict to [LSL, USL] for the box/violin view as requested
    within_mask = (vals >= LSL) & (vals <= USL)
    within_vals = vals[within_mask] if np.any(within_mask) else vals

    # Calculate how many std deviations fit between mean and USL
    distance_to_USL = USL - mean_point
    num_stds = int(distance_to_USL / std) if std > 0 else 0
    
    # Set random seed for consistent colors
    np.random.seed(42)
    std_colors = np.random.choice(['orange', 'purple', 'brown', 'pink', 'gray', 'olive', 'cyan', 'magenta'], 
                                  size=max(num_stds, 1), replace=False)

    fig, axes = plt.subplots(1, 3, figsize=(13, 4))

    # scatter (show all points for context)
    axes[0].scatter(np.arange(len(vals)), vals, s=10, alpha=0.7)
    axes[0].axhline(USL, color='red', linestyle='--', label='USL')
    axes[0].axhline(LSL, color='red', linestyle='--', label='LSL')
    axes[0].axhline(mean_point, color='green', linestyle='-', label='mean')
    
    # Plot multiple std deviations
    x_center = len(vals) / 2
    for i in range(num_stds):
        std_start = mean_point + i * std
        std_end = mean_point + (i + 1) * std
        color = std_colors[i] if i < len(std_colors) else 'blue'
        axes[0].plot([x_center, x_center], [std_start, std_end], 
                    color=color, linewidth=2, label=f'σ{i+1}')
    
    axes[0].set_title('Scatter (all)')
    axes[0].legend(loc='best')

    # box (within [LSL, USL])
    axes[1].boxplot(within_vals, vert=True, labels=['BMI'])
    axes[1].axhline(USL, color='red', linestyle='--')
    axes[1].axhline(LSL, color='red', linestyle='--')
    
    # Plot multiple std deviations for box plot
    for i in range(num_stds):
        std_start = mean_point + i * std
        std_end = mean_point + (i + 1) * std
        color = std_colors[i] if i < len(std_colors) else 'blue'
        axes[1].plot([1, 1], [std_start, std_end], 
                    color=color, linewidth=2, label=f'σ{i+1}')
    
    axes[1].set_title('Box [LSL, USL]')
    axes[1].legend(loc='best')

    # violin (within [LSL, USL])
    axes[2].violinplot(within_vals, showmeans=True, showextrema=True)
    axes[2].axhline(USL, color='red', linestyle='--')
    axes[2].axhline(LSL, color='red', linestyle='--')
    
    # Plot multiple std deviations for violin plot
    for i in range(num_stds):
        std_start = mean_point + i * std
        std_end = mean_point + (i + 1) * std
        color = std_colors[i] if i < len(std_colors) else 'blue'
        axes[2].plot([1, 1], [std_start, std_end], 
                    color=color, linewidth=2, label=f'σ{i+1}')
    
    axes[2].set_title('Violin [LSL, USL]')
    axes[2].legend(loc='best')

    fig.tight_layout()
    plt.show()

def predict_bmi(model, xb_np, xc_np, scaler_xc, scaler_y, device):
    """
    xb_np: (n_bin,)  in {0,1} or floats
    xc_np: (n_cont,) in original units (not standardized)
    Returns a Python float in BMI units.
    """
    model.eval()
    if device is None:
        device = next(model.parameters()).device

    xb = torch.tensor(np.asarray(xb_np, dtype=np.float32), device=device).view(1, -1)
    xc = torch.tensor(np.asarray(xc_np, dtype=np.float32), device=device).view(1, -1)

    mu  = torch.tensor(scaler_xc.mean_,  device=device, dtype=torch.float32).view(1, -1)
    sig = torch.tensor(scaler_xc.scale_, device=device, dtype=torch.float32).view(1, -1)
    xc_z = (xc - mu) / sig

    with torch.no_grad():
        pred_z = model(xc_z, xb)  # NOTE: (x_cont, x_bin)
        bmi = scaler_y.inverse_transform(pred_z.detach().cpu().numpy()).ravel()[0]
    return float(bmi)



def sigma_adjust_dataset(
    target_sigma_lvl,
    USL,
    LSL,
    step_size=5,
    normalized_dampen_step=False,
    dampen_extra_multiplier=5,
    decay_rate=0.9,
    bin_data=None,
    cont_data=None,
    target_point_mode="mean",
    use_realtive_shrink=False,
    shrink_ratio=2,
    cycle_mode="itaritive", # or biggest_outlier or random_sample
    take_smaller_for_sigma=True,
    visualize_data_every_n=10,
    save_checkpoint_every_n=100,
    pre_calculated_y_preds=None,
    # needed callables/objects used inside the loop
    model=None,
    scaler_xc=None,
    scaler_y=None,
    binary_feature_names=None,
    continuous_feature_names=None,
    ordinal_feature_names=None,
    ordinal_bounds=None,
    device=None,
    get_recommended_adjustment=None,
    recomendation_verbose=False,
    verbose=True,
    print_raw_gradients=False,
    max_iterations=10000,
    visualize_checkpoint_history_at_the_end = False,
    use_only_rounded=True
):
    if bin_data is None or cont_data is None:
        raise ValueError("bin_data and cont_data must be provided.")
    if model is None:
        raise ValueError("model must be provided.")
    if get_recommended_adjustment is None:
        raise ValueError("get_recommended_adjustment callable must be provided.")

    # ensure mutable lists
    bin_data = list(bin_data)
    cont_data = list(cont_data)
    if verbose: print(f"starting y_preds")
    # initial predictions
    y_preds = None
    if pre_calculated_y_preds is None:
        y_preds = np.asarray([
            predict_bmi(model, bin_data_i, cont_data_i, scaler_xc, scaler_y, device)
            for bin_data_i, cont_data_i in zip(bin_data, cont_data)
        ], dtype=float)
    else:
        y_preds = np.asarray(pre_calculated_y_preds, dtype=float)
    if verbose: print(f"finished y_preds")

    # target point selection
    mean_point = float(np.mean(y_preds))
    if target_point_mode == "median":
        target_point = float(np.median(y_preds))
    elif target_point_mode == "middlepoint":
        # true middle point of interval
        target_point = float((USL + LSL) / 2.0)
    elif target_point_mode == "mean":
        target_point = mean_point
    else:
        # default to median if unknown mode
        target_point = float(np.median(y_preds))
    if verbose: print(f"target_point: {target_point}")
    # optional relative shrink (disabled by default to keep behavior identical to pseudo)
    if use_realtive_shrink:
        # This scales each sample towards the target by shrink_ratio; keep variable names as-is
        diffs = y_preds - target_point
        y_preds = y_preds - diffs * shrink_ratio

    # per-sample nudge magnitudes
    nudge_values = np.zeros(len(y_preds), dtype=float)
    nudge_values.fill(step_size)

    def decay_nudge_value(nudge_idx):
        #print("25412: ", nudge_values[25412])
        str=f"previous {nudge_idx} nudge_value : {nudge_values[nudge_idx]}"
        nudge_values[nudge_idx] *= float(decay_rate)
        str += f" next nudge_value: {nudge_values[nudge_idx]}"
        if(verbose): print(str)

    def get_bound_value(cur_mean):
        lsl_distance = float(cur_mean - LSL)
        usl_distance = float(USL - cur_mean)
        smaller = lsl_distance if lsl_distance < usl_distance else usl_distance
        bigger = lsl_distance if lsl_distance > usl_distance else usl_distance
        return smaller if take_smaller_for_sigma else bigger

    def is_in_sigma_lvl(std=None):
        cur_mean = float(np.mean(y_preds))
        if std is None:
            std = calculate_standard_deviation(y_preds)
        bound_distance = get_bound_value(cur_mean)
        # reach target sigma level when bound/std >= target_sigma_lvl
        return (abs(bound_distance) >= target_sigma_lvl * float(std)) if std > 0 else True

    def get_normalize_damp_val(cur_bmi, max_len, mean_point_):
        cur_bmi_len = abs(cur_bmi-mean_point_)
        return cur_bmi_len / max_len

    last_sample_idx = -1
    available_indices = list(range(len(y_preds)))
    
    def get_next_sample_idx():
        nonlocal last_sample_idx, available_indices
        if cycle_mode == "itaritive":  # keep original spelling
            last_sample_idx += 1
            if last_sample_idx >= len(y_preds):
                last_sample_idx = 0
            return last_sample_idx
        elif cycle_mode == "biggest_outlier":
            cur_mean = float(np.mean(y_preds))
            distances = np.abs(y_preds - cur_mean)
            return int(np.argmax(distances))
        elif cycle_mode == "random_sample":
            if not available_indices:
                # reset the pool when all indices have been used
                available_indices = list(range(len(y_preds)))
            # randomly select and remove an index from available indices
            random_idx = np.random.choice(available_indices)
            available_indices.remove(random_idx)
            return random_idx
        else:
            # fallback: iterative
            last_sample_idx += 1
            if last_sample_idx >= len(y_preds):
                last_sample_idx = 0
            return last_sample_idx
    if verbose: print(f"starting visualization")
    # initial visualization
    plot_BMI_in_sigma(y_preds, USL, LSL)
    clear_plot_outputs()

    sigma_history = []
    std_history = []
    last_std = calculate_standard_deviation(y_preds)
    iteration_index = 0
    checkpoint_history = []
    #checkpoint_history.append(np.array(y_preds, copy=True))
    # safety to avoid infinite loops
    it_limit = int(max_iterations) if (max_iterations is not None) else int(1e6)
    if verbose: print(f"it_limit: {it_limit}")
    while (not is_in_sigma_lvl(last_std)) and iteration_index < it_limit:
        cur_idx = get_next_sample_idx()
        cur_bin_vals = bin_data[cur_idx]
        cur_cont_vals = cont_data[cur_idx]

        if verbose: print(f"iteration_index: {iteration_index} sample_idx: {cur_idx}")

        # old value BEFORE update (from earlier computed difference)
        diff_to_target = float(target_point - y_preds[cur_idx])
        old_value = target_point - diff_to_target  # = y_preds[cur_idx] before we overwrite

        if diff_to_target == 0.0:
            # already at target, nudge small decay and skip heavy update
            decay_nudge_value(cur_idx)
            iteration_index += 1
            continue

        cur_dir = diff_to_target / abs(diff_to_target)  # -1 or +1
        cur_nudge_val = -float(nudge_values[cur_idx] * cur_dir)
        if(cur_idx==25412):
            print("a")
        if(normalized_dampen_step==True):
            max_len = abs(get_bound_value(mean_point) - mean_point)
            cur_nudge_val *= get_normalize_damp_val(y_preds[cur_idx], max_len, mean_point) * dampen_extra_multiplier
        if(verbose): print("cur_nudge_val: ", cur_nudge_val)

        # get adjusted sample
        if use_only_rounded:
            new_sample_binary_values, new_sample_continuous_values = get_recommended_adjustment(
                model=model,
                sample_binary_values=cur_bin_vals,
                sample_continuous_values=cur_cont_vals,
                nudge_alpha=cur_nudge_val,
                scaler_xc=scaler_xc,
                scaler_y=scaler_y,
                binary_feature_names=binary_feature_names,
                continuous_feature_names=continuous_feature_names,
                ordinal_feature_names=ordinal_feature_names,
                ordinal_bounds=ordinal_bounds,
                device=device,
                verbose=recomendation_verbose,
                print_raw_gradients=print_raw_gradients,
                return_only_rounded=True,
            )
            new_bin_for_pred  = new_sample_binary_values
            new_cont_for_pred = new_sample_continuous_values
        else:
            new_sample_binary_values, new_sample_continuous_values, new_xc_z, new_bin_lat = get_recommended_adjustment(
                model=model,
                sample_binary_values=cur_bin_vals,
                sample_continuous_values=cur_cont_vals,
                nudge_alpha=cur_nudge_val,
                scaler_xc=scaler_xc,
                scaler_y=scaler_y,
                binary_feature_names=binary_feature_names,
                continuous_feature_names=continuous_feature_names,
                ordinal_feature_names=ordinal_feature_names,
                ordinal_bounds=ordinal_bounds,
                device=device,
                verbose=recomendation_verbose,
                print_raw_gradients=print_raw_gradients,
                return_only_rounded=False,
            )
            # invert z back to ORIGINAL units for continuous; keep binary as latent floats [0,1]
            mu  = np.asarray(scaler_xc.mean_, dtype=float)
            sig = np.asarray(scaler_xc.scale_, dtype=float)
            new_cont_for_pred = (new_xc_z.detach().cpu().numpy()[0] * sig) + mu
            new_bin_for_pred  = new_bin_lat.detach().cpu().numpy()[0]

        # apply update and re-predict
        bin_data[cur_idx]  = new_bin_for_pred
        cont_data[cur_idx] = new_cont_for_pred
        new_pred_y = predict_bmi(
            model,
            new_bin_for_pred,
            new_cont_for_pred,
            scaler_xc,
            scaler_y,
            device
        )
        if(verbose): print(f"prev y: {y_preds[cur_idx]}, new y: {float(new_pred_y)}")
        y_preds[cur_idx] = float(new_pred_y)
        new_value = y_preds[cur_idx]

        # if we crossed the target, decay to avoid overshoot next time
        next_dir_den = float(target_point - y_preds[cur_idx])
        next_dir = (next_dir_den / abs(next_dir_den)) if next_dir_den != 0 else 0.0
        if next_dir != cur_dir:
            if(verbose): print("passed the target point!!")
            decay_nudge_value(cur_idx)

        # visualization cadence
        if visualize_data_every_n is not None and visualize_data_every_n > 0:
            if iteration_index % visualize_data_every_n == 0:
                clear_plot_outputs()
                plot_BMI_in_sigma(y_preds, USL, LSL)

        # === REPLACED: online updates instead of full recompute ===
        n = len(y_preds)
        prev_mean = float(mean_point)
        prev_std = float(last_std)

        # update mean first (needs previous mean)
        mean_point = online_mean_replace(prev_mean, n, old_value, new_value)

        # then update std using previous mean & std
        last_std = online_std_replace(prev_std, prev_mean, n, old_value, new_value)

        bound_distance = get_bound_value(mean_point)
        cur_sigma_k = (abs(bound_distance) / last_std) if last_std > 0 else np.inf
        sigma_history.append(cur_sigma_k)
        std_history.append(last_std)

        # checkpoints
        if save_checkpoint_every_n is not None and save_checkpoint_every_n > 0:
            if iteration_index % save_checkpoint_every_n == 0:
                checkpoint_history.append(np.array(y_preds, copy=True))

        if verbose:
            print(f"--/ iter={iteration_index} cur_sigma_k={cur_sigma_k:.4f} mean={mean_point:.4f} std={last_std:.4f}/--\n---\n")

        iteration_index += 1
    
    checkpoint_history.append(np.array(y_preds, copy=True))

    # final visualization of checkpoints (optional)
    if (visualize_checkpoint_history_at_the_end):
        for checkpoint in checkpoint_history:
            plot_BMI_in_sigma(checkpoint, USL, LSL)

    return {
        "bin_data": bin_data,
        "cont_data": cont_data,
        "y_preds": np.array(y_preds, copy=True),
        "sigma_history": sigma_history,
        "std_history": std_history,
        "checkpoint_history": checkpoint_history,
        "iterations": iteration_index,
        "achieved_sigma_k": (sigma_history[-1] if len(sigma_history) > 0 else 0.0),
    }



def visualize_checkpoints(result, USL, LSL, max_checkpoints_to_show=5):
    max_checkpoints_to_show_ = max_checkpoints_to_show
    """
    Show every k-th checkpoint (k = ceil(n / max_checkpoints_to_show)) and then,
    if not already shown, show the last checkpoint at the end.
    """
    checkpoints = list(result.get("checkpoint_history", []))
    n = len(checkpoints)
    if n == 0:
        return

    if max_checkpoints_to_show_ is None or max_checkpoints_to_show_ <= 0:
        idxs = list(range(n))
    else:
        step = max(1, int(np.ceil(n / float(max_checkpoints_to_show_))))
        idxs = list(range(0, n, step))

    for i in idxs:
        plot_BMI_in_sigma(np.asarray(checkpoints[i], dtype=float), USL, LSL)

    # Force the last checkpoint after the sequence if it wasn't included
    if idxs[-1] != n - 1:
        plot_BMI_in_sigma(np.asarray(checkpoints[-1], dtype=float), USL, LSL)


def visualize_sigma_std_history(result, visulize_sigma_histroy=True, visulize_std_histroy=True):
    """
    Plots:
      - sigma_history vs iteration (left)
      - std_history vs iteration (right)
    Toggle each with visulize_sigma_histroy / visulize_std_histroy.
    """
    sigma_history = np.asarray(result.get("sigma_history", []), dtype=float)
    std_history = np.asarray(result.get("std_history", []), dtype=float)

    want_sigma = bool(visulize_sigma_histroy) and sigma_history.size > 0
    want_std = bool(visulize_std_histroy) and std_history.size > 0

    if not (want_sigma or want_std):
        return

    n_plots = (1 if want_sigma else 0) + (1 if want_std else 0)
    fig, axes = plt.subplots(1, n_plots, figsize=(6 * n_plots, 4))
    if n_plots == 1:
        axes = [axes]

    ax_idx = 0
    if want_sigma:
        x_sigma = np.arange(sigma_history.size)
        axes[ax_idx].plot(x_sigma, sigma_history, color='tab:blue')
        axes[ax_idx].set_title('Sigma history (k)')
        axes[ax_idx].set_xlabel('Iteration')
        axes[ax_idx].set_ylabel('Sigma (k)')
        axes[ax_idx].grid(True, alpha=0.3)
        ax_idx += 1

    if want_std:
        x_std = np.arange(std_history.size)
        axes[ax_idx].plot(x_std, std_history, color='tab:orange')
        axes[ax_idx].set_title('Std history')
        axes[ax_idx].set_xlabel('Iteration')
        axes[ax_idx].set_ylabel('Standard Deviation')
        axes[ax_idx].grid(True, alpha=0.3)

    fig.tight_layout()
    plt.show()





