import numpy as np
import torch

def get_recommended_adjustment(
    model: torch.nn.Module,
    sample_binary_values,
    sample_continuous_values,
    nudge_alpha: float,
    scaler_xc,
    scaler_y,
    binary_feature_names,
    continuous_feature_names,
    ordinal_feature_names,
    ordinal_bounds,
    device: torch.device = None,
    verbose: bool = True,
    print_raw_gradients: bool = False,   # če True, v izpis doda stolpec "grad"
):
    """
    En 'nudge' korak po VHODIH (ne po parametrih) za znižanje napovedanega BMI.

    Vhod:
      - sample_binary_values       : (n_bin,)  ORIGINAL 0/1
      - sample_continuous_values   : (n_cont,) ORIGINAL enote (vključuje tudi ordinalne)

    Izhod:
      - new_sample_binary_values     : (n_bin,)  int {0,1}  (zaokroženo)
      - new_sample_continuous_values : (n_cont,) float; pri ordinalnih so vrednosti zaokrožene
                                        in zamejene z bounds (ostane float array, vrednosti so cele)
    """
    model.eval()
    for p in model.parameters():
        p.requires_grad_(False)

    if device is None:
        device = next(model.parameters()).device

    # --- inputs (1, n) ---
    xb_lat = torch.tensor(np.asarray(sample_binary_values, dtype=np.float32),
                          device=device).view(1, -1).clamp(0.0, 1.0).requires_grad_(True)
    xc_orig = torch.tensor(np.asarray(sample_continuous_values, dtype=np.float32),
                           device=device).view(1, -1).requires_grad_(True)

    # --- continuous -> z-skala (znotraj grafa; da chain-rule vrne grad v ORIGINALNIH enotah)
    mu  = torch.tensor(scaler_xc.mean_,  device=device, dtype=torch.float32).view(1, -1)
    sig = torch.tensor(scaler_xc.scale_, device=device, dtype=torch.float32).view(1, -1)
    xc_z = (xc_orig - mu) / sig

    # --- napoved pred korakom ---
    pred_z = model(xc_z, xb_lat)     # (1,1)
    pred_bmi_before = scaler_y.inverse_transform(pred_z.detach().cpu().numpy()).ravel()[0]
    if verbose:
        print(f"Predicted BMI (before): {pred_bmi_before:.3f}")

    # --- počisti morebitne stare gradiente (po vhodih) ---
    if xb_lat.grad is not None: xb_lat.grad = None
    if xc_orig.grad is not None: xc_orig.grad = None

    # --- backward po vhodih ---
    pred_z.backward(torch.ones_like(pred_z))
    g_bin  = xb_lat.grad.detach()   # dJ/d(xb)
    g_cont = xc_orig.grad.detach()  # dJ/d(xc) v ORIGINALNIH enotah

    # --- delta = -alpha * grad ---
    delta_bin  = - nudge_alpha * g_bin
    delta_cont = - nudge_alpha * g_cont

    # --- stare vrednosti za izpis ---
    old_bin_lat  = xb_lat.detach().cpu().numpy().copy()
    old_cont_org = xc_orig.detach().cpu().numpy().copy()

    # --- nove latent/original vrednosti ---
    new_bin_lat  = (xb_lat + delta_bin).clamp(0.0, 1.0)
    new_cont_org =  xc_orig + delta_cont

    # --- clamp ordinalov v mejah ---
    name_to_idx = {nm: i for i, nm in enumerate(continuous_feature_names)}
    with torch.no_grad():
        for nm in ordinal_feature_names:
            j = name_to_idx[nm]
            lo, hi = ordinal_bounds[nm]
            new_cont_org[0, j] = torch.clamp(new_cont_org[0, j], lo, hi)

    # --- nova napoved po koraku (za informativni izpis) ---
    new_xc_z = (new_cont_org - mu) / sig
    new_pred_z = model(new_xc_z, new_bin_lat)
    pred_bmi_after = scaler_y.inverse_transform(new_pred_z.detach().cpu().numpy()).ravel()[0]
    if verbose:
        print(f"Expected BMI after adjustment: {pred_bmi_after:.3f}")

    # --- human display: binarne zaokroži, ordinalne zaokroži + clamp ---
    human_bin = new_bin_lat.detach().round().cpu().numpy().astype(int)

    new_cont_np = new_cont_org.detach().cpu().numpy().copy()
    human_ord = {}
    for nm in ordinal_feature_names:
        j = name_to_idx[nm]
        lo, hi = ordinal_bounds[nm]
        human_ord[nm] = int(np.clip(np.round(new_cont_np[0, j]), lo, hi))

    # --- IZPIS: old, [grad], Δ, new ---
    if verbose:
        print("\nRecommended adjustment (old, " +
              ("grad, " if print_raw_gradients else "") + "Δ, new):")

        # binarne
        for i, fname in enumerate(binary_feature_names):
            oldv = float(old_bin_lat[0, i])
            grad = float(g_bin[0, i])
            dlt  = float(delta_bin[0, i])
            newv = float(new_bin_lat[0, i])
            disp = int(np.round(newv))
            if print_raw_gradients:
                print(f"{fname:>22s}  old={oldv: .3f}   grad={grad: .6f}   Δ={dlt: .6f}   new={newv: .3f} (→ {disp})")
            else:
                print(f"{fname:>22s}  old={oldv: .3f}   Δ={dlt: .6f}   new={newv: .3f} (→ {disp})")

        # continuous
        for i, fname in enumerate(continuous_feature_names):
            oldv = float(old_cont_org[0, i])
            grad = float(g_cont[0, i])
            dlt  = float(delta_cont[0, i])
            newv = float(new_cont_org[0, i])
            if fname in ordinal_feature_names:
                disp = human_ord[fname]
                if print_raw_gradients:
                    print(f"{fname:>22s}  old={oldv: .3f}   grad={grad: .6f}   Δ={dlt: .6f}   new={newv: .3f} (→ {disp})")
                else:
                    print(f"{fname:>22s}  old={oldv: .3f}   Δ={dlt: .6f}   new={newv: .3f} (→ {disp})")
            else:
                if print_raw_gradients:
                    print(f"{fname:>22s}  old={oldv: .3f}   grad={grad: .6f}   Δ={dlt: .6f}   new={newv: .3f}")
                else:
                    print(f"{fname:>22s}  old={oldv: .3f}   Δ={dlt: .6f}   new={newv: .3f}")

        print("\nNew expected state after adjustment (display):")
        print("  Binary (rounded):")
        bin_disp = {nm: int(human_bin[0, i]) for i, nm in enumerate(binary_feature_names)}
        print("   ", bin_disp)
        print("  Ordinal (rounded):")
        print("   ", {nm: human_ord[nm] for nm in ordinal_feature_names})

    # ---------- PRIPRAVI KONČNA SEZNAMA ZA RETURN ----------
    # 1) binarne: zaokrožene 0/1
    new_sample_binary_values = human_bin[0].astype(int)

    # 2) continuous: kopija novih vrednosti; ordinalne zamenjamo z zaokroženimi
    new_sample_continuous_values = new_cont_org.detach().cpu().numpy()[0].copy()
    for nm in ordinal_feature_names:
        j = name_to_idx[nm]
        new_sample_continuous_values[j] = float(human_ord[nm])  # ostane float array, vrednost je celoštevilska

    return new_sample_binary_values, new_sample_continuous_values



