def run_simulation(model, scaler, original_df, feature_columns, device, priority_order_map, num_simulations_target=5, max_steps_per_feature=10):
    """
    Izvaja simulacijo spreminjanja lastnosti diabetičnih osebkov,
    dokler jih model ne klasificira kot nediabetike.
    Funkcija obravnava točno 'num_simulations_target' dejansko diabetičnih osebkov.

    Args:
        model (nn.Module): Natreniran PyTorch model.
        scaler (StandardScaler): Uporabljen scaler za podatke.
        original_df (pd.DataFrame): DataFrame z originalnimi (nestandardiziranimi)
                                              podatki.
        feature_columns (list): Seznam imen stolpcev značilnosti.
        device (torch.device): Naprava za inferenco (cpu/cuda).
        priority_order_map (dict): Slovar, ki določa vrstni red spreminjanja stolpcev in smer "izboljšanja".
        num_simulations_target (int): Želeno število dejansko obravnavanih (diabetičnih) osebkov.
        max_steps_per_feature (int): Največje število korakov poskusov spreminjanja ene značilnosti,
                                       preden se premakne na naslednjo.
    
    Returns:
        list: Seznam slovarjev, kjer vsak slovar opisuje spremembe za enega osebka.
    """
    
    model.eval()
    simulation_results = []
    
    # Pridobimo indekse vseh diabetikov iz originalnega, nestandardiziranega DataFrame-a
    all_diabetic_indices = original_df[original_df['Diabetes_012'] == 1].index.tolist()
    
    if not all_diabetic_indices:
        print("Ni najdenih diabetičnih osebkov za simulacijo.")
        return []

    # Uporabimo omejeno število diabetikov, če jih je na voljo manj kot željeno
    if len(all_diabetic_indices) < num_simulations_target:
        print(f"Opozorilo: Na voljo je le {len(all_diabetic_indices)} diabetičnih osebkov, zahtevanih pa je {num_simulations_target}. Simuliram za vse razpoložljive.")
        simulations_to_run = all_diabetic_indices
    else:
        # Preprosto vzamemo prvih 'num_simulations_target' indeksov
        simulations_to_run = all_diabetic_indices[:num_simulations_target * 2] # Vzamemo malo več, da nadoknadimo morebitne preskoke
                                                                            # To je heuristika, boljše bi bilo iterirati

    # Nova zanka za obvladovanje števila obravnavanih osebkov
    processed_count = 0
    index_in_all_diabetics = 0

    print(f"\n--- Zagon simulacije za {num_simulations_target} dejansko obravnavanih diabetičnih osebkov ---")

    while processed_count < num_simulations_target and index_in_all_diabetics < len(all_diabetic_indices):
        original_idx = all_diabetic_indices[index_in_all_diabetics]
        index_in_all_diabetics += 1 # Premaknemo se na naslednjega kandidata

        original_person_data = original_df.loc[original_idx, feature_columns].values.reshape(1, -1)
        current_person_data_scaled = scaler.transform(original_person_data.copy())
        current_person_data_tensor = torch.tensor(current_person_data_scaled, dtype=torch.float32).to(device)

        initial_prediction_proba = model(current_person_data_tensor).item()
        # POPRAVLJENO: Uporabite int() direktno na booleanski vrednosti
        initial_prediction_class = int(initial_prediction_proba > 0.5)

        if initial_prediction_class != 1:
            print(f"  Osebek {original_idx + 2} ni bil na začetku klasificiran kot diabetik (verjetnost: {initial_prediction_proba:.4f}). Preskakujem.")
            continue # Preskoči in poskusi z naslednjim diabetikom iz seznama

        # Če smo prišli do sem, je osebek resnično diabetik in ga bomo obravnavali
        processed_count += 1
        print(f"\nSimulacija za OBRAVNAVANEGA OSEBKA (originalni indeks): {original_idx + 2} (Obravnavano: {processed_count}/{num_simulations_target})")
        print(f"  Začetna verjetnost za diabetika: {initial_prediction_proba:.4f}")
        
        person_simulation_log = {
            'original_index': original_idx + 2,
            'initial_data': original_person_data[0].tolist(),
            'final_classification': initial_prediction_class,
            'changes_made': []
        }
        
        person_data_for_simulation_scaled = current_person_data_scaled.copy()
        classification_changed = False

        for feature_name in priority_order_map:
            if feature_name not in feature_columns:
                print(f"  Opozorilo: Stolpec '{feature_name}' ni najden med značilnostmi. Preskakujem.")
                continue

            feature_idx = feature_columns.index(feature_name)
            feature_info = priority_order_map[feature_name]
            
            steps_taken_for_feature = 0
            
            current_tensor = torch.tensor(person_data_for_simulation_scaled, dtype=torch.float32).to(device)
            current_prediction_proba = model(current_tensor).item()
            # POPRAVLJENO: Uporabite int() direktno na booleanski vrednosti
            current_prediction_class = int(current_prediction_proba > 0.5)

            if current_prediction_class == 0:
                print(f"  Osebek že klasificiran kot nediabetik (verjetnost: {current_prediction_proba:.4f}) pred spremembo {feature_name}. Končujem to simulacijo.")
                classification_changed = True
                break
            
            print(f"  Poskušam spremeniti: {feature_name} (trenutna verjetnost: {current_prediction_proba:.4f})")
            
            original_feature_value_non_scaled = scaler.inverse_transform(person_data_for_simulation_scaled.copy())[0, feature_idx]

            while current_prediction_class == 1 and steps_taken_for_feature < max_steps_per_feature:
                temp_person_data_scaled = person_data_for_simulation_scaled.copy()
                temp_person_data_non_scaled = scaler.inverse_transform(temp_person_data_scaled.copy())
                
                changed = False

                if feature_info['direction'] == 'switch_to_0':
                    if temp_person_data_non_scaled[0, feature_idx] == 1:
                        temp_person_data_non_scaled[0, feature_idx] = 0
                        changed = True
                    if changed: steps_taken_for_feature += 1
                    break

                elif feature_info['direction'] == 'switch_to_1':
                    if temp_person_data_non_scaled[0, feature_idx] == 0:
                        temp_person_data_non_scaled[0, feature_idx] = 1
                        changed = True
                    if changed: steps_taken_for_feature += 1
                    break
                
                elif feature_info['direction'] == 'decrease_ordinal':
                    if temp_person_data_non_scaled[0, feature_idx] > 1:
                        temp_person_data_non_scaled[0, feature_idx] -= 1
                        changed = True
                        steps_taken_for_feature += 1
                    else:
                        break
                
                elif feature_info['direction'] == 'increase_ordinal':
                    # To morate prilagoditi glede na dejanske MAX vrednosti v vaših podatkih
                    # Predpostavljam: Education max=6, Income max=8, Age max=13 (če so 13 skupin)
                    current_val = temp_person_data_non_scaled[0, feature_idx]
                    if feature_name == 'Education':
                        if current_val < original_df['Education'].max(): # Uporabite dejansko max iz originalnega DF
                            temp_person_data_non_scaled[0, feature_idx] += 1
                            changed = True
                            steps_taken_for_feature += 1
                    elif feature_name == 'Income':
                        if current_val < original_df['Income'].max(): # Uporabite dejansko max iz originalnega DF
                            temp_person_data_non_scaled[0, feature_idx] += 1
                            changed = True
                            steps_taken_for_feature += 1
                    elif feature_name == 'Age': # Smer je bila 'decrease_ordinal' v priority_order_map
                        if current_val > original_df['Age'].min(): # Želimo zmanjšati starost
                             temp_person_data_non_scaled[0, feature_idx] -= 1 # Zmanjšanje
                             changed = True
                             steps_taken_for_feature += 1
                        else:
                            break # Že na minimalni starosti (najmlajša skupina)
                    else:
                        break # Ni bila spremenjena
                
                elif feature_info['direction'] == 'decrease':
                    step_size = feature_info.get('step_size_scaled', 0.1)
                    # Uporabimo inverse_transform na kopiji, da ne spreminjamo person_data_for_simulation_scaled
                    if scaler.inverse_transform(person_data_for_simulation_scaled.copy())[0, feature_idx] > original_df[feature_name].min():
                        temp_person_data_scaled[0, feature_idx] -= step_size
                        changed = True
                        steps_taken_for_feature += 1
                    else:
                        break
                
                elif feature_info['direction'] == 'increase':
                    step_size = feature_info.get('step_size_scaled', 0.1)
                    if scaler.inverse_transform(person_data_for_simulation_scaled.copy())[0, feature_idx] < original_df[feature_name].max():
                        temp_person_data_scaled[0, feature_idx] += step_size
                        changed = True
                        steps_taken_for_feature += 1
                    else:
                        break

                if not changed:
                    break

                if feature_info['direction'] in ['switch_to_0', 'switch_to_1', 'decrease_ordinal', 'increase_ordinal']:
                    person_data_for_simulation_scaled = scaler.transform(temp_person_data_non_scaled)
                else:
                    person_data_for_simulation_scaled = temp_person_data_scaled
                
                current_tensor = torch.tensor(person_data_for_simulation_scaled, dtype=torch.float32).to(device)
                current_prediction_proba = model(current_tensor).item()
                # POPRAVLJENO: Uporabite int() direktno na booleanski vrednosti
                current_prediction_class = int(current_prediction_proba > 0.5)
                
                current_unscaled_data = scaler.inverse_transform(person_data_for_simulation_scaled.copy())[0]

                person_simulation_log['changes_made'].append({
                    'feature': feature_name,
                    'original_value_at_step_start': original_feature_value_non_scaled,
                    'changed_value_to': current_unscaled_data[feature_idx],
                    'prediction_proba_after_change': current_prediction_proba,
                    'prediction_class_after_change': current_prediction_class,
                    'steps_taken_for_feature': steps_taken_for_feature
                })

                if current_prediction_class == 0:
                    print(f"  Osebek klasificiran kot nediabetik (verjetnost: {current_prediction_proba:.4f}) po {steps_taken_for_feature} korakih na {feature_name}.")
                    classification_changed = True
                    break

            if classification_changed:
                person_simulation_log['final_classification'] = 0
                break

        if not classification_changed:
            print(f"  Osebek {original_idx + 2} je ostal diabetik kljub vsem poskusom sprememb.")
            person_simulation_log['final_classification'] = 1

        simulation_results.append(person_simulation_log)
        
    return simulation_results

# --- 9. Zagon simulacije ---
